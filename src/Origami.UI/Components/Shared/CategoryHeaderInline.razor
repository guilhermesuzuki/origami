@inherits Basic
@implements IEntityNull<OrigamiCategory>

@if (Entity != null)
{
    <div class="category-header-lite d-inline-flex align-items-center @Class" title="@Text.Original("Category")"
        style="padding-left: 20px; background-image: url(@Entity.HeaderImage.NoCategoryHeader()); background-position:left; background-size: 14px 14px; background-repeat: no-repeat;">
        <span class="category-name ellipsis" title="@Entity.Name">@Entity.Name</span>
        @if (this.Entity.Slug.Equals(this.Entity.Name, StringComparison.InvariantCultureIgnoreCase) == false)
        {
            <span class="category-slug ms-1" title="@Text.Lower("Slug")" style="opacity: 0.8; font-size: 0.8em;">
                @Entity.Slug
            </span>
        }
    </div>
}

@code {
    [Parameter] public OrigamiCategory? Entity { get; set; }
}
