@inherits Basic
@implements IEntityNull<OrigamiContent>
@inject IFileRepository _fileRepository

@if (this.Entity is OrigamiVideo video)
{
    <div class="video-media-file @Class">
        @if (video.MediaFile.WebPath.Has() == true && _fileRepository.FileExists(video.MediaFile.WebPath) == true)
        {
            <video class="w-100 border" src="@(video.MediaFile.WebPath)" style="height:auto;" controls>
                @foreach (var subtitle in video.GetSubtitles()) 
                {
                    <track src="@subtitle.WebPath" kind="subtitles" srclang="@subtitle.Language?.ToLower()" label="@subtitle.FileName" />
                }
            </video>
            <div class="text-center x-small p-1 border mt-2">
                <span>@video.MediaFile.WebPath</span>
                @if (_fileRepository.FileExists(video.MediaFile.WebPath) == true)
                {
                    <span class="ps-1">@_fileRepository.GetFile(video.MediaFile.WebPath)?.FileSize.SizeInBytes()</span>
                }
            </div>
        }
        else
        {
            <img class="w-100 border no-video" src="@OrigamiConstants.NoVideo" style="height:auto" />
        }
    </div>
}

@code {
    [Parameter] public OrigamiContent? Entity { get; set; }
}
