@inherits Basic
@implements IEntityNull<Object>

@if (Entity != null)
{
    <div class="header-lite @Class">
        <HeaderIcon Entity="Entity" />
        @if (this.Entity is OrigamiSettings settings)
        {
            <span class="ps-1">@Text.Original("Settings")</span>
        }
        else
        {
            @if (this.Entity is ITitle title && title.Title.Has() == true)
            {
                <span class="ps-1">@title.Title</span>
            }
            else if (this.Entity is IName name && name.Name.Has() == true)
            {
                <span class="ps-1">@name.Name</span>
            }
            else if (this.Entity is IDisplayName displayname && displayname.DisplayName.Has() == true)
            {
                <span class="ps-1">@displayname.DisplayName</span>
            }
            else if (this.Entity is IFirstName firstName && this.Entity is ILastName lastName)
            {
                <span class="ps-1">@firstName.FirstName @lastName.LastName</span>
            }
            else if (this.Entity is OrigamiUser user)
            {
                <span class="ps-1">@user.DisplayName</span>
            }
            else if (this.Entity is OrigamiUserTrash trash)
            {
                @if (trash.Title.Has() == true)
                {
                    <span class="ps-1">@trash.Title</span>
                }
                @if (trash.Name.Has() == true)
                {
                    <span class="ps-1">@trash.Name</span>
                }
            }
            else
            {
                <span>@Text.Lower("No header information available")</span>
            }
        }
    </div>
}

@code {
    [Parameter] public Object? Entity { get; set; }
}
