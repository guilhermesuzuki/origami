@inherits Basic
@implements IEntityNull<IEnumerable<BaseContent>>

@if (this.Entity != null && this.Entity.Any() == true)
{
    <div class="what-to-see-next @Class">
        <div class="row">
            @foreach (var content in this.Entity.Distinct())
            {
                <div class="col-12 col-xxl-4">
                    @if (content is OrigamiPost post)
                    {
                        <PostHeaderLite Entity="post"></PostHeaderLite>
                    }
                    else if (content is OrigamiVideo video)
                    {
                        <VideoHeaderLite Entity="video"></VideoHeaderLite>
                    }
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter] public IEnumerable<BaseContent>? Entity { get; set; }
}
