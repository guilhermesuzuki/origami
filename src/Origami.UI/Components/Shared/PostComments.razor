@using System.Linq
@inherits Basic

@inject Text _text
@inject IUserFacade _userFacade
@inject IContentCommentRepository _postComment

@if (Comments.Count() > 0)
{
    <div class="post-comments">
        @if (this.CommentsFromUser.Any() == true)
        {
            <div class="post-comments-highlighted mb-3">
                <div class="p-1 fw-bold text-center border border-info bg-info text-white">@Text.Lower("Your Comments")</div>
                @foreach (var comment in CommentsFromUser)
                {
                    <CommentLite Class="mt-3 shadow-sm border p-3" Entity="comment"></CommentLite>
                }
            </div>
        }
        <div class="p-1 fw-bold text-center border mb-3 bg-secondary text-white">@Text.Lower("All Comments")</div>
        @foreach (var comment in Comments.Take(this._currentPage * this._pageSize))
        {
            <PostComment Class="mb-3 shadow-sm" Comment="comment" OnCommentUpdated="OnCommentUpdated" OnCommentDeleted="OnCommentDeleted" OnCommentReply="OnCommentReply"></PostComment>
        }
        <button class="w-100 text-center btn btn-light border @(_disableLoadMoreComments ? "cursor-not-allowed" : null)" disabled="@this._disableLoadMoreComments" @onclick="() => {this._currentPage += 1; this.OnCurrentPageChanged.InvokeAsync(this._currentPage);}">@Text.Lower("See more comments")</button>
    </div>
}

@code {
    /// <summary>
    /// Comments from the Post
    /// </summary>
    [Parameter] public List<OrigamiContentComment> Comments { get; set; } = new();

    /// <summary>
    /// Comments from the logged in user
    /// </summary>
    private IEnumerable<OrigamiContentComment> CommentsFromUser
    {
        get
        {
            if (Comments.Count == 0) return new List<OrigamiContentComment>();

            var ids = Comments.DistinctBy(x => x.ContentId).Select(x => x.ContentId);

            return this.Super.ContentComments
                .CommentsFromProfile(this._userFacade.SocialProfile, false)
                .Where(x => ids.Contains(x.ContentId));
        }
    }

    /// <summary>
    /// Current Page from the Comments List
    /// </summary>
    [Parameter] public int CurrentPage { get; set; } = 1;

    /// <summary>
    /// Current Page Size from the Comments List
    /// </summary>
    [Parameter] public int PageSize { get; set; } = 10;

    [Parameter] public EventCallback<int> OnCurrentPageChanged { get; set; }

    /// <summary>
    /// Event triggered when the comment was successfully updated
    /// </summary>
    [Parameter] public EventCallback<OrigamiContentComment> OnCommentUpdated { get; set; }

    /// <summary>
    /// Event triggered when the comment was successfully deleted
    /// </summary>
    [Parameter] public EventCallback<OrigamiContentComment> OnCommentDeleted { get; set; }

    [Parameter] public EventCallback<OrigamiContentComment> OnCommentReply { get; set; }


    private int _currentPage { get; set; }
    private int _pageSize { get; set; }

    private bool _disableLoadMoreComments
    {
        get => this._currentPage * this._pageSize >= Comments.Count();
    }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();

        this._currentPage = this.CurrentPage;
        this._pageSize = this.PageSize;
    }
}
