@inherits Basic
@implements IBlogId
@implements IShowFakes
@inject IBlogRepository _blogRepository
@inject IVideoRepository _videoRepository
@inject Text _text

@if (Videos.Count() > 0)
{
    <div class="video-list @Class position-relative">
        <div class="row">
            @for (int i = 1; i <= 5; i++)
            {
                <div class="col-12 col-xl-2"></div>
            }
            <div class="col-12 col-xl-2">
                <MudSelect T="int" @bind-Value:get="this.OrderBy" @bind-Value:set="SetOrderBy">
                    <MudSelectItem Value="1">@Text.Lower("By most recent")</MudSelectItem>
                    <MudSelectItem Value="2">@Text.Lower("By title")</MudSelectItem>
                    <MudSelectItem Value="3">@Text.Lower("By title desc.")</MudSelectItem>
                    <MudSelectItem Value="4">@Text.Lower("By oldest")</MudSelectItem>
                    <MudSelectItem Value="5">@Text.Lower("By language, title")</MudSelectItem>
                    <MudSelectItem Value="6">@Text.Lower("By language, most recent")</MudSelectItem>
                </MudSelect>
            </div>
        </div>
        <div class="row mt-3">
            @for (int i = 0; i < this.Page * this.PageSize; i++)
            {
                @if (Videos.Count() > i)
                {
                    <div class="col-12 col-xl-4 mb-3">
                        <VideoHeader Entity="Videos.ElementAt(i)"></VideoHeader>
                    </div>
                }
            }
        </div>
        <div class="text-center">
            <button class="text-center btn btn-light border" style="min-width: 250px; max-width: 100%" disabled="@_disableLoadMoreVideos" @onclick="() => { this.Page += 1; this.LoadVideos(); }">
                <div>
                    <i class="fa-solid fa-file-video fs-2"></i>
                </div>
                @_text.Lower("See more videos")
            </button>
        </div>
    </div>
}
else if (this.ShowFakes == true)
{
    <div class="video-list fakes @Class position-relative">
        <div class="row">
            @foreach (var Video in OrigamiVideo.GetFakes())
            {
                <div class="col-12 col-xl-4 mb-3">
                    <VideoHeader Class="fake" Entity="Video"></VideoHeader>
                </div>
            }
        </div>
        <div class="text-center">
            <button class="text-center btn btn-light border" style="min-width: 250px; max-width: 100%" disabled="disabled">
                <div><i class="fa-solid fa-file-lines fs-2"></i></div>
                @Text.Lower("See more videos")
            </button>
        </div>
        <div class="position-absolute zeroes bg-white bg-opacity-75"></div>
    </div>
}
@code {
    [Parameter] public int Page { get; set; } = 1;
    [Parameter] public int PageSize { get; set; } = 9;
    [Parameter] public int OrderBy { get; set; } = 1;
    [Parameter] public bool ShowFakes { get; set; } = false;

    protected IEnumerable<OrigamiVideo> Videos = [];

    private bool _disableLoadMoreVideos
    {
        get => this.Super.Contents.ReadFromCache().OfType<OrigamiVideo>()
            .Published()
            .Blog(this.BlogId)
            .Count() <= this.Page * this.PageSize;
    }

    /// <summary>
    /// Loads the Videos from the repository
    /// </summary>
    protected void LoadVideos()
    {
        var videos = this.Super.Contents.ReadFromCache().OfType<OrigamiVideo>()
            .Published()
            .Blog(this.BlogId);

        videos = this.OrderBy switch
        {
            2 => videos.OrderBy(x => x.Title),
            3 => videos.OrderByDescending(x => x.Title),
            4 => videos.OrderBy(x => x.DateCreated),
            5 => videos.OrderBy(x => x.LanguageWrittenOn).ThenBy(x => x.Title),
            6 => videos.OrderBy(x => x.LanguageWrittenOn).ThenByDescending(x => x.DateCreated),
            _ => videos.OrderByDescending(x => x.DateCreated)
        };

        this.Videos = videos.Take(Page * PageSize).ToList();
    }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        this.LoadVideos();
    }

    private void SetOrderBy(int value)
    {
        this.OrderBy = value;
        this.LoadVideos();
    }
}
