@implements IEntityNull<BaseComment>

@if (Entity != null)
{
    <TinyMCE.Blazor.Editor ClassName="tinymce tinymce-comment"
                           Value="@this.Entity.Content"
                           ValueChanged="(value) => this.Entity.Content = value"
                           Conf="@OrigamiConstants.TinyMCE.ConfigurationForComments"
                           ScriptSrc="_content/Origami.UI/lib/tinymce/tinymce.min.js"></TinyMCE.Blazor.Editor>
}

@code {
    [Parameter] public BaseComment? Entity { get; set; }
}
