@inherits Basic
@implements IEntityNull<OrigamiCategory>

@if (Entity != null)
{
    <div class="category-header text-center cursor-pointer @Class" @onclick="this.Go">
        <img src="@Entity.HeaderImage" height="45" onerror="this.onerror=null; this.src='@(OrigamiConstants.NoCategory)'" />
        <div class="mt-1 text-uppercase fw-bold ellipsis name" title="@this.Entity.Name">@this.Entity.Name</div>
        <div class="mt-1 text-center post-video-counter">
            <span class="mx-1">@Text.Lower("{0} post(s)", this.PublishedPosts)</span>
            <span class="mx-1">@Text.Lower("{0} video(s)", this.PublishedVideos)</span>
        </div>
    </div>
}

@code {
    [Parameter] public OrigamiCategory? Entity { get; set; }

    private int PublishedPosts => this.Entity != null ? this.Super.GetPosts(this.Entity).Published().Count() : 0;
    private int PublishedVideos => this.Entity != null ? this.Super.GetVideos(this.Entity).Published().Count() : 0;

    protected void Go()
    {
        if (Entity != null)
        {
            WhatHappensNext.WhenIClickHere(this, new() { Slug = Entity });
        }
    }
}
