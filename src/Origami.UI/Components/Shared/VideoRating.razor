@inherits Basic
@implements IEntityNull<OrigamiVideo>
@inject IContentRatingRepository _videoRating

@if (this.Entity != null)
{
    var rating = Math.Round(_videoRating.CalculateRating(this.Entity), 1, MidpointRounding.ToEven);
    var ratings = _videoRating.Ratings(Entity).Count();
    <ul class="d-inline-flex align-items-center @Class list-unstyled video-rating">
        @if (this.ShowLanguage)
        {
            <li class="me-1" style="width:22px;">
                <span class="language d-inline-block @Entity.Get().LanguageWrittenOn"></span>
            </li>
        }
        <li>
            <ul class="d-inline-flex align-items-center rating" data-rating="@rating">
                @for (int i = 1; i <= 5; i++)
                {
                    <li>
                        <div data-rating-level="@i" class="rating-star rating-star-@i rating-star-empty"></div>
                    </li>
                }
            </ul>
        </li>
        @if (ratings > 0)
        {
            <li class="ratings ps-1 x-small">
                <span>[ </span>
                @if (rating > 0)
                {
                    <span>@rating.ToString(".0")</span>
                    <span>, </span>
                }
                <i class="fa-solid fa-user"></i>
                <span>@_videoRating.Ratings(Entity).Count()</span>
                <span>]</span>
            </li>
        }
    </ul>
}

@code {
    [Parameter] public OrigamiVideo? Entity { get; set; }
    [Parameter] public bool ShowLanguage { get; set; } = true;
}
