@inherits Basic
@implements IEntityNull<OrigamiBlog>

@if (this.Entity != null)
{
    <div class="blog-header-lite @Class">
        @if (this.HasHeaderImage)
        {
            <div class="blog-header-image align-content-center position-relative" style="background-image: url(@Entity.HeaderImage.QueryString("size", "medium"))">
                <div class="position-absolute zeroes" style="background-color: #00000077"></div>
                <span class="blog-header-title text-white d-inline-block position-relative text-uppercase" style="z-index:5;">
                    <i class="fa-solid fa-cube pe-1"></i>
                    <span class="me-1">@Entity.Name</span>
                </span>
            </div>
        }
        else if (this.DisplayBlogNameEvenWithoutHeaderImage)
        {
            <span class="blog-header-title d-inline-block position-relative text-uppercase" style="z-index:5;">
                <i class="fa-solid fa-cube pe-1"></i>
                <span class="me-1">@Entity.Name</span>
            </span>
        }
    </div>
}

@code {
    [Parameter] public bool DisplayBlogNameEvenWithoutHeaderImage { get; set; } = true;
    [Parameter] public OrigamiBlog? Entity { get; set; }

    /// <summary>
    /// Indicates whether to show the information.
    /// </summary>
    private bool HasHeaderImage
    {
        get
        {
            if (this.Entity == null) return false;
            if (this.Entity.HeaderImage.Has() == false) return false;
            if (this.Entity.HeaderImage.Like(OrigamiConstants.NoHeader) == true) return false;
            return true;
        }
    }
}
