@inherits Basic
@implements IEntityNull<OrigamiBlog>

@if (this.Entity != null)
{
    <div class="blog-header-lite @Class">
        <div class="position-relative">
            @if (this.HasHeaderImage)
            {
                <div class="blog-header-image position-absolute zeroes" style="background-image: url(@Entity.HeaderImage.QueryString("size", "medium"))"></div>
                <div class="position-absolute zeroes" style="background-color: #00000077"></div>
            }
            <span class="blog-header-title text-white d-inline-block position-relative text-uppercase z-index-middle">
                <i class="fa-solid fa-cube pe-1"></i>
                <span class="me-1">@Entity.Name</span>
            </span>
        </div>
    </div>
}

@code {
    [Parameter] public OrigamiBlog? Entity { get; set; }

    /// <summary>
    /// Indicates whether to show the information.
    /// </summary>
    private bool HasHeaderImage
    {
        get
        {
            if (this.Entity == null) return false;
            if (this.Entity.HeaderImage.Has() == false) return false;
            if (this.Entity.HeaderImage.Like(OrigamiConstants.NoHeader) == true) return false;
            return true;
        }
    }
}
