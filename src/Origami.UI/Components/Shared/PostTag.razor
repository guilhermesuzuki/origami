@inherits Basic
@implements IHyperlink
@implements IEntityNull<OrigamiContentTag>

@if (Entity != null)
{
    <span class="post-tag m-1 @Class d-inline-block">
        <a class="p-1 text-uppercase cursor-pointer" href="@this.Hyperlink" @onclick:stopPropagation="true">
            @Entity.Tag
        </a>
    </span>
}

@code {
    [Parameter] public OrigamiContentTag? Entity { get; set; }

    public string Hyperlink
    {
        get
        {
            if (Entity != null)
            {
                var content = this.Super.Contents.ReadFromCache().Id(Entity.ContentId)!;
                var blog = this.Super.Blogs.ReadFromCache().Id(content.BlogId)!;
                return $"/blogs/{blog.Slug}/tags/{Entity.Slug}/{content.NanoId}#content-start";
            }
            return string.Empty;
        }
    }
}
