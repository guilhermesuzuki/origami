@using System.Text;
@inherits Basic

@if (Comment != null)
{
    var parent = this.Super.ContentComments.ReadFromCache().Id(Comment.ParentId);
    var user = this.Super.Users.ReadFromCache().Id(Comment.UserId);
    var replies = this.Super.GetReplies(Comment);
    var moderator = this.Super.Users.CanTheUserModerateComments(user);
    <a id="@Comment.Id"></a>
    <div class="wrapper border @Class @(this.Comment.SocialProfileId == this.UserFacade.SocialProfile.Id ? "border-dark" : null)">
        <div class="post-comment p-3 border">
            <div class="post-comment-header position-relative">
                <UserHeaderLite Entity="user"></UserHeaderLite>
                <AuthorizeView>
                    <Authorized>
                        <div class="post-comment-actions position-absolute" style="right:0;top:0;">
                            <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" Icon="@Icons.Material.Filled.Menu">
                                @if (Comment.UserId == UserFacade.User.Id)
                                {
                                    <MudMenuItem>
                                        <button class="" @onclick="() => this._editMode = true">
                                            <MudIcon Icon="@Icons.Material.Filled.Edit"></MudIcon>
                                            @Text.Lower("Edit comment")
                                        </button>
                                    </MudMenuItem>
                                }
                                @if (Comment.UserId == UserFacade.User.Id || moderator)
                                {
                                    <MudMenuItem>
                                        <button class="text-danger" @onclick="this.DeleteComment">
                                            <MudIcon Icon="@Icons.Material.Filled.Delete"></MudIcon>
                                            @Text.Lower("Delete comment")
                                        </button>
                                    </MudMenuItem>
                                }
                                @if (moderator && Comment.IsPinnedBySomeone == false)
                                {
                                    <MudMenuItem>
                                        <button class="" @onclick="this.PinComment">
                                            <MudIcon Icon="@Icons.Material.Filled.PushPin"></MudIcon>
                                            @Text.Lower("Pin comment")
                                        </button>
                                    </MudMenuItem>
                                }
                                @if (moderator && Comment.IsPinnedBySomeone == true)
                                {
                                    <MudMenuItem>
                                        <button class="" @onclick="this.UnpinComment">
                                            <MudIcon Icon="@Icons.Material.Outlined.PushPin"></MudIcon>
                                            @Text.Lower("Unpin comment")
                                        </button>
                                    </MudMenuItem>
                                }
                                <MudMenuItem>
                                    <button class="" @onclick="async () => await this.OnCommentReply.InvokeAsync(this.Comment)">
                                        <MudIcon Icon="@Icons.Material.Filled.Reply"></MudIcon>
                                        @Text.Lower("Reply comment")
                                    </button>
                                </MudMenuItem>
                            </MudMenu>
                        </div>
                    </Authorized>
                </AuthorizeView>
            </div>
            <div class="post-comment-date small text-center">
                <span class="ms-1" title="@Text.Original("Date")">
                    <i class="bi bi-calendar-fill"></i>
                    <span class="">@Comment.GetDate()</span>
                </span>
                @if (Comment.IsPinnedBySomeone)
                {
                    <span class="ms-1" title="@Text.Original("Pinned")">
                        <span>•</span>
                        <i class="fa-solid fa-thumbtack"></i>
                    </span>
                }
                @if (replies.Any() == true)
                {
                    <span class="cursor-pointer ms-1 @(_showReplies ? "fw-bold": null)" title="@Text.Original("Direct replies")" @onclick="() => this._showReplies = !this._showReplies">
                        <span>• </span>
                        @if (replies.Count() == 1)
                        {
                            <span class="">@Text.Lower("{0} reply", replies.Count())</span>
                        }
                        else
                        {
                            <span class="">@Text.Lower("{0} replies", replies.Count())</span>
                        }
                    </span>
                }
            </div>
            <CommentLite Entity="parent" Class="border p-2 mt-3"></CommentLite>
            <div class="post-comment-text mt-3">
                <AuthorizeView>
                    <Authorized>
                        @if (_editMode)
                        {
                            <TinyMCEComment Entity="CommentForUpdating"></TinyMCEComment>
                            <div class="mt-3 text-right">
                                <button class="btn btn-light border" @onclick="this.SaveChangesToComment">
                                    <i class="fa-solid fa-paper-plane"></i>
                                    @Text.Lower("Save changes")
                                </button>
                                <button class="btn btn-light border" @onclick="this.CancelChangesToComment">
                                    <i class="fa-solid fa-ban"></i>
                                    @Text.Lower("Cancel")
                                </button>
                            </div>
                        }
                        else
                        {
                            @((MarkupString)Comment.Content)
                        }
                    </Authorized>
                    <NotAuthorized>
                        @((MarkupString)Comment.Content)
                    </NotAuthorized>
                </AuthorizeView>
            </div>
            <div class="post-comment-reactions mt-3">
                <div class="reactions">
                    @foreach (var reaction in this.Super.ContentCommentReactions.Reactions(Comment).GroupBy(x => x.Reaction))
                    {
                        <MudTooltip Text="@WhoReacted(reaction.Key)">
                            <label class="post-comment-reaction @(HasReactionClass(reaction.Key, this.UserFacade.User)) me-1 @(this.UserFacade.User.New ? null : "cursor-pointer")"
                                   style="border-radius: 12px; padding-left: 3px; padding-right: 6px; padding-bottom: 3px;"
                                   @onclick="() => this.ReactionClick(reaction.Key, this.UserFacade.User)">
                                <span>@reaction.Key</span>
                                <span>@reaction.Count()</span>
                            </label>
                        </MudTooltip>
                    }
                </div>
            </div>
        </div>
        <AuthorizeView>
            <Authorized>
                <div class="p-2 bg-light border-bottom">
                    <div class="w-100 text-center cursor-pointer" @onclick="() => this._showEmojis = !_showEmojis">
                        @if (_showEmojis == false)
                        {
                            <span class="pe-1">@Text.Lower("Reactions")</span>
                            <i class="fa-solid fa-angle-down"></i>
                        }
                        else
                        {
                            <span class="pe-1">@Text.Lower("Reactions")</span>
                            <i class="fa-solid fa-angle-up"></i>
                        }
                    </div>
                    @if (_showEmojis)
                    {
                        <emoji-picker id="@_emojiPickerId" @ref="elementRef" class="mt-2 m-auto" style="height:350px;"></emoji-picker>
                    }
                </div>
            </Authorized>
        </AuthorizeView>
        @if (_showReplies)
        {
            <div class="replies-wrapper bg-light p-3">
                @foreach (var reply in replies)
                {
                    @if (reply == replies.First())
                    {
                        <CommentLite Entity="reply" Class="border p-3"></CommentLite>
                    }
                    else
                    {
                        <CommentLite Entity="reply" Class="border mt-3 p-3"></CommentLite>
                    }
                }
            </div>
        }
    </div>
}

@code {

    private Guid _emojiPickerId = Guid.NewGuid();
    private OrigamiContentComment? CommentForUpdating { get; set; }
    private DotNetObjectReference<ContentComment2>? objRef;
    private ElementReference elementRef;

    [Parameter] public OrigamiContentComment? Comment { get; set; }

    /// <summary>
    /// Event triggered when the comment was successfully updated
    /// </summary>
    [Parameter] public EventCallback<OrigamiContentComment> OnCommentUpdated { get; set; }

    /// <summary>
    /// Event triggered when the comment was successfully deleted
    /// </summary>
    [Parameter] public EventCallback<OrigamiContentComment> OnCommentDeleted { get; set; }

    /// <summary>
    /// Event triggered when the user wants to reply to the comment
    /// </summary>
    [Parameter] public EventCallback<OrigamiContentComment> OnCommentReply { get; set; }

    /// <summary>
    /// Static event triggered when there's an update in a comment, to refresh the your comments section
    /// </summary>
    private static event EventHandler<BaseComment> YourCommentsMustUpdate = (sender, e) => { };

    /// <summary>
    /// Is the comment in edit mode?
    /// </summary>
    private bool _editMode;
    private bool _showEmojis;
    private bool _showReplies;

    private void CommentHasChanged()
    {
        if (this.Comment == null) return;
        if (YourCommentsMustUpdate.GetInvocationList().Length == 0) return;
        YourCommentsMustUpdate.Invoke(this, this.Comment);
    }

    protected void CancelChangesToComment()
    {
        this._editMode = false;
    }

    protected void SaveChangesToComment()
    {
        if (this.CommentForUpdating != null)
        {
            this.Comment = this.Comment ?? new();

            var context = new DataOperationContext<OrigamiContentComment>(UserFacade.User, this.CommentForUpdating);

            this.Super.ContentComments.SmartSave(context, true)
                .OnSuccess(() => this.Comment.Version = CommentForUpdating.Version)
                .OnSuccess(() => this.Comment.Content = CommentForUpdating.Content)
                .OnSuccess(() => this.OnCommentUpdated.InvokeAsync(this.CommentForUpdating))
                .OnSuccess(() => this.CommentHasChanged());

            this._editMode = false;
        }
    }

    protected async Task DeleteComment()
    {
        if (this.Comment != null)
        {
            var yes = await DialogService.ShowMessageBoxAsync(
                Text.Upper("Delete comment"),
                Text.Lower("Would you like to delete this comment?"),
                Text.Lower("Yes"),
                Text.Lower("No")
            );

            if (yes.GetValueOrDefault() == true)
            {
                var context = new DataOperationContext<OrigamiContentComment>(UserFacade.User, this.Comment);

                this.UserFacade.Result = this.Super.ContentComments.SmartDelete(context, true)
                    .OnSuccess(() => this.OnCommentDeleted.InvokeAsync(this.Comment))
                    .OnSuccess(() => this.CommentHasChanged());
            }
        }
    }

    protected void PinComment()
    {
        if (this.Comment != null)
        {
            var context = new DataOperationContext<OrigamiContentComment>(UserFacade.User, this.Comment);
            this.Super.ContentComments.Pin(context, true)
                .OnSuccess(async () => await this.OnCommentUpdated.InvokeAsync(this.Comment))
                .OnSuccess(() => this.CommentHasChanged());
        }
    }

    protected void UnpinComment()
    {
        if (this.Comment != null)
        {
            var context = new DataOperationContext<OrigamiContentComment>(UserFacade.User, this.Comment);
            this.Super.ContentComments.Unpin(context, true)
                .OnSuccess(async () => await this.OnCommentUpdated.InvokeAsync(this.Comment))
                .OnSuccess(() => this.CommentHasChanged());
        }
    }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();

        this.CommentForUpdating = Comment?.Clone();

        //keeps an eye open for comments changing
        YourCommentsMustUpdate += (sender, comment) =>
        {
            if (this == sender) return;
            if (this.Comment == null) return;
            if (this.Comment.Id != comment.Id) return;
            this.InvokeAsync(this.StateHasChanged);
        };
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) objRef = DotNetObjectReference.Create(this);

        if (_showEmojis && elementRef.Context != null)
        {
            await JSRuntime!.InvokeVoidAsync("assignDotNetHelper", elementRef, objRef);
            await JSRuntime!.InvokeVoidAsync("emojiClick", this._emojiPickerId.ToString());
        }
    }

    protected bool HasReaction(string reaction, OrigamiUser user)
    {
        if (Comment != null)
        {
            var reactions = this.Super.ContentCommentReactions.Reactions(Comment)
                .Where(x => x.Reaction == reaction)
                .Where(x => x.UserId == user.Id)
                .Any();

            return reactions;
        }

        return false;
    }

    protected string HasReactionClass(string reaction, OrigamiUser user)
    {
        return this.HasReaction(reaction, user) ? "reaction-selected" : "border";
    }

    [JSInvokable]
    public void Reaction(string reaction)
    {
        var reactions = this.Super.ContentCommentReactions.Reactions(Comment!)
            .Where(x => x.UserId == UserFacade.User.Id)
            .Where(x => x.Reaction.Like(reaction))
            .Count();

        if (reactions == 0)
        {
            var commentReaction = new Core.Models.OrigamiContentCommentReaction
            {
                Id = Guid.NewGuid(),
                CommentId = Comment!.Id,
                UserId = UserFacade.User.Id,
                Reaction = reaction,
            };

            var context = new DataOperationContext<OrigamiContentCommentReaction>(UserFacade.User, commentReaction);

            var hub = this.Super.ContentCommentReactions.SmartSave(context, true)
                .OnSuccess(() => this.CommentHasChanged())
                .OnSuccess(this.StateHasChanged);

            if (hub.Ok == false)
            {
                this.UserFacade.Result = hub;
            }
        }
    }

    private void ReactionClick(string reaction, OrigamiUser user)
    {
        if (user.New == false)
        {
            if (HasReaction(reaction, user) == true)
            {
                var remove = this.Super.ContentCommentReactions.ReadFromCache()
                    .Where(x => x.CommentId == this.Comment!.Id)
                    .Where(x => x.UserId == user.Id)
                    .Where(x => x.Reaction == reaction)
                    .FirstOrDefault();

                if (remove != null)
                {
                    var context = new DataOperationContext<OrigamiContentCommentReaction>(UserFacade.User, remove);
                    this.Super.ContentCommentReactions.SmartPurge(context, true).OnSuccess(() => this.CommentHasChanged());
                }
            }
            else
            {
                var add = new Core.Models.OrigamiContentCommentReaction
                {
                    Id = Guid.NewGuid(),
                    CommentId = this.Comment!.Id,
                    UserId = this.UserFacade.User.Id,
                    Reaction = reaction,
                };

                var context = new DataOperationContext<OrigamiContentCommentReaction>(UserFacade.User, add);
                this.Super.ContentCommentReactions.SmartSave(context, true).OnSuccess(() => this.CommentHasChanged());
            }
        }
    }

    private string WhoReacted(string reaction)
    {
        var reactions = this.Super.ContentCommentReactions.Reactions(Comment!).Where(x => x.Reaction == reaction);

        var result = new StringBuilder(
            this.UserFacade.User.New ? Text.Lower("Click to Add this Reaction (Login First)") :
            HasReaction(reaction, this.UserFacade.User)
                ? Text.Lower("Click to Remove")
                : Text.Lower("Click to Add this Reaction"));

        foreach (var reaction__ in reactions)
        {
            var user = this.Super.Users.ReadFromCache().Id(reaction__.UserId);
            var socialProfile = this.Super.SocialProfiles.ReadFromCache().Id(reaction__.SocialProfileId);
            if (user != null) result.Append($" • {user.DisplayName}");
            if (socialProfile != null) result.Append($" • {socialProfile.GetName()} ({socialProfile.SocialNetwork})");
        }

        return result.ToString();
    }

    public void Dispose() => objRef?.Dispose();
}
