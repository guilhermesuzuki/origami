@inherits Basic
@implements IEntityNull<OrigamiSpecialPage>

@if (this.Entity != null)
{
    var header = this.Entity.HeaderImage.NoHeader();
    <div class="wrapper @Class">
        <ContentHeaderLite Entity="this.Entity"></ContentHeaderLite>
        <div class="page-header-lite position-relative shadow-sm cursor-pointer" @onclick="() => this.GoToPage()">
            <div class="page-header-image" style="height: 150px; background-image: url(@Entity.HeaderImage.NoHeader())"></div>
            <div class="page-header-title position-absolute overflow-auto zeroes">
                <div class="p-3">
                    <div class="page-rating d-inline-flex align-items-center">
                        <span class="language d-inline-block @Entity.Get().LanguageWrittenOn"></span>
                    </div>
                    <span class="title fw-bold text-uppercase focusable ellipsis" style="" title="@Entity.Title">@Entity.Title</span>
                    <div>
                        <label class="page-date pe-1">@(Entity.Title)</label>
                        <label class="page-views pe-1">
                            <i class="fa-solid fa-eye"></i>
                            @this.Super.SpecialPageViews.GetViews(Entity)
                        </label>
                    </div>
                </div>
                <ul class="inline-list position-absolute w-100 z-index-middle" style="top:0;">
                    <li class="text-left" style="width: 50px;">
                        <div class="p-2 cursor-pointer focusable" title="@Text.Lower("Page")">
                            <i class="bi bi-globe"></i>
                        </div>
                    </li>
                    <li class="text-center">
                        <Draft Entity="this.Entity"></Draft>
                    </li>
                    <li class="text-right" style="width: 50px;">
                        <div class="p-2 cursor-pointer focusable" @onclick="() => _showHeaderImage = true" @onclick:stopPropagation="true">
                            <i class="fa-solid fa-image"></i>
                        </div>
                    </li>
                </ul>
            </div>
        </div>
    </div>
    @if (_showHeaderImage)
    {
        <div class="position-fixed popup-container" @onclick:stopPropagation="true">
            <div class="border shadow-lg position-relative" style="width: 90%; height: 90%;">
                <div class="overflow-auto text-center h-100 w-100" style="padding-bottom: 70px;">
                    <img class="mw-100 mh-100 position-absolute" src="@header" style="top:50%;left:50%;transform:translate(-50%,-50%)" />
                </div>
                <ul class="inline-list position-absolute w-100 border bg-white" style="bottom:0; z-index: 50;">
                    <li></li>
                    <li class="text-right">
                        <div class="btn-group p-3">
                            <button class="btn btn-secondary" @onclick="() => this._showHeaderImage = false">
                                <i class="fa-solid fa-circle-xmark"></i>
                                @Text.Lower("Close window")
                            </button>
                        </div>
                    </li>
                </ul>
            </div>
        </div>
    }
}

@code {
    private bool _showHeaderImage = false;
    [Parameter] public OrigamiSpecialPage? Entity { get; set; }

    /// <summary>
    /// Browses to the Post Details
    /// </summary>
    protected void GoToPage()
    {
        this.NavigationManager.NavigateTo($"{this.Entity!.Hyperlink}#content-start");
    }
}
