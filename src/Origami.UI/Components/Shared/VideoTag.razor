@inherits Basic
@implements IHyperlink
@implements IEntityNull<Core.Models.OrigamiVideoTag>
@if (Entity != null)
{
    <span class="video-tag m-1 @Class d-inline-block">
        <a class="p-1 text-uppercase cursor-pointer" href="@this.Hyperlink" @onclick:stopPropagation="true">@Entity.Tag</a>
    </span>
}
@code {
    [Parameter] public Core.Models.OrigamiVideoTag? Entity { get; set; }

    public string Hyperlink
    {
        get
        {
            if (Entity != null)
            {
                var video = this.Super.Videos.ReadFromCache().Id(Entity.VideoId)!;
                var blog = this.Super.Blogs.ReadFromCache().Id(video.BlogId)!;
                return $"/blogs/{blog.Slug}/tags/{Entity.Slug}/{video.NanoId}#content-start";
            }
            return string.Empty;
        }
    }
}
