@inherits Basic
@implements IEntity<CultureInfo>

<div class="d-inline-flex align-items-center culture-info @Class">
    <span class="language @Entity.Name"></span>
    <span class="language-name ms-1">@Entity.NativeName</span>
</div>

@code {
    [Parameter] public CultureInfo Entity { get; set; } = CultureInfo.CurrentUICulture;
}
