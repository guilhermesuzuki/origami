@inherits Basic
@implements IEntityNull<OrigamiTag>

@if (Entity != null)
{
    <div class="tag-header-lite @Class">
        <div class="d-inline-flex align-items-center">
            <span>@Entity.Name</span>
            @if (this.Entity.Slug.Equals(this.Entity.Name, StringComparison.InvariantCultureIgnoreCase) == false)
            {
                <span class="tag-slug ms-1 border-bottom" title="@Text.Lower("Slug")" style="opacity: 0.8; font-size: 0.8em;">
                    @Entity.Slug
                </span>
            }
        </div>
    </div>
}

@code {
    [Parameter] public OrigamiTag? Entity { get; set; }
}
