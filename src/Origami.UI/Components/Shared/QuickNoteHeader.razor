@inherits Basic
@implements IEntityNull<OrigamiQuickNote>

@if (this.Entity != null)
{
    <div class="wrapper">
        <ContentHeaderLite Entity="this.Entity"></ContentHeaderLite>
        <div class="quick-note-header position-relative shadow-sm @Class cursor-default" style="background: @OrigamiConstants.BackgroundGradients[_background]">
            <div class="quick-note-header-title position-absolute overflow-auto zeroes d-inline-flex align-items-center justify-content-center p-3">
                <span class="note fw-bold">@Entity.Note</span>
                <ul class="inline-list position-absolute w-100 z-index-middle p-2" style="top:0;">
                    <li class="text-left" style="width:50px;">
                        <i class="bi bi-lightning-fill" title="@Text.Get("Quick note")"></i>
                    </li>
                    <li>
                        <span class="x-small">@Entity.GetDate()</span>
                    </li>
                    <li class="text-right" style="width:50px;">
                        <span class="d-inline-block language @Entity.LanguageWrittenOn"></span>
                    </li>
                </ul>
            </div>
        </div>
    </div>
}

@code {

    private int _background = Random.Shared.Next(OrigamiConstants.BackgroundGradients.Length);

    [Parameter] public OrigamiQuickNote? Entity { get; set; }
}
