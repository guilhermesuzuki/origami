@inherits Basic
@implements IEntityNull<OrigamiQuickNote>

@if (this.Entity != null)
{
    <div class="wrapper" lang="@Entity.LanguageWrittenOn">
        <AuthorHeaderLite Entity="this.Entity"></AuthorHeaderLite>
        <div class="quick-note-header position-relative shadow-sm @Class cursor-default" style="background: @Entity.Background">
            <div class="quick-note-header-title position-absolute overflow-auto zeroes d-inline-flex align-items-center justify-content-center p-3">
                <ul class="inline-list position-absolute w-100 z-index-middle p-2" style="top:0;">
                    <li class="text-left" style="width:50px;">
                        <i class="bi bi-lightning-fill" title="@Text.Get("Quick note")"></i>
                    </li>
                    <li class="x-small">@Entity.DatePublished</li>
                    <li class="d-inline-flex align-items-center justify-content-end" style="width:50px;">
                        <span class="d-inline-block language @Entity.LanguageWrittenOn"></span>
                    </li>
                </ul>
                <span class="note fw-bold fs-3">@Entity.Note</span>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public OrigamiQuickNote? Entity { get; set; }
}
