@inherits Basic
@implements IEntityNull<OrigamiQuickNote>

@if (this.Entity != null)
{
    <ContentHeaderLite Entity="this.Entity"></ContentHeaderLite>
    <div class="quick-note-header position-relative shadow-sm cursor-pointer @Class">
        <div class="quick-note-header-title position-absolute overflow-auto zeroes">
            <div class="p-3">
                <div class="d-inline-flex align-items-center">
                    <span class="d-inline-block language @Entity.LanguageWrittenOn me-1"></span>
                    <span class="note fw-bold text-uppercase focusable">@Entity.Note</span>
                </div>
            </div>
            <ul class="inline-list position-absolute w-100 z-index-middle" style="top:0;">
                <li class="text-left" style="width: 50px;"></li>
                <li class="text-center">
                    <i class="bi bi-lightning-fill"></i>
                    <span>@Text.Lower("Quick note")</span>
                </li>
                <li class="text-right" style="width: 50px;"></li>
            </ul>
        </div>
    </div>
}

@code {
    [Parameter] public OrigamiQuickNote? Entity { get; set; }
}
