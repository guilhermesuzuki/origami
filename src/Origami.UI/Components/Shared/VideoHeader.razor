@inherits Basic
@implements IEntityNull<OrigamiVideo>
@implements IHyperlink
@inject IVideoTagRepository _videoTag
@inject IVideoViewRepository _videoView
@inject IVideoRatingRepository _videoRating
@inject NavigationManager _navigationManager
@inject IVideoCommentRepository _videoComment
@inject IUserRepository _user

@if (this.Entity != null)
{
    var header = this.Entity.HeaderImage.NoHeader();
    var views = _videoView.GetViews(Entity);
    var comments = _videoComment.GetComments(Entity);
    <ContentHeaderLite Entity="this.Entity"></ContentHeaderLite>
    <div class="video-header position-relative shadow-sm cursor-pointer @Class" @onclick="() => this.GoToVideo()">
        <div class="video-header-image" style="background-image: url(@header)"></div>
        <div class="video-header-title position-absolute overflow-auto zeroes">
            <div class="p-3">
                <div class="video-rating-count small" style="margin-bottom: -5px;">
                    <i class="fa-solid fa-user pe-1"></i>@_videoRating.Ratings(this.Entity).Count()
                </div>
                <div class="video-rating d-inline-flex align-items-center">
                    <span class="d-inline-block language @Entity.Get().LanguageWrittenOn me-1"></span>
                    <ul class="d-inline-flex align-items-center rating padding-u-5" data-rating="@Math.Round(_videoRating.CalculateRating(this.Entity), 1, MidpointRounding.ToEven)">
                        <li>
                            <div data-rating-level="1"
                                 class="@(UserFacade.SocialProfile.New || HasRated() ? null : "cursor-pointer rateable") rating-star rating-star-1 rating-star-empty"
                                 @onclick="() => this.Rate(1)" @onclick:stopPropagation="true"></div>
                        </li>
                        <li>
                            <div data-rating-level="2"
                                 class="@(UserFacade.SocialProfile.New || HasRated() ? null : "cursor-pointer rateable") rating-star rating-star-2 rating-star-empty"
                                 @onclick="() => this.Rate(2)" @onclick:stopPropagation="true"></div>
                        </li>
                        <li>
                            <div data-rating-level="3"
                                 class="@(UserFacade.SocialProfile.New || HasRated() ? null : "cursor-pointer rateable") rating-star rating-star-3 rating-star-empty"
                                 @onclick="() => this.Rate(3)" @onclick:stopPropagation="true"></div>
                        </li>
                        <li>
                            <div data-rating-level="4"
                                 class="@(UserFacade.SocialProfile.New || HasRated() ? null : "cursor-pointer rateable") rating-star rating-star-4 rating-star-empty"
                                 @onclick="() => this.Rate(4)" @onclick:stopPropagation="true"></div>
                        </li>
                        <li>
                            <div data-rating-level="5"
                                 class="@(UserFacade.SocialProfile.New || HasRated() ? null : "cursor-pointer rateable") rating-star rating-star-5 rating-star-empty"
                                 @onclick="() => this.Rate(5)" @onclick:stopPropagation="true"></div>
                        </li>
                        <AuthorizeView>
                            <Authorized>
                                @if (UserFacade.SocialProfile.New)
                                {
                                    <li class="ps-1">
                                        <MudTooltip Text="@Text.Lower("You Need To Login To Rate This")">
                                            <i class="fa-solid fa-circle-info"></i>
                                        </MudTooltip>
                                    </li>
                                }
                            </Authorized>
                            <NotAuthorized>
                                <li class="ps-1">
                                    <MudTooltip Text="@Text.Lower("You Need To Login To Rate This")">
                                        <i class="fa-solid fa-circle-info"></i>
                                    </MudTooltip>
                                </li>
                            </NotAuthorized>
                        </AuthorizeView>
                    </ul>
                </div>
                <AuthorizeView>
                    <Authorized>
                        @if (HasRated() == true)
                        {
                            var rating = this.RatingFromCurrentUser();
                            <div class="x-small">
                                <label>@Text.Lower("You Rated This Video: {0} Star(s)", rating!.Rating) - </label>
                                <label class="focusable" @onclick="() => this.DeleteRate()" @onclick:stopPropagation="true">
                                    <i class="fa-solid fa-rotate-left"></i>
                                    @Text.Lower("undo")
                                </label>
                            </div>
                        }
                    </Authorized>
                </AuthorizeView>
                <span class="title fw-bold text-uppercase focusable text-center ellipsis" style="-webkit-line-clamp: 5!important;" title="@Entity.Title">@Entity.Title</span>
                <div>
                    <label class="video-date pe-1">@(Entity.GetDate())</label>
                    <label class="video-views pe-1 @(views > 0 ? null : "d-none")">
                        <i class="fa-solid fa-eye"></i>
                        @views
                    </label>
                    <label class="video-views pe-1 @(comments > 0 ? null : "d-none")">
                        <i class="fa-solid fa-comment"></i>
                        @comments
                    </label>
                </div>
                <div class="video-tags mt-2 text-center">
                    @foreach (var tag in this.Super.GetTags(Entity))
                    {
                        <VideoTag Entity="tag"></VideoTag>
                    }
                </div>
            </div>
            <ul class="inline-list position-absolute w-100 z-index-middle" style="top:0;">
                <li class="text-left" style="width: 50px;">
                    <div class="p-2 cursor-pointer focusable" title="@Text.Lower("Video")">
                        <i class="fa-solid fa-video"></i>
                    </div>
                </li>
                <li class="text-center">
                    <Draft Entity="this.Entity"></Draft>
                </li>
                <li class="text-right" style="width: 50px;">
                    <div class="p-2 cursor-pointer focusable" @onclick="() => _showHeaderImage = true" @onclick:stopPropagation="true">
                        <i class="fa-solid fa-image"></i>
                    </div>
                </li>
            </ul>
        </div>
    </div>
    @if (_showHeaderImage)
    {
        <div class="position-fixed popup-container z-index-front">
            <div class="border shadow-lg position-relative" style="width: 90%; height: 90%;">
                <div class="overflow-auto text-center h-100 w-100" style="padding-bottom: 70px;">
                    <img class="mw-100 mh-100 position-absolute" src="@header" style="top:50%;left:50%;transform:translate(-50%,-50%)" />
                </div>
                <ul class="inline-list position-absolute w-100 border bg-white" style="bottom:0;">
                    <li></li>
                    <li class="text-right">
                        <div class="btn-group p-3">
                            <button class="btn btn-secondary" @onclick="() => this._showHeaderImage = false">
                                <i class="fa-solid fa-circle-xmark"></i>
                                @Text.Lower("Close window")
                            </button>
                        </div>
                    </li>
                </ul>
            </div>
        </div>
    }
}

@code {
    private bool _showHeaderImage = false;

    [Parameter] public OrigamiTag? Tag { get; set; }
    [Parameter] public OrigamiCategory? Category { get; set; }
    [Parameter] public OrigamiVideo? Entity { get; set; }

    /// <summary>
    /// Event triggered when the user rates the video (or unrates it)
    /// </summary>
    [Parameter] public EventCallback<OrigamiVideoRating?> OnUserHasRated { get; set; }

    /// <summary>
    /// Browses to the Video Details
    /// </summary>
    protected void GoToVideo()
    {
        _navigationManager.NavigateTo($"{Hyperlink}#content-start");
    }

    public string Hyperlink
    {
        get
        {
            if (this.Entity != null)
            {
                var blog = this.Super.Blogs.ReadFromCache().Id(this.Entity.BlogId)!;
                if (this.Tag != null) return blog.GetHyperlink(this.Tag, this.Entity);
                if (this.Category != null) return blog.GetHyperlink(this.Category, this.Entity);
                return $"{Entity.Hyperlink}";
            }

            if (this.Tag != null)
            {
                var blog = this.Super.Blogs.ReadFromCache().Id(this.Tag.BlogId)!;
                return blog.GetHyperlink(this.Tag);
            }

            if (this.Category != null)
            {
                var blog = this.Super.Blogs.ReadFromCache().Id(this.Category.BlogId)!;
                return blog.GetHyperlink(this.Category);
            }

            throw new InvalidOperationException("No Entity, tag or category was provided");
        }
    }

    protected OrigamiVideoRating? RatingFromCurrentUser()
    {
        return _videoRating.Ratings(this.Entity!).FirstOrDefault(x => x.SocialProfileId == UserFacade.SocialProfile.Id);
    }

    protected bool HasRated()
    {
        return RatingFromCurrentUser() != null;
    }

    protected void Rate(byte rate)
    {
        if (HasRated() == false)
        {
            var rating = new OrigamiVideoRating
                {
                    Id = Guid.NewGuid(),
                    SocialProfileId = UserFacade.SocialProfile.Id,
                    VideoId = this.Entity!.Id,
                    Rating = rate,
                };

            var context = new DataOperationContextFrontEnd<OrigamiVideoRating>(UserFacade.SocialProfile, DateTime.UtcNow, rating);
            var hub = this._videoRating.SmartCreate(context);
            if (hub.Ok) this.OnUserHasRated.InvokeAsync(rating);
        }
    }

    protected void DeleteRate()
    {
        var rating = this.RatingFromCurrentUser();
        if (rating != null)
        {
            var context = new DataOperationContextFrontEnd<OrigamiVideoRating>(UserFacade.SocialProfile, DateTime.UtcNow, rating);
            var hub = this._videoRating.SmartPurge(context);
            if (hub.Ok) this.OnUserHasRated.InvokeAsync(rating);
        }
    }
}
