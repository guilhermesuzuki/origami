@inherits Basic
@implements IEntityNull<HubContent>

@if (this.Entity != null && this.Entity.Root != null)
{
    var header = this.Entity.Root.Get().HeaderImage.NoHeader();
    var comments = this.Entity.Comments;
    <AuthorHeaderLite Entity="this.Entity"></AuthorHeaderLite>
    <div class="content-header position-relative shadow-sm cursor-default @Class" lang="@Entity.Root.LanguageWrittenOn">
        @if (this.Entity.Root is OrigamiQuickNote quickNote)
        {
            <div class="content-header-image content-header-background" style="background: @quickNote.Background;"></div>
        }
        else
        {
            <div class="content-header-image" style="background-image: url(@header.QueryString("size", HeaderImageSize.ToString()));"></div>
        }
        <div class="content-header-title position-absolute overflow-auto zeroes">
            <ul class="inline-list position-absolute w-100 z-index-middle p-2" style="top:0;">
                <li class="text-left" style="width: 50px;">
                    <ContentIcon Entity="this.Entity.Root"></ContentIcon>
                </li>
                <li class="text-center">
                    <Draft Entity="this.Entity.Root"></Draft>
                </li>
                <li class="text-right" style="width: 50px;"></li>
            </ul>
            <div class="p-3">
                <div class="content-header-title-tinyheader small d-inline-flex align-items-center">
                    <span class="language d-inline-block @Entity.Root.Get().LanguageWrittenOn mx-1"></span>
                </div>
                <div class="dummy" style="margin-bottom: -8px;"></div>
                @if (Entity.Root.Title.Has() == true)
                {
                    <span class="title fw-bold text-uppercase focusable ellipsis" style="-webkit-line-clamp:5!important;" title="@Entity.Root.Title">@Entity.Root.Title</span>    
                }
                else
                {
                    <span class="title fw-bold text-uppercase focusable ellipsis" style="-webkit-line-clamp:5!important;" title="@Text.Original("No title")">@Text.Original("No title")</span>
                }
                <div>
                    <span class="content-date-published pe-1" title="@Text.Original("Date published")">
                        <i class="fa-solid fa-calendar-day"></i>
                        @Entity.Root.DatePublished.Humanize()
                    </span>
                    @if (Entity.Root.DateReleased.HasValue == true)
                    {
                        <span class="content-date-released pe-1" title="@Text.Original("Date released")">
                            <i class="fa-solid fa-calendar-check"></i>
                            @Entity.Root.DateReleased.Humanize()
                        </span>
                    }
                    <ContentViewCounter Entity="Entity.Root"></ContentViewCounter>
                    <span class="content-comments pe-1 @(comments.Any() ? null : "d-none")">
                        <i class="fa-solid fa-comment"></i>
                        @comments.Count()
                    </span>
                </div>
                <div class="content-tags mt-2 text-center">
                    @foreach (var tag in this.Entity.Tags.OrderBy(x => x.Tag))
                    {
                        <span class="post-tag m-1 @Class d-inline-block text-uppercase focusable">@tag.Tag</span>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public HubContent? Entity { get; set; }
    [Parameter] public ePictureSizes HeaderImageSize { get; set; } = ePictureSizes.original;
}
