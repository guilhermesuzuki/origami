@inherits Basic
@implements IEntityNull<IAuthorId>
@if (this.Entity != null)
{
    var author = this.Super.Users.ReadFromCache().Id(this.Entity.AuthorId);
    @if (author != null) 
    {
        <div class="content-header-lite text-center p-1 bg-light border">
            <ul class="inline-list">
                <li>
                    <UserHeaderInline Entity="author"></UserHeaderInline>
                </li>
            </ul>
        </div>
    }
}
@code {
    [Parameter] public IAuthorId? Entity { get; set; }
}
