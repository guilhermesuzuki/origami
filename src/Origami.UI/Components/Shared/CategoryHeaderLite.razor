@inherits Basic
@implements IEntityNull<OrigamiCategory>

@if (Entity != null)
{
    <div class="category-header-lite @Class" title="@Text.Original("Category")">
        <div class="d-inline-flex align-items-center">
            <img class="" src="@Entity.HeaderImage" style="height:15px; width:15px;" onerror="this.onerror=null; this.src='@(OrigamiConstants.NoCategory)'" />
            <div class="ms-1">
                <span class="category-name">@Entity.Name</span>
                @if (this.Entity.Slug.Equals(this.Entity.Name, StringComparison.InvariantCultureIgnoreCase) == false)
                {
                    <span class="category-slug ms-1 border-bottom" title="@Text.Lower("Slug")" style="opacity: 0.8; font-size: 0.8em;">
                        @Entity.Slug
                    </span>
                }
            </div>
        </div>
        <Id Class="d-block x-small" Entity="Entity"></Id>
    </div>
}

@code {
    [Parameter] public OrigamiCategory? Entity { get; set; }
}
