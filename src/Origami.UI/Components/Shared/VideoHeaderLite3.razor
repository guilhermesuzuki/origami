@inherits Basic
@implements IEntityNull<OrigamiVideo>

@if (this.Entity != null)
{
    <div class="video-header-lite-3 @Class">
        <i class="fa-solid fa-video" title="@Text.Original("Video")"></i>
        <span>@Entity.Title</span>
        <Id Class="d-block x-small" Entity="@Entity"></Id>
    </div>
}

@code {
    [Parameter] public OrigamiVideo? Entity { get; set; }
}
