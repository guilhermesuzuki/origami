@inherits Basic
@implements IEntityNull<OrigamiPhysicalPageView>

@if (this.Entity != null)
{
    <div class="physical-page-view-header @Class">
        @if (this.Entity.ContentId != null)
        {
            var entity = this.Super.Contents.ReadFromCache().Id(this.Entity.ContentId);
            <ContentHeaderInline Entity="entity"></ContentHeaderInline>
        }
    </div>
}

@code {
    [Parameter] public OrigamiPhysicalPageView? Entity { get; set; }
}
