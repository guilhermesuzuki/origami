@inherits Basic
@implements IEntityNull<OrigamiPhysicalPageView>

@if (this.Entity != null)
{
    <div class="physical-page-view-header @Class">
        @if (this.Entity.Content?.Type == nameof(OrigamiPage))
        {
            var page = this.Super.Contents.ReadFromCache().OfType<OrigamiPage>().Id(this.Entity.Content.Id);
            <PageHeaderLite2 Entity="page"></PageHeaderLite2>
        }
        else if (this.Entity.Content?.Type == nameof(OrigamiPost))
        {
            var post = this.Super.Contents.ReadFromCache().OfType<OrigamiPost>().Id(this.Entity.Content.Id);
            <PostHeaderLite2 Entity="post"></PostHeaderLite2>
        }
        else if (this.Entity.Content?.Type == nameof(OrigamiSpecialPage))
        {
            var page = this.Super.Contents.ReadFromCache().OfType<OrigamiSpecialPage>().Id(this.Entity.Content.Id);
            <SpecialPageHeaderLite2 Entity="page"></SpecialPageHeaderLite2>
        }
        else if (this.Entity.Content?.Type == nameof(OrigamiVideo))
        {
            var video = this.Super.Contents.ReadFromCache().OfType<OrigamiVideo>().Id(this.Entity.Content.Id);
            <VideoHeaderLite2 Entity="video"></VideoHeaderLite2>
        }
    </div>
}

@code {
    [Parameter] public OrigamiPhysicalPageView? Entity { get; set; }
}
