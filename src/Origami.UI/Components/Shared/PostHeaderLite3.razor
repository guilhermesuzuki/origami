@inherits Basic
@implements IEntityNull<OrigamiPost>

@if (this.Entity != null)
{
    <div class="post-header-lite-3 @Class">
        <i class="fa-solid fa-file-lines" title="@Text.Original("Post")"></i>
        <span>@Entity.Title</span>
        <Id Class="d-block x-small" Entity="@Entity"></Id>
    </div>
}

@code {
    [Parameter] public OrigamiPost? Entity { get; set; }
}
