@inherits Basic
@implements IEntityNull<Core.Models.OrigamiPage>
@inject NavigationManager _navigationManager
@inject IPageRepository _page
@inject IUserRepository _user

@if (this.Entity != null)
{
    var header = this.Entity.HeaderImage.NoHeader();
    var views = this.Super.PhysicalPageViews.GetViews(this.Entity);
    <ContentHeaderLite Entity="this.Entity"></ContentHeaderLite>
    <div class="page-header position-relative shadow-sm cursor-pointer @Class" @onclick="() => this.GoToPage()">
        <div class="page-header-image" style="background-image: url(@header)"></div>
        <div class="page-header-title-wrapper position-absolute overflow-auto zeroes">
            <div class="p-3">
                <a class="title fw-bold text-uppercase focusable text-center" href="@Entity.Hyperlink">
                    <PageHeaderTitle Entity="this.Entity"></PageHeaderTitle>
                </a>
                <div>
                    <span class="page-date pe-1">@(Entity.GetDate())</span>
                    <span class="page-views pe-1 @(views > 0 ? null : "d-none")">
                        <i class="fa-solid fa-eye"></i>
                        @views
                    </span>
                </div>
            </div>
            <ul class="inline-list position-absolute w-100 z-index-middle" style="top:0;">
                <li class="text-left" style="width: 50px;">
                    <div class="p-2 cursor-pointer focusable" title="@Text.Lower("Page")">
                        <i class="bi bi-globe"></i>
                    </div>
                </li>
                <li class="text-center">
                    <Draft Entity="this.Entity" Class="mx-1"></Draft>
                    @if (this.Entity.IsFrontPage)
                    {
                        <span class="text-white text-lowercase mx-1">
                            <i class="bi bi-globe"></i>
                            @Text.Lower("Front-page")
                        </span>
                    }
                </li>
                <li class="text-right" style="width: 50px;">
                    <div class="p-2 cursor-pointer focusable" @onclick="() => _showHeaderImage = true" @onclick:stopPropagation="true">
                        <i class="fa-solid fa-image"></i>
                    </div>
                </li>
            </ul>
        </div>
    </div>
    @if (this.ShowRelatedPages == true && this.RelatedPages.Any() == true)
    {
        <div class="related-pages mt-3">
            <label class="w-100 text-center p-1 bg-light border">
                <i class="fa-solid fa-earth-americas"></i>
                @Text.Lower("Related pages")
            </label>
            <div class="page-header page-header-children shadow-sm border cursor-pointer text-center @Class">
                <div class="workaround overflow-hidden">
                    <div class="row">
                        @foreach (var child in this.RelatedPages)
                        {
                            var childViews = this.Super.PhysicalPageViews.GetViews(child);
                            <div class="related-page-header-title col-12 col-xxl-4 mh-100 overflow-auto m-auto" @onclick="() => this.GoToPage(child)" @onclick:stopPropagation="true">
                                <div class="p-2">
                                    <a class="title fw-bold text-uppercase focusable text-center" href="@child.Hyperlink">
                                        <PageHeaderTitle Entity="child"></PageHeaderTitle>
                                    </a>
                                    <div>
                                        <span class="page-date pe-1">@(child.GetDate())</span>
                                        <span class="page-views pe-1 @(childViews > 0 ? null : "d-none")">
                                            <i class="fa-solid fa-eye"></i>
                                            @childViews
                                        </span>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
    @if (_showHeaderImage)
    {
        <div class="position-fixed popup-container z-index-front">
            <div class="border shadow-lg position-relative" style="width: 90%; height: 90%;">
                <div class="overflow-auto text-center h-100 w-100" style="padding-bottom: 70px;">
                    <img class="mw-100 mh-100 position-absolute" src="@header" style="top:50%;left:50%;transform:translate(-50%,-50%)" />
                </div>
                <ul class="inline-list position-absolute w-100 border bg-white" style="bottom:0;">
                    <li></li>
                    <li class="text-right">
                        <div class="btn-group p-3">
                            <button class="btn btn-secondary" @onclick="() => this._showHeaderImage = false">
                                <i class="fa-solid fa-circle-xmark"></i>
                                @Text.Lower("Close window")
                            </button>
                        </div>
                    </li>
                </ul>
            </div>
        </div>
    }
}

@code {
    private bool _showHeaderImage = false;
    public override Guid Id { get; set; } = Guid.NewGuid();

    [Parameter] public Core.Models.OrigamiPage? Entity { get; set; }
    [Parameter] public bool ShowRelatedPages { get; set; } = true;

    /// <summary>
    /// Children pages
    /// </summary>
    protected List<Core.Models.OrigamiPage> RelatedPages { get; set; } = new();

    /// <summary>
    /// Browses to the page details
    /// </summary>
    protected void GoToPage()
    {
        _navigationManager.NavigateTo($"{Entity!.Hyperlink}#content-start");
    }

    /// <summary>
    /// Browses to the page details
    /// </summary>
    protected void GoToPage(Core.Models.OrigamiPage page)
    {
        _navigationManager.NavigateTo($"{page.Hyperlink}#content-start");
    }

    /// <summary>
    /// Loads all the children pages
    /// </summary>
    protected void LoadRelatedPages()
    {
        if (this.Entity == null) return;
        this.RelatedPages = new();
        this.RelatedPages.AddRange(this.Super.Pages.ReadFromCache().Published().Where(x => x.Id == this.Entity.ParentId));
        this.RelatedPages.AddRange(this.Super.Pages.ReadFromCache().Published().Where(x => x.ParentId == this.Entity.Id));
    }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        this.LoadRelatedPages();
    }
}
