@inherits Basic
@implements IEntityNull<OrigamiContent>

@if (Entity is OrigamiPage)
{
    <i class="bi bi-globe" title="@Text.Lower("Page")"></i>
}
else if (Entity is OrigamiPost)
{
    <i class="bi bi-file-earmark-text-fill" title="@Text.Lower("Post")" style="margin-left: -2px;"></i>
}
else if (Entity is OrigamiSpecialMessage)
{
    <i class="bi bi-megaphone-fill" title="@Text.Lower("Special message")"></i>
}
else if (Entity is OrigamiSpecialPage)
{
    <i class="bi bi-file-earmark-text-fill" title="@Text.Lower("Special page")" style="margin-left: -2px;"></i>
}
else if (Entity is OrigamiVideo)
{
    <i class="bi bi-file-earmark-play-fill" title="@Text.Lower("Video")" style="margin-left: -2px;"></i>
}

@code {
    [Parameter] public OrigamiContent? Entity { get; set; }
}
