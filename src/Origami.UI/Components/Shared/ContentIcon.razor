@inherits Basic
@implements IEntityNull<OrigamiContent>

@if (Entity is OrigamiPage page)
{
    if (page.IsFrontPage)
    {
        <i class="bi bi-globe fw-bold text-success" title="@Text.Lower("Front-page")"></i>
    }
    else
    {
        <i class="bi bi-globe" title="@Text.Lower("Page")"></i>
    }
}
else if (Entity is OrigamiPost)
{
    <i class="bi bi-file-earmark-text-fill" title="@Text.Lower("Post")" style="margin-left: -2px;"></i>
}
else if (Entity is OrigamiSpecialMessage)
{
    <i class="bi bi-megaphone-fill" title="@Text.Lower("Special message")"></i>
}
else if (Entity is OrigamiSpecialPage specialPage)
{
    @if (specialPage.Subtype.Like(nameof(OrigamiSpecialPageTypes.CookiePolicy)) == true)
    {
        <i class="sub-type text-left fa-solid fa-cookie" title="@Text.Lower("Cookie policy")"></i>
    }
    else if (specialPage.Subtype.Like(nameof(OrigamiSpecialPageTypes.HowToDeleteYourData)) == true)
    {
        <i class="sub-type text-left fa-solid fa-trash-can" title="@Text.Lower("How to delete your data")"></i>
    }
    else if (specialPage.Subtype.Like(nameof(OrigamiSpecialPageTypes.Maintenance)) == true)
    {
        <i class="sub-type text-left fa-solid fa-person-digging" title="@Text.Lower("Maintenance")"></i>
    }
    else if (specialPage.Subtype.Like(nameof(OrigamiSpecialPageTypes.PrivacyPolicy)) == true)
    {
        <i class="sub-type text-left fa-solid fa-file-lines" title="@Text.Lower("Privacy policy")"></i>
    }
    else if (specialPage.Subtype.Like(nameof(OrigamiSpecialPageTypes.TermsAndConditions)) == true)
    {
        <i class="sub-type text-left fa-solid fa-file-lines" title="@Text.Lower("Terms and conditions")"></i>
    }
    else if (specialPage.Subtype.Like(nameof(OrigamiSpecialPageTypes.TermsOfService)) == true)
    {
        <i class="sub-type text-left fa-solid fa-file-lines" title="@Text.Lower("Terms of service")"></i>
    }
    else if (specialPage.Subtype.Like(nameof(OrigamiSpecialPageTypes.None)) == true)
    {
        <i class="sub-type text-left fa-solid fa-file-lines" title="@Text.Lower("None")"></i>
    }
    else
    {
        <i class="fa-solid fa-circle-question" title="@Text.Lower("?")"></i>
    }
}
else if (Entity is OrigamiVideo)
{
    <i class="bi bi-file-earmark-play-fill" title="@Text.Lower("Video")" style="margin-left: -2px;"></i>
}
else if (Entity is OrigamiQuickNote)
{
    <i class="bi bi-lightning-fill" title="@Text.Lower("Quick note")" style="margin-left: -2px;"></i>
}
else if (Entity is OrigamiSoftwareRelease)
{
    <i class="fa-solid fa-file-zipper" title="@Text.Lower("Software release")" style="margin-left: -2px;"></i>
}

@code {
    [Parameter] public OrigamiContent? Entity { get; set; }
}
