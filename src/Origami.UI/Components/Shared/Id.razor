@inherits Basic
@implements IEntityNull<IId>

@if (this.Entity != null)
{
    var isDeleted = this.Entity is IDeleted deleted && deleted.IsDeleted;
    isDeleted |= this.Entity is OrigamiCategory category && this.Super.IsParentDeleted(category) == true;
    isDeleted |= this.Entity is OrigamiPage page && this.Super.IsParentDeleted(page) == true;
    <span class="id @Class">
        <span class="col-1">
            @if (isDeleted)
            {
                <span class="is-deleted me-1 bg-danger text-white px-1">
                    <i class="bi bi-trash-fill"></i>
                    <span>@Text.Lower("Deleted")</span>
                </span>
            }
            @if (this.Entity is IDraft draft && draft.IsDraft.GetValueOrDefault() == true)
            {
                <span class="me-1 bg-info text-white px-1">
                    <i class="bi bi-exclamation-diamond-fill"></i>
                    @Text.Lower("Draft")
                </span>
            }
            @if (this.Entity is INanoId nanoId)
            {
                <span class="me-1" title="@Text.Original("Nano Id")">
                    <i class="bi bi-key-fill"></i>
                    <span>@nanoId.NanoId</span>
                </span>
            }
            else
            {
                <span class="me-1" title="@Text.Original("Id")">
                    <i class="bi bi-key-fill"></i>
                    <span>@this.Entity.Id</span>
                </span>
            }
            @if (this.Entity is IVersion version && version.Version.SequenceEqual([]) == false)
            {
                <span class="me-1" title="@Text.Original("Version")">[@version.Version.GetHexString()]</span>
            }
        </span>
        <span class="col-2">
            @if (this.Entity is IDateCreated dateCreated)
            {
                <span class="me-1" title="@Text.Original("Date")">
                    <i class="bi bi-calendar-fill"></i>
                    <span class="">@dateCreated.GetDate().Humanize()</span>
                </span>
            }
            @if (this.Entity is IPublished published && published.IsPublished && published.DatePublished.HasValue)
            {
                <span class="me-1" title="@Text.Original("Date published")">
                    <i class="bi bi-calendar-heart-fill"></i>
                    <span class="">@published.DatePublished.Humanize()</span>
                </span>
            }
        </span>
    </span>
}

@code {
    [Parameter] public IId? Entity { get; set; }
}
