@inherits Basic
@implements IEntityNull<OrigamiContent>
@implements IDisposable

@if (this.Entity != null)
{
    var views = this.Super.PhysicalPageViews.GetViews(this.Entity);
    <span class="content-views @Class pe-1 @(views > 0 ? null : "d-none")">
        <i class="fa-solid fa-eye"></i>
        @views
    </span>
}

@code {
    [Parameter] public OrigamiContent? Entity { get; set; }

    protected override void OnInitialized()
    {
        base.OnInitialized();
        this.UserFacade.RefreshingTheUI += this._onRefreshingTheUIAsync;
    }

    private async void _onRefreshingTheUIAsync(object? sender, StringEventArgs e)
    {
        if (e.Value.Like(OrigamiConstants.Events.UpdateCounters) == true)
        {
            await this.InvokeAsync(this.StateHasChanged);
        }
    }

    public override void Dispose()
    {
        this.UserFacade.RefreshingTheUI -= this._onRefreshingTheUIAsync;
        base.Dispose();
    }
}
