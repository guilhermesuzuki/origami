@inherits Basic

<div id="blazor-error-ui">
    <environment include="Staging,Production">
        <span>@Text.Original("An error has occurred")</span>
        <span>.</span>
        <span>@Text.Original("This application may no longer respond until reloaded")</span>
        <span>.</span>
    </environment>
    <environment include="Development">
        <span>@Text.Original("An unhandled exception has occurred")</span>
        <span>.</span>
        <span>@Text.Original("See browser dev tools for details")</span>
        <span>.</span>
    </environment>
    <a href="" class="reload">@Text.Original("Reload")</a>
    <a class="dismiss">🗙</a>
</div>

@code {

}
