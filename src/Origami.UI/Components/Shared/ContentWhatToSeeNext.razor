@inherits Basic
@implements IEntityNull<IEnumerable<OrigamiContent>>

@if (this.Entity != null && this.Entity.Any() == true)
{
    <div class="wrapper @Class">
        <div class="text-center fs-3">
            <i class="fa-solid fa-rectangle-list"></i>
            @Text.Lower("What to see next")
            <i class="fa-solid fa-rectangle-list"></i>
        </div>
        <div class="what-to-see-next mt-3">
            <div class="row">
                @foreach (var content in this.Entity.Distinct())
                {
                    <div class="col-12 col-xxl-4">
                        <ContentHeaderLite Entity="content"></ContentHeaderLite>
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public IEnumerable<OrigamiContent>? Entity { get; set; }
}
