@inherits Basic
@inject ISuperRepository _super

<div class="search @Class">
    <div class="search-field position-relative">
        <ul class="expand-size p-3 border shadow-sm">
            <li>
                <MudTextField T="string"
                              FullWidth="true"
                              Immediate="true"
                              HelperText="@Text.Lower("Type in here to search")"
                              @bind-Value:get="@this.UserFacade.SearchTerm"
                              @bind-Value:set="@_startQuery"></MudTextField>
            </li>
            <li class="position-relative ms-3" style="flex:none;">
                <button class="m-auto" @onclick="() => this._startQuery(string.Empty)" disabled="@(this.UserFacade.SearchTerm.Has() ? false : true)">
                    <i class="fa-solid fa-broom"></i>
                </button>
            </li>
        </ul>
    </div>
    @if (this._hits.Any() == true)
    {
        <div class="search-results mt-3 border shadow-lg p-3">
            @if (this._posts.Any() == true)
            {
                <div class="search-posts">
                    <label class="fs-3 w-100 text-center">@Text.Lower("Posts found in the search")</label>
                    <div class="row mt-3">
                        @foreach (var post in _posts)
                        {
                            <div class="col-12 col-xl-4">
                                <ContentHeader Class="mb-3" Entity="post"></ContentHeader>
                            </div>
                        }
                    </div>
                </div>
            }
            @if (this._videos.Any() == true)
            {
                <div class="search-videos">
                    <label class="fs-3 w-100 text-center">@Text.Lower("Videos found in the search")</label>
                    <div class="row mt-3">
                        @foreach (var video in _videos)
                        {
                            <div class="col-12 col-xl-4">
                                <ContentHeader Class="mb-3" Entity="video"></ContentHeader>
                            </div>
                        }
                    </div>
                </div>
            }
            @if (this._pages.Any() == true)
            {
                <div class="search-pages">
                    <label class="fs-3 w-100 text-center mt-6">@Text.Lower("Pages found in the search")</label>
                    <div class="row mt-3">
                        @foreach (var page in _pages)
                        {
                            <div class="col-12 col-xl-4">
                                <ContentHeader Class="mb-3" Entity="page" ShowRelatedContent="false"></ContentHeader>
                            </div>
                        }
                    </div>
                </div>
            }
            @if (this._specialMessages.Any() == true)
            {
                <div class="search-specialmessages">
                    <label class="fs-3 w-100 text-center mt-6">@Text.Lower("Special messages found in the search")</label>
                    <div class="row mt-3">
                        @foreach (var page in _specialMessages)
                        {
                            <div class="col-12 col-xl-4">
                                <ContentHeader Class="mb-3" Entity="page" ShowRelatedContent="false"></ContentHeader>
                            </div>
                        }
                    </div>
                </div>
            }
            @if (this._specialPages.Any() == true)
            {
                <div class="search-specialpages">
                    <label class="fs-3 w-100 text-center mt-6">@Text.Lower("Special pages found in the search")</label>
                    <div class="row mt-3">
                        @foreach (var page in _specialPages)
                        {
                            <div class="col-12 col-xl-4">
                                <ContentHeader Class="mb-3" Entity="page" ShowRelatedContent="false"></ContentHeader>
                            </div>
                        }
                    </div>
                </div>
            }
            @if (this._categories.Any() == true)
            {
                <div class="search-categories mt-6">
                    <label class="fs-3 w-100 text-center">@Text.Lower("Categories found in the search")</label>
                    <div class="row mt-3">
                        @foreach (var category in _categories)
                        {
                            <div class="col-12 col-xl-2">
                                <CategoryHeader Class="mb-3 p-3 border shadow-sm" Entity="category"></CategoryHeader>
                            </div>
                        }
                    </div>
                </div>
            }
            @if (this._contentComments.Any() == true)
            {
                <div class="search-content-comments">
                    <label class="fs-3 w-100 text-center">@Text.Lower("Comments found In the search")</label>
                    <div class="row mt-3">
                        @if (AppFacade.Admin.GetValueOrDefault() == true)
                        {
                            @foreach (var comment in _contentComments)
                            {
                                <div class="col-12 col-xl-6">
                                    <ContentCommentAdmin Class="mb-3" Entity="comment"></ContentCommentAdmin>
                                </div>
                            }
                        }
                        else
                        {
                            @foreach (var comment in _contentComments)
                            {
                                <div class="col-12 col-xl-6">
                                    <ContentComment Class="mb-3" Entity="comment"></ContentComment>
                                </div>
                            }
                        }
                    </div>
                </div>
            }
            @if (this._tags.Any() == true)
            {
                <div class="search-tags mt-6">
                    <label class="fs-3 w-100 text-center">@Text.Lower("Tags found in the search")</label>
                    <div class="row mt-3">
                        @foreach (var tag in _tags)
                        {
                            <div class="col-12 col-xl-2">
                                <ContentTagHeader Class="mb-3 p-2 text-center border shadow-sm" Entity="@tag"></ContentTagHeader>
                            </div>
                        }
                    </div>
                </div>
            }
            @if (this._socialProfiles.Any() == true)
            {
                <div class="search-social-profiles mt-6">
                    <label class="fs-3 w-100 text-center">@Text.Lower("Social profiles found in the search")</label>
                    <div class="row mt-3">
                        @foreach (var socialProfile in _socialProfiles)
                        {
                            <div class="col-12 col-xl-4">
                                <SocialProfileCard Class="mb-3 p-3 border shadow-sm" Entity="socialProfile"></SocialProfileCard>
                            </div>
                        }
                    </div>
                </div>
            }
            @if (this._blogs.Any() == true)
            {
                <div class="search-blogs">
                    <label class="fs-3 w-100 text-center">@Text.Lower("Blogs found in the search")</label>
                    <div class="row mt-3">
                        @foreach (var blog in _blogs)
                        {
                            <div class="col-12 col-xl-4">
                                <BlogHeader Class="mb-3 p-3 border shadow-sm" Entity="blog"></BlogHeader>
                            </div>
                        }
                    </div>
                </div>
            }
            @if (this._quickNotes.Any() == true)
            {
                <div class="search-quicknotes">
                    <label class="fs-3 w-100 text-center">@Text.Lower("Quick notes found in the search")</label>
                    <div class="row mt-3">
                        @foreach (var quickNote in _quickNotes)
                        {
                            <div class="col-12 col-xl-4 text-center">
                                <ContentHeader Class="mb-3 p-3 border shadow-sm" Entity="quickNote"></ContentHeader>
                            </div>
                        }
                    </div>
                </div>
            }
            @if (this._users.Any() == true)
            {
                <div class="search-users">
                    <label class="fs-3 w-100 text-center">@Text.Lower("Users found in the search")</label>
                    <div class="row mt-3">
                        @foreach (var user in _users)
                        {
                            <div class="col-12 col-xl-4 text-center">
                                <UserHeaderCard Class="mb-3 p-3 border shadow-sm" Entity="user"></UserHeaderCard>
                            </div>
                        }
                    </div>
                </div>
            }
            @if (this._roles.Any() == true)
            {
                <div class="search-roles">
                    <label class="fs-3 w-100 text-center">@Text.Lower("Roles found in the search")</label>
                    <div class="row mt-3">
                        @foreach (var role in _roles)
                        {
                            <div class="col-12 col-xl-4 text-center">
                                <RoleHeaderCard Class="mb-3 p-3 border shadow-sm" Entity="role"></RoleHeaderCard>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }
    else if (this.UserFacade.SearchTerm.Has() == true)
    {
        <NothingToSeeHere Class="mt-3 shadow-lg p-3 border"></NothingToSeeHere>
    }
</div>

@code {
    /// <summary>
    /// List of blogs found in the search
    /// </summary>
    private IEnumerable<OrigamiBlog> _blogs => _hits.OfType<OrigamiBlog>().OrderBy(x => x.Name);

    /// <summary>
    /// List of categories found in the search
    /// </summary>
    private IEnumerable<OrigamiCategory> _categories => _hits.OfType<OrigamiCategory>().OrderBy(x => x.Name);

    /// <summary>
    /// List of pages found in the search
    /// </summary>
    private IEnumerable<OrigamiPage> _pages => _hits.OfType<OrigamiPage>().OrderBy(x => x.Title);

    /// <summary>
    /// List of posts found in the search
    /// </summary>
    private IEnumerable<OrigamiPost> _posts => _hits.OfType<OrigamiPost>().OrderBy(x => x.Title);

    /// <summary>
    /// List of social profiles found in the search
    /// </summary>
    private IEnumerable<OrigamiSocialProfile> _socialProfiles => _hits.OfType<OrigamiSocialProfile>().OrderBy(x => x.SocialNetwork).ThenBy(x => x.GetName());

    /// <summary>
    /// List of videos found in the search
    /// </summary>
    private IEnumerable<OrigamiVideo> _videos => _hits.OfType<OrigamiVideo>().OrderBy(x => x.Title);

    /// <summary>
    /// List of special pages found in the search
    /// </summary>
    private IEnumerable<OrigamiSpecialPage> _specialPages => _hits.OfType<OrigamiSpecialPage>().OrderBy(x => x.Title);

    /// <summary>
    /// List of special messages found in the search
    /// </summary>
    private IEnumerable<OrigamiSpecialMessage> _specialMessages => _hits.OfType<OrigamiSpecialMessage>().OrderBy(x => x.Title);

    /// <summary>
    /// List of post comments found in the search
    /// </summary>
    private IEnumerable<OrigamiContentComment> _contentComments => _hits.OfType<OrigamiContentComment>().OrderByDescending(x => x.DateCreated);

    /// <summary>
    /// List of tags found in the search
    /// </summary>
    private IEnumerable<OrigamiContentTag> _tags => _hits.OfType<OrigamiContentTag>().OrderBy(x => x.Tag);

    /// <summary>
    /// List of quick notes found in the search
    /// </summary>
    private IEnumerable<OrigamiQuickNote> _quickNotes => _hits.OfType<OrigamiQuickNote>().OrderBy(x => x.Title);

    /// <summary>
    /// List of users found in the search
    /// </summary>
    private IEnumerable<OrigamiUser> _users => _hits.OfType<OrigamiUser>().OrderBy(x => x.DisplayName);

    /// <summary>
    /// List of users found in the search
    /// </summary>
    private IEnumerable<OrigamiRole> _roles => _hits.OfType<OrigamiRole>().OrderBy(x => x.Name);

    /// <summary>
    /// List of all hits found in the search, used to check if there are any results or not
    /// </summary>
    private List<IId> _hits = [];

    /// <summary>
    /// Search timer
    /// </summary>
    private System.Timers.Timer? _searchTimer;

    private void _clearHits()
    {
        this._hits.Clear();
    }

    /// <summary>
    /// User has typed-in and will start the timer
    /// </summary>
    /// <param name="queryTerm"></param>
    private void _startQuery(string queryTerm)
    {
        this.UserFacade.SearchTerm = queryTerm;
        this._clearHits();

        if (_searchTimer != null)
        {
            _searchTimer.Stop();
            _searchTimer = null;
        }

        _searchTimer = new();
        _searchTimer.Enabled = true;
        _searchTimer.AutoReset = false;
        _searchTimer.Interval = 750;
        _searchTimer.Elapsed += (o, e) =>
        {
            this._queryLucene(queryTerm);
        };

        _searchTimer.Start();
    }

    /// <summary>
    /// Searches for the <paramref name="queryTerm"/>
    /// </summary>
    /// <param name="queryTerm"></param>
    /// <returns></returns>
    private void _queryLucene(string queryTerm)
    {
        queryTerm = queryTerm.Trim();

        this._clearHits();

        if (queryTerm.Length >= 2)
        {
            if (AppFacade.Admin.GetValueOrDefault() == true)
            {
                this.AdminSearch(queryTerm);
            }
            else
            {
                this.FESearch(queryTerm);
            }
        }

        this.InvokeAsync(this.StateHasChanged);
    }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();

        if (UserFacade.SearchTerm.Has() == true)
        {
            this._clearHits();
            this._queryLucene(this.UserFacade.SearchTerm);
        }
    }

    protected virtual void AdminSearch(string queryTerm)
    {
        var allowedBlogs = from a in this.Super.UserBlogs.ReadFromCache()
                           join b in this.Super.Blogs.ReadFromCache() on a.BlogId equals b.Id
                           where b.IsDeleted == false
                           where a.UserId == this.UserFacade.User.Id
                           select a.BlogId;

        var tasks = new List<Task>
            {
                Task.Run(() => this._hits.AddRange(Super.Blogs.Search(queryTerm).NonDeleted())),
                Task.Run(() => this._hits.AddRange(Super.Categories.Search(queryTerm).NonDeleted().Where(x => this.Super.IsParentDeleted(x) == false))),
                Task.Run(() => this._hits.AddRange(Super.ContentComments.Search(queryTerm).NonDeleted().Where(x => this.Super.IsParentDeleted(x) == false))),
                Task.Run(() => this._hits.AddRange(Super.ContentTags.Search(queryTerm).DistinctBy(x => x.Tag))),
                Task.Run(() => this._hits.AddRange(Super.Roles.Search(queryTerm))),
                Task.Run(() => this._hits.AddRange(Super.SocialProfiles.Search(queryTerm))),
                Task.Run(() => this._hits.AddRange(Super.Users.Search(queryTerm))),
                Task.Run(() =>
                {
                    var contents = Super.Contents.Search(queryTerm).NonDeleted();
                    this._hits.AddRange(contents.Where(x => this.Super.IsParentDeleted(x) == false));
                }),
            };

        Task.WhenAll(tasks).Wait();

        this._hits.RemoveAll(id => this.FilterHits(allowedBlogs, id));
    }

    protected virtual void FESearch(string queryTerm)
    {
        var allowedBlogs = from a in this.Super.Blogs.ReadFromCache().GetFrontEnd() select a.Id;

        var tasks = new List<Task>
            {
                Task.Run(() => this._hits.AddRange(Super.Blogs.Search(queryTerm).NonDeleted().Active())),
                Task.Run(() => this._hits.AddRange(Super.Categories.Search(queryTerm).NonDeleted().Where(x => this.Super.IsParentDeleted(x) == false))),
                Task.Run(() => this._hits.AddRange(Super.ContentComments.Search(queryTerm).NonDeleted().Where(x => this.Super.IsParentDeleted(x) == false))),
                Task.Run(() => this._hits.AddRange(Super.ContentTags.Search(queryTerm).DistinctBy(x => x.Tag))),
                Task.Run(() => this._hits.AddRange(Super.SocialProfiles.Search(queryTerm))),
                Task.Run(() =>
                {
                    var contents = Super.Contents.Search(queryTerm).Published();
                    this._hits.AddRange(contents.Where(x => this.Super.IsParentDeleted(x) == false));
                }),
            };

        Task.WhenAll(tasks).Wait();

        this._hits.RemoveAll(id => this.FilterHits(allowedBlogs, id));
    }

    protected bool FilterHits(IEnumerable<Guid> allowedBlogs, IId id)
    {
        if (id is OrigamiSpecialPage) return false;

        if (id is OrigamiBlog blog) return allowedBlogs.Contains(blog.Id) == false;
        if (id is OrigamiCategory category) return allowedBlogs.Contains(category.BlogId.GetValueOrDefault()) == false;
        if (id is OrigamiContentComment comment)
        {
            var content = this.Super.Contents.ReadFromCache().Id(comment.ContentId);
            return allowedBlogs.Contains(content?.BlogId ?? Guid.Empty) == false;
        }
        if (id is OrigamiContentTag tag)
        {
            var content = this.Super.Contents.ReadFromCache().Id(tag.ContentId);
            return allowedBlogs.Contains(content?.BlogId ?? Guid.Empty) == false;
        }

        if (id is OrigamiPage page) return allowedBlogs.Contains(page.BlogId.GetValueOrDefault()) == false;
        if (id is OrigamiPost post) return allowedBlogs.Contains(post.BlogId.GetValueOrDefault()) == false;
        if (id is OrigamiSpecialMessage specialMessage) return allowedBlogs.Contains(specialMessage.BlogId.GetValueOrDefault()) == false;
        if (id is OrigamiVideo video) return allowedBlogs.Contains(video.BlogId.GetValueOrDefault()) == false;

        if (id is IBlogId blogId) return allowedBlogs.Contains(blogId.BlogId) == false;
        if (id is IBlogIdNull blogIdNull) return allowedBlogs.Contains(blogIdNull.BlogId.GetValueOrDefault()) == false;

        return false;
    }
}
