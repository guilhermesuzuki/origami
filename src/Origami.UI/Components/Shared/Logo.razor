@using System;
@using System.Threading;
@using System.Globalization;
@using Microsoft.AspNetCore.Localization;

@inherits Basic
@implements IBlogId
@inject ISettingsRepository _settingsRepository

@{
    var settings = this.Super.Settings.GetSettings(); 
}

<div class="m-auto wrapper text-center">
    <div class="@Class logo cursor-pointer position-relative" style="z-index:25;" @onclick="GoHome">
        <Languages Class="mb-3"></Languages>
        @if (this._settings.LogoUrl.Has() == true)
        {
            <div class="text-center">
                <img class="logo-image" src="@_settings.LogoUrl" title="@_settings.LogoUrl" />
            </div>
        }
        <div class="text-center site-name-container" style="margin-top: -40px;">
            <span class="fw-bold site-name" style="font-size: 4.5rem;">@_settings.Name</span>
        </div>
    </div>
    @if (this.SubtitleTemplate != null)
    {
        <div class="text-center site-subtitle-container position-relative" style="z-index:25;">
            @this.SubtitleTemplate
        </div>
    }
    @if (this.AppFacade.Admin == false)
    {
        <div class="btn-group">
            @if (this.Super.GetSoftwareReleases(this.UserFacade.BlogId).Any() == true)
            {
                <div class="btn bg-success">
                    <a href="/softwarereleases#content-start" class="cursor-pointer focusable text-white">
                        <i class="fa-solid fa-file-zipper"></i>
                        @Text.Lower("Download")
                        <i class="fa-solid fa-download"></i>
                    </a>
                </div>
            }
            @if (settings.RepositoryURL.Has() == true)
            {
                <div class="btn bg-warning">
                    <a href="@settings.RepositoryURL" class="cursor-pointer focusable text-white">
                        <i class="fa-solid fa-code"></i>
                        @Text.Lower("Go to repository")
                        <i class="fa-solid fa-up-right-from-square"></i>
                    </a>
                </div>
            }
        </div>
    }
</div>

@code {
    private OrigamiSettings _settings = new();

    [Parameter] public RenderFragment? SubtitleTemplate { get; set; }

    private void GoHome()
    {
        var home = "/#content-start";
        GhostOfTheNavigator!.NavigateTo(home, false);
    }

    private void _loadSettings()
    {
        this._settings = this._settingsRepository.GetSettings();
    }

    protected override void OnInitialized()
    {
        base.OnInitialized();
        this._loadSettings();
    }
}

