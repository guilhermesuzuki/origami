@using System;
@using System.Threading;
@using System.Globalization;
@using Microsoft.AspNetCore.Localization;

@inherits Basic
@implements IBlogId
@inject ISettingsRepository _settingsRepository

<div class="m-auto wrapper">
    <div class="@Class logo cursor-pointer position-relative" style="z-index:25;" @onclick="GoHome">
        <Languages Class="mb-3"></Languages>
        @if (this._blogSettings.LogoUrl.Has() == true)
        {
            <div class="text-center">
                <img class="logo-image" src="@_blogSettings.LogoUrl" title="@_blogSettings.LogoUrl" />
            </div>
        }
        <div class="text-center site-name-container" style="margin-top: -40px;">
            <span class="fw-bold site-name" style="font-size: 4.5rem;">@_blogSettings.Name</span>
        </div>
    </div>
    @if (this.SubtitleTemplate != null)
    {
        <div class="text-center site-subtitle-container position-relative" style="z-index:25;">
            @this.SubtitleTemplate
        </div>
    }
</div>

@code {
    private OrigamiSettings _blogSettings = new();

    [Parameter] public RenderFragment? SubtitleTemplate { get; set; }

    private void GoHome()
    {
        var home = "/#content-start";
        GhostOfTheNavigator!.NavigateTo(home, false);
    }

    private void _loadSettings()
    {
        this._blogSettings = this._settingsRepository.GetSettings();
    }

    protected override void OnInitialized()
    {
        base.OnInitialized();
        this._loadSettings();
    }
}

