@inherits Basic
@implements IEntityNull<BaseComment>
@inject ISocialProfileRepository _socialProfile

@if (Entity != null)
{
    var socialProfile = this.Super.SocialProfiles.ReadFromCache().Id(Entity.SocialProfileId) ?? new();
    <div class="comment-lite @Class">
        @if (this.ShowParentHeader)
        {
            <div class="comment-parent-header d-inline-flex align-items-center">
                @if (Entity is OrigamiContentComment contentComment)
                {
                    var content = this.Super.Contents.ReadFromCache().Id(contentComment.ContentId);
                    <ContentHeaderInline Entity="content"></ContentHeaderInline>
                }
            </div>
        }
        <div></div>
        @if (this.Entity.SocialProfileId != null)
        {
            <div class="comment-header d-inline-flex align-items-center">
                <SocialProfileHeaderLite Entity="socialProfile"></SocialProfileHeaderLite>
            </div>
        }
        else if (this.Entity.UserId != null)
        {
            var user = this.Super.Users.ReadFromCache().Id(this.Entity.UserId);
            <UserHeaderInline Entity="user"></UserHeaderInline>
        }
        <div class="comment-info x-small">
            @if (Entity.PinnedById != null)
            {
                <span class="pe-1">
                    <i class="bi bi-pin-fill"></i>
                    <span>•</span>
                </span>
            }
            <Id Entity="Entity" Class="pe-1"></Id>
        </div>
        <div class="comment-text mt-2">@(Entity.Content.Markup())</div>
    </div>
}

@code {
    [Parameter] public BaseComment? Entity { get; set; }
    [Parameter] public bool ShowParentHeader { get; set; } = false;
}
