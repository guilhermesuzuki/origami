@inherits Basic
@implements IBlogId
@implements IShowFakes
@inject IPostRepository _post
@inject IPostViewRepository _postView

@if (MostPopular.Count > 0)
{
    <div class="post-most-popular @Class overflow-auto">
        <label class="w-100 text-center text-danger fs-1">
            <i class="fa-solid fa-fire"></i>
            <span>@Text.Lower("Most popular")</span>
        </label>
        <div class="d-inline-flex mt-3 pb-2 position-relative">
            @foreach (var post in MostPopular)
            {
                <div class="pe-1" style="width:300px;">
                    <PostHeader Entity="post"></PostHeader>
                </div>
            }
        </div>
    </div>
}
else if (this.ShowFakes == true)
{
    <div class="post-most-popular fakes @Class overflow-auto">
        <label class="w-100 text-center text-danger fs-1">
            <i class="fa-solid fa-fire"></i>
            <span>@Text.Lower("Most popular")</span>
        </label>
        <div class="d-inline-flex mt-3 pb-2 position-relative">
            @foreach (var Post in OrigamiPost.GetFakes())
            {
                <div class="pe-1" style="width:300px;">
                    <PostHeader Class="fake" Entity="Post"></PostHeader>
                </div>
            }
            <div class="position-absolute zeroes bg-white bg-opacity-75"></div>
        </div>
    </div>
}
@code {
    [Parameter] public Guid BlogId { get; set; }
    [Parameter] public bool ShowFakes { get; set; } = false;
    protected List<OrigamiPost> MostPopular { get; set; } = new();

    protected override void OnParametersSet()
    {
        base.OnInitialized();
        this.LoadPosts();
    }

    protected void LoadPosts()
    {
        this.MostPopular = _post.ReadFromCache()
            .NonDeleted()
            .Published()
            .Blog(this.BlogId)
            .OrderByDescending(x => _postView.GetViews(x))
            .ThenBy(x => x.Title)
            .Take(10)
            .ToList();
    }
}
