@using Origami.Core.Models.FileSystem
@inherits Basic
@implements IEntityNull<IHeaderImage>
@implements IHeaderImage
@if (this.Entity != null && this.Entity.HeaderImage.Has() == true)
{
    <div class="header-image-lite @Class">
        
        <img class="w-100 mb-1"
             src="@this.HeaderImage"
             style="height:auto;@(ImgMaxWidth != null ? "max-width:" + ImgMaxWidth + ";" : null)"
             title="@Entity.HeaderImage" />

        @if (this.Footer)
        {
            @if (this.Entity.HeaderImage.StartsWith("data:image") == true)
            {
                <div class="footer text-center x-small p-1 border">
                    <span class="">@Text.Lower("Base64 image")</span>
                </div>
            }
            else
            {
                var file = this.Super.Files.GetFile(Entity.HeaderImage);
                @if (file != null)
                {
                    <div class="footer text-center x-small p-1 border">
                        <span>@(new OrigamiSystemFile(file.LocalPath, this.Entity.HeaderImage).Name)</span>
                        <span class="ps-1">@file.FileSize.SizeInBytes()</span>
                    </div>
                }
            }
        }
    </div>
}

@code {

    [Parameter] public IHeaderImage? Entity { get; set; }

    /// <summary>
    /// Image's CSS Max-Width
    /// </summary>
    [Parameter] public string ImgMaxWidth { get; set; } = "100%";

    /// <summary>
    /// Should the footer be displayed?
    /// </summary>
    [Parameter] public bool Footer { get; set; } = false;

    /// <summary>
    /// Header image URL or base64 image.
    /// </summary>
    public string HeaderImage
    {
        get
        {
            if (this.Entity != null)
            {
                if (this.Entity.HeaderImage.StartsWith("data:image", StringComparison.CurrentCultureIgnoreCase) == false)
                {
                    return this.Entity.HeaderImage.QueryString("v", this.Version);
                }
                return this.Entity.HeaderImage;
            }
            return string.Empty;    
        }
        set => throw new NotSupportedException("HeaderImage is a read-only property.");
    }

    /// <summary>
    /// Extracts the version from <see cref="Entity"/>
    /// </summary>
    protected string Version
    {
        get
        {
            if (this.Entity is IVersion version) return version.Version.HexString();
            return string.Empty;
        }
    }
}
