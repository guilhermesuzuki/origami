{
  "version": "1.0",
  "defaultProvider": "cdnjs",
  "libraries": [
    {
      "provider": "cdnjs",
      "library": "jquery@4.0.0",
      "destination": "wwwroot/lib/jquery/"
    },
    {
      "provider": "cdnjs",
      "library": "jquery-migrate@4.0.2",
      "destination": "wwwroot/lib/jquery-migrate/"
    },
    {
      "provider": "cdnjs",
      "library": "jquery-cookie@1.4.1",
      "destination": "wwwroot/lib/jquery-cookie/"
    },
    {
      "provider": "cdnjs",
      "library": "font-awesome@7.3.1",
      "destination": "wwwroot/lib/font-awesome/"
    }
  ]
}
