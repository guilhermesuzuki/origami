                    </div>
                </div>
            </div>
            <div class="col-12 col-md-6 col-xxl-2 mb-3">
                <div class="border border-2 h-100 p-3 cursor-pointer" @onclick="GoToSoftwareReleases">
                    <div class="text-center" style="bottom:0;">
                        <i class="fa-solid fa-file-zipper"></i>
                        <span>@Text.Lower("Software releases")</span>
                    </div>
                </div>
            </div>
            <div class="col-12 col-md-6 col-xxl-2 mb-3">
                <div class="border border-2 h-100 p-3 cursor-pointer" @onclick="GoToRoles">
                    <div class="text-center" style="bottom:0;">
                        <i class="fa-solid fa-id-badge"></i>
                        <span>@Text.Lower("Roles")</span>
                    </div>
                </div>
            </div>
            <div class="col-12 col-md-6 col-xxl-2 mb-3">
                <div class="border border-2 h-100 p-3 cursor-pointer" @onclick="GoToUsers">
                    <div class="text-center" style="bottom:0;">
                        <i class="fa-solid fa-user-group"></i>
                        <span>@Text.Lower("Users")</span>
                    </div>
                </div>
            </div>
            <div class="col-12 col-md-6 col-xxl-2 mb-3">
                <div class="border border-2 h-100 p-3 cursor-pointer" @onclick="GoToBackupAndRestore">
                    <div class="text-center" style="bottom:0;">
                        <i class="fa-solid fa-database"></i>
                        <span>@Text.Lower("Backup and restore")</span>
                    </div>
                </div>
            </div>
            <div class="col-12 col-md-6 col-xxl-2 mb-3">
                <div class="border border-2 h-100 p-3 cursor-pointer" @onclick="GoToSettings">
                    <div class="text-center" style="bottom:0;">
                        <i class="fa-solid fa-gear"></i>
                        <span>@Text.Lower("Settings")</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="mt-5">
        <div class="row" style="min-height: 150px;">
            <div class="col-12 col-md-6 col-xxl-2 mb-3">
                <div class="border border-2 h-100 p-3 cursor-pointer" @onclick="GoToFileManager">
