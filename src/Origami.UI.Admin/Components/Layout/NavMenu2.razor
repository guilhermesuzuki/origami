@using Microsoft.Extensions.Caching.Memory

@inherits Basic

@inject IMemoryCache _memoryCache
@inject ISuperRepository _superRepository
@inject IHttpContextAccessor _httpContextAccessor

<style>
    .logged-in-user .id { display: none !important; }
</style>
<div class="p-5 @Class">
    @if (this.Super.Roles.CanTheUserViewTheConnectivityDetails(this.UserFacade.User) == true)
    {
        <div class="">
            <div class="row">
                <div class="col-12 mb-3">
                    <div class="border border-2 h-100 p-3 cursor-pointer">
                        <ConnectionDetails Class="p-2"></ConnectionDetails>
                    </div>
                </div>
            </div>
        </div>
    }
    <div class="mt-5">
        <div class="row" style="min-height: 150px;">
            <div class="col-12 col-xxl-6 mb-3">
                <div class="border border-2 h-100 p-3 cursor-pointer">
                    <div class="text-center mb-3">
                        <i class="fa-solid fa-person-digging"></i>
                        <span>@Text.Lower("Maintenance mode")</span>
                    </div>
                    <div class="text-center">
                        <div class="btn-group">
                            <button class="btn btn-danger text-white" title="@Text.Lower("Enter maintenance mode")" disabled="@this.DisableEnterMaintenanceModeButton" @onclick="this.EnterMaintenanceMode">
                                <i class="fa-solid fa-arrow-down"></i>
                                <span class="">@Text.Lower("Enter")</span>
                            </button>
                            <button class="btn btn-success text-white" title="@Text.Lower("Leave maintenance mode")" disabled="@this.DisableLeaveMaintenanceModeButton" @onclick="this.LeaveMaintenanceMode">
                                <i class="fa-solid fa-arrow-up"></i>
                                <span class="">@Text.Lower("Leave")</span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-12 col-xxl-6 mb-3">
                <div class="border border-2 h-100 p-3 cursor-pointer" @onclick="GoToCacheExplorer">
                    <div class="text-center">
                        <i class="fa-solid fa-book"></i>
                        <span>@Text.Lower("Cache explorer")</span>
                    </div>
                </div>
            </div>

        </div>
    </div>
    <div class="">
        <div class="row" style="min-height: 150px;">
