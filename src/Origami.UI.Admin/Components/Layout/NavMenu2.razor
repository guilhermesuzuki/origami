    <div class="">
        <div class="row" style="min-height: 150px;">
            <div class="col-12 col-md-6 col-xxl-2 mb-3">
                <div class="border border-2 h-100 p-3 cursor-pointer" @onclick="GoToPages">
                    <div class="text-center" style="bottom:0;">
                        <i class="bi bi-file-earmark-text-fill"></i>
