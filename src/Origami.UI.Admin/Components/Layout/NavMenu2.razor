    }

    private void GoToSoftwareReleases()
    {
        this.GhostOfTheNavigator.NavigateTo($"/softwarereleases");
    }

    private async Task RegenerateNanoIds()
    {
        var answer = await this.DialogService.ShowMessageBoxAsync(
            this.Text.Upper("Regenerate nano-ids"),
            this.Text.Original("Are you sure?"),
            yesText: this.Text.Lower("Yes"),
            noText: this.Text.Lower("No"));

        if (answer.GetValueOrDefault() == true)
        {
            try
            {
                using (var transaction = new TransactionScope())
                {
                    this.UserFacade.Result = _superRepository.RegenerateNanoIds();
                    transaction.Complete();
                }
                this.GhostOfTheNavigator.NavigateTo(this.GhostOfTheNavigator.Uri, forceLoad: true);
            }
            catch (Exception ex)
            {
                this.UserFacade.Result = new(ex);
                return;
            }
        }
    }

    protected Location? GetUserLocation()
    {
        if (_httpContextAccessor.HttpContext == null) return null;
        return _memoryCache.Get<Location?>($"Origami_UserLocation_{_httpContextAccessor.HttpContext.Connection.Id}");
    }

    private void GoToBackupAndRestore()
    {
        this.GhostOfTheNavigator.NavigateTo($"/backups");
    }
}
