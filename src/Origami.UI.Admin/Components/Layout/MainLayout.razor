@using Microsoft.AspNetCore.Identity
@using System.Security.Claims
@inherits BasicLayout

<CustomHeadContent>
    <link rel="stylesheet" href="_content/Origami.UI/lib/css/style-site-admin.css" />
    <AppLinks></AppLinks>
</CustomHeadContent>
<PageTitle>@Text.Lower("Admin"): @Super.Settings.GetSettings().Name.ToLower()</PageTitle>
@if (UserFacade.User.New != true)
{
    <div class="page">
        <ProcessResult></ProcessResult>
        <div class="sidebar col-12 col-lg-3 hidden-sm visible-lg position-sticky overflow-hidden" style="overflow-y:auto!important;">
            <Logo Class="p-4 border-bottom" />
            <NavMenu></NavMenu>
        </div>
        <main class="overflow-hidden position-relative" style="overflow-y:auto !important;">
            <EmailStatus></EmailStatus>    
            @Body
        </main>
    </div>
}
else
{
    <RedirectToLogin></RedirectToLogin>
}
<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />
<BlazorErrorUi></BlazorErrorUi>

@code {

    /// <summary>
    /// Loads the authenticated user
    /// </summary>
    /// <returns></returns>
    protected override async Task LoadUserAsync()
    {
        var state = await this.AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (state == null) return;
        if (state.User.Identity == null) return;
        if (state.User.Identity.IsAuthenticated == false) return;

        var nameId = state.User.FindFirstValue(ClaimTypes.NameIdentifier);
        if (nameId != null && Guid.TryParse(nameId, out var id) == true)
        {
            this.UserFacade.User = this.Super.Users.ReadFromCache().Id(id) ?? new();
        }
    }
}
