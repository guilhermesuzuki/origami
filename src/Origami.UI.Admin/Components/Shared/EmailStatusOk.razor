@inherits Basic
@inject IEmailStatusRepository _emailStatusRepository
@if (_emailStatusRepository.Status?.Ok == true)
{
    <div class="text-success mb-2">
        <i class="bi bi-check-square-fill"></i>
        <span>
            @_emailStatusRepository.Status.DateCreated:
            @Text.Lower("Email settings are fine")
        </span>
    </div>
}
@code {
    protected override void OnInitialized()
    {
        base.OnInitialized();
        this.AppFacade.RefreshingTheUI += _refreshingTheUIAsync;
    }

    public override void Dispose()
    {
        this.AppFacade.RefreshingTheUI -= _refreshingTheUIAsync;
        base.Dispose();
    }

    private async void _refreshingTheUIAsync(object? sender, object args)
    {
        if (sender is string s)
        {
            if (s.Like(OrigamiConstants.Events.EmailStatus) == true) await this.InvokeAsync(this.StateHasChanged);
        }
    }
}
