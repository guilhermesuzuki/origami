@inherits Basic
@using System.IO
@using System.Buffers
@using Microsoft.AspNetCore.Components.Forms
@inject IWebHostEnvironment Env
@inject IJSRuntime Js
@inject IDirectoryRepository directoryRepository

<!-- File upload form -->
<form class="file-upload" @onsubmit="_onSubmitAsync">
    <InputFile @key="InputFileId" OnChange="_onInputFileChange" AdditionalAttributes="@this._fileAttributes" />
    <div class="p-3 border mt-3">
        <table class="w-100">
            <thead>
                <tr>
                    <td class="w-50">@Text.Upper("Name")</td>
                    <td>@Text.Upper("Type")</td>
                    <td>@Text.Upper("Size")</td>
                    <td class="w-25">@Text.Upper("Progress")</td>
                    <td class="text-center">@Text.Upper("Status")</td>
                </tr>
            </thead>
            <tbody>
                @foreach (var upload in this._uploadFiles)
                {
                    <tr @key="upload.Id">
                        <td>@upload.File.Name</td>
                        <td>@upload.File.ContentType</td>
                        <td>@upload.File.Size.SizeInBytes()</td>
                        <td>
                            <!-- Progress bar for file upload -->
                            <div class="progress" style="height: 10px;">
                                <div class="progress-bar bg-secondary" role="progressbar" style="width: @_getProgress(upload)%;" aria-valuenow="@_getProgress(upload)" aria-valuemin="0" aria-valuemax="100"></div>
                            </div>
                        </td>
                        <td class="text-center">
                            @if (_getProgress(upload) >= 100 && upload.Exception is null)
                            {
                                <i class="fa-solid fa-circle-check text-success"></i>
                            }
                            else if (upload.Exception != null)
                            {
                                <i class="fa-solid fa-triangle-exclamation text-danger"></i>
                                @Text.Lower("Error")
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="text-right mt-3">
        <div class="btn-group">
            <button class="btn btn-primary" type="submit" disabled="@_isProcessing">
                <i class="fa-solid fa-file-arrow-up"></i>
                @Text.Lower("Upload")
            </button>
            <button class="btn btn-danger" @onclick="this._cancelUpload" disabled="@(_isProcessing == false)">
                <i class="fa-solid fa-stop"></i>
                @Text.Lower("Stop")
            </button>
            <button class="btn btn-secondary" @onclick="this._closeWindow">
                <i class="fa-solid fa-circle-xmark"></i>
                @Text.Lower("Close")
            </button>
        </div>
    </div>
</form>

@code {
    /// <summary>
    /// Blazor server workaround
    /// </summary>
    /// <param name="upload"></param>
    /// <returns></returns>
    private int _getProgress(Models.UploadFile upload)
    {
        return this._uploadProgress.ContainsKey(upload.File.Name) ? this._uploadProgress[upload.File.Name] : 0;
    }

    // Constants for file size and allowed extensions
    private const long MaxFileSize = 2L * 1024L * 1024L * 1024L; // 2 GB

    private Guid InputFileId { get; set; } = Guid.NewGuid();
    private IEnumerable<Models.UploadFile> _uploadFiles = [];
    private CancellationTokenSource _cancellationTokenSource = new();
    private Dictionary<string, int> _uploadProgress = new();
    private bool _isProcessing = false;

    [Parameter] public bool MultipleFiles { get; set; } = true;
    [Parameter] public string AcceptFiles { get; set; } = "*";
    [Parameter] public string VirtualPath { get; set; } = "/files/";
    [Parameter] public EventCallback<IEnumerable<Models.UploadFile>> OnCloseWindow { get; set; }

    /// <summary>
    /// InputFile attributes
    /// </summary>
    private Dictionary<string, object> _fileAttributes
    {
        get
        {
            var attributes = new Dictionary<string, object>();

            attributes["class"] = "form-control";
            attributes["aria-describedby"] = "uploadButton";
            attributes["required"] = "required";

            if (this.AcceptFiles.Has() == true) attributes["accept"] = this.AcceptFiles;
            if (this.MultipleFiles) attributes["multiple"] = "multiple";

            return attributes;
        }
    }

    private void _cancelUpload()
    {
        this._cancellationTokenSource.Cancel();
    }

    private async Task _closeWindow()
    {
        this._cancelUpload();
        await this.OnCloseWindow.InvokeAsync(this._uploadFiles);
    }

    // Handle file selection
    private async Task _onInputFileChange(InputFileChangeEventArgs e)
    {
        this._uploadFiles = from file in e.GetMultipleFiles(1024) select new Models.UploadFile(file);
        this._cancellationTokenSource = new();

        await this.InvokeAsync(this.StateHasChanged);
    }

    // Handle file upload
    private async Task _onSubmitAsync()
    {
        this._isProcessing = true;

        // Set up timer for UI updates
        using var timer = new Timer(_ => InvokeAsync(StateHasChanged));
        timer.Change(TimeSpan.FromMilliseconds(500), TimeSpan.FromMilliseconds(500));

        try
        {
            long totalSize = this._uploadFiles.Select(x => x.File.Size).Sum();

            foreach (var upload in this._uploadFiles)
            {
                this._uploadProgress[upload.File.Name] = 0;

                await using Stream stream = upload.File.OpenReadStream(MaxFileSize, this._cancellationTokenSource.Token);
                string basePath = this.directoryRepository.LocalPath(this.VirtualPath);
                string tempPath = Path.Combine(basePath, $"{Guid.NewGuid()}.tmp");

                const int bufferSize = 1024 * 1024; // 1024 KB
                byte[] buffer = ArrayPool<byte>.Shared.Rent(bufferSize);

                long fileBytesRead = 0;

                try
                {
                    using (FileStream fs = System.IO.File.Create(tempPath))
                    {
                        int bytesRead;
                        while ((bytesRead = await stream.ReadAsync(buffer, this._cancellationTokenSource.Token)) != 0)
                        {
                            fileBytesRead += bytesRead;
                            this._uploadProgress[upload.File.Name] = (int)(100 * fileBytesRead / upload.File.Size);
                            await fs.WriteAsync(buffer.AsMemory(0, bytesRead));
                            upload.Id = Guid.NewGuid();
                        }
                    }

                    this._uploadProgress[upload.File.Name] = 100;
                    upload.Id = Guid.NewGuid();

                    var finalPath = Path.Combine(basePath, upload.File.Name);
                    System.IO.File.Move(tempPath, finalPath, true);
                }
                catch (TaskCanceledException ex)
                {
                    this.UserFacade.Result = new(ex);
                    return;
                }
                catch (Exception ex)
                {
                    upload.Exception = ex;
                    upload.Id = Guid.NewGuid();
                    continue;
                }
                finally
                {
                    ArrayPool<byte>.Shared.Return(buffer);
                }
            }

            this.UserFacade.Result = new();
        }
        catch (Exception ex)
        {
            this.UserFacade.Result = new(ex);
        }
        finally
        {
            this._isProcessing = false;

            // Clean up and update UI
            timer.Change(Timeout.Infinite, Timeout.Infinite);

            this.InputFileId = Guid.NewGuid();

            StateHasChanged();
        }
    }
}