@using Origami.Core.Models.FileSystem
@inherits BasicFormFull<OrigamiCategory>
@inject IBlogRepository _blog
@inject ICategoryRepository _repository
@inject IFileRepository _fileRepository

<div class="category-form @Class">
    <BasicHeaderNotes Entity="Entity"></BasicHeaderNotes>
    <div class="parent-selector mt-3">
        @if (this.Entity.ParentId != null)
        {
            var parent = this.Repository.ReadFromCache().Id(this.Entity.ParentId.Value);
            <div class="p-3 border">
                <div class="wrapper p-3 border">
                    <CategoryHeaderLite Class="" Entity="parent"></CategoryHeaderLite>
                </div>
                <div class="btn-group mt-2 w-100">
                    <button class="btn btn-light w-100" @onclick="() => this.ShowParentSelector = !this.ShowParentSelector">
                        <i class="fa-solid fa-square-check"></i>
                        @Text.Lower("Select parent category")
                    </button>
                    <button class="btn btn-light w-100" @onclick="() => this.Entity.ParentId = null">
                        <i class="fa-solid fa-trash-can"></i>
                        @Text.Lower("Clear selection")
                    </button>
                </div>
            </div>
        }
        else
        {
            <div class="p-3 border">
                <div class="btn-group w-100">
                    <button class="btn btn-light w-100" @onclick="() => this.ShowParentSelector = !this.ShowParentSelector">
                        <i class="fa-solid fa-square-check"></i>
                        @Text.Lower("Select parent category")
                    </button>
                </div>
            </div>
        }
        @if (ShowParentSelector)
        {
            <div class="mt-3">
                <MudDataGrid T="OrigamiCategory" Items="this.GetParents()" Filterable="false" SortMode="SortMode.Single" Class="border" Bordered="true" SelectOnRowClick="false">
                    <Columns>
                        <TemplateColumn Title="@Text.Upper("Name")" Sortable="true" Filterable="false" CellClass="col-8" SortBy="x => x.Name">
                            <CellTemplate>
                                <CategoryHeaderLite Class="" Entity="context.Item"></CategoryHeaderLite>
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Sortable="false" Filterable="false" CellClass="col-1 text-center">
                            <CellTemplate>
                                <button class="cursor-pointer p-2" @onclick="() => { this.SetParent(context.Item); this.ShowParentSelector = false; }"><i class="bi bi-check-square-fill"></i></button>
                            </CellTemplate>
                        </TemplateColumn>
                    </Columns>
                    <PagerContent>
                        <MudDataGridPager T="OrigamiCategory" PageSizeOptions="[5]" />
                    </PagerContent>
                    <NoRecordsContent>
                        <NoEntriesWereFound></NoEntriesWereFound>
                    </NoRecordsContent>
                </MudDataGrid>
            </div>
        }
    </div>
    <div class="mt-3 text-center p-3 border">
        <div>
            <HeaderImageCard Entity="this.Entity" Footer="true" ImgMaxWidth="120px;"></HeaderImageCard>
        </div>
        <MudFileUpload T="IBrowserFile" FilesChanged="UploadHeaderBase64" Accept=".png, .jpg, .bmp, .tiff, .gif" MaximumFileCount="1">
            <CustomContent>
                <div class="btn-group mt-2 w-100">
                    <button class="btn btn-light w-100" @onclick="context.OpenFilePickerAsync">
                        <i class="fa-solid fa-cloud-arrow-up"></i>
                        <div>@Text.Lower("Only image files")</div>
                        <div class="x-small">@Text.Original("{0}KB max.", 512)</div>
                    </button>
                    <button class="btn btn-light w-100" @onclick="() => this.FileManagerForImages = true">
                        <i class="fa-solid fa-folder"></i>
                        @Text.Lower("Pick from file manager")
                    </button>
                    <button class="btn btn-light w-100" @onclick="this.ClearHeader">
                        <i class="fa-solid fa-trash-can"></i>
                        @Text.Lower("Clear icon")
                    </button>
                </div>
            </CustomContent>
            <SelectedTemplate></SelectedTemplate>
        </MudFileUpload>
    </div>
    <BasicHeader Class="mt-3" Entity="this.Entity"></BasicHeader>
    <ul class="inline-list mt-3">
        <li>
            <MudTextField Immediate="true"
                          FullWidth="true"
                          @bind-Value="@Entity.Name"
                          HelperText="@Text.Lower("Name")"></MudTextField>
        </li>
        <li>
            <MudTextField Immediate="true"
                          FullWidth="true"
                          ReadOnly="true"
                          Value="@Entity.Slug"
                          HelperText="@Text.Lower("Slug")"></MudTextField>
        </li>
    </ul>
    
    <MudTextField Class="mt-3"
                  FullWidth="true"
                  Immediate="true"
                  @bind-Value="@Entity.Description"
                  HelperText="@Text.Lower("Description")"></MudTextField>

    <div class="buttons btn-group mt-3 w-100">
        <button class="btn btn-success text-white fw-bold" @onclick="Save" disabled="@this.DisableTheSaveButton">
            <i class="fa-solid fa-floppy-disk"></i>
            @Text.Lower("Save")
        </button>
        <button class="btn btn-secondary text-white fw-bold" @onclick="UndoChanges" disabled="@this.Entity.New">
            <i class="fa-solid fa-rotate-left"></i>
            @Text.Lower("Undo changes")
        </button>
        <button class="btn btn-info text-white fw-bold" @onclick="CreateEntity">
            <i class="fa-solid fa-square-plus"></i>
            @Text.Lower("New")
        </button>
    </div>
</div>
@if (this.FileManagerForImages)
{
    <div class="position-fixed popup-container">
        <div class="border shadow-lg position-relative" style="width: 90%; height: 90%;">
            <div class="overflow-auto" style="height:100%; padding-bottom: 70px;">
                <FileManager Mode="Image" OnFileClicked="this.ImageFromFileManagerWillAssignEntityHeaderAsBase64"></FileManager>
            </div>
            <ul class="inline-list position-absolute w-100 border bg-white" style="bottom:0; z-index: 50;">
                <li></li>
                <li class="text-right">
                    <div class="btn-group p-3">
                        <button class="btn btn-secondary" @onclick="() => this.FileManagerForImages = false">
                            <i class="fa-solid fa-circle-xmark"></i>
                            @Text.Lower("Close window")
                        </button>
                    </div>
                </li>
            </ul>
        </div>
    </div>
}
@code {
    protected override IEnumerable<OrigamiCategory> GetParents()
    {
        return from x in this.Super.GetCategories().Blog(this.UserFacade.BlogId) select x;
    }
}
