@inherits Basic
@implements IId
@inject IPostRepository _post
@inject IContentCommentReactionRepository _postCommentReaction
@inject IContentCommentRepository _postComment
@inject IContentRatingRepository _postRating

@if (Id != Guid.Empty)
{
    var comment = _postComment.ReadFromCache().Id(Id);
    if (comment != null)
    {
        var post = this.Super.Contents.ReadFromCache().OfType<OrigamiPost>().Id(comment!.ContentId)!;
        <div class="user-activity-post-comment @Class">
            <label class="fw-bold">@Text.Lower("Commented On Post:")</label>
            <ContentHeaderLite Entity="post"></ContentHeaderLite>
            <CommentLite Class="mt-2 p-2 frame-purple" Entity="comment"></CommentLite>
        </div>
    }
}

@code {
    [Parameter] public override Guid Id { get; set; }
}
