@inherits Basic
@if (Access.Ok == true)
{
    <div class="root @Class">
        @if (HeaderTemplate != null)
        {
            <div class="template-header position-sticky bg-white border-top" style="top:0;z-index:50;">@HeaderTemplate</div>
            <div class="p-3 border" style="border-top: none !important;">
                <Search></Search>
            </div>
        }
        @if (ContentTemplate != null)
        {
            <div class="template-content">@ContentTemplate</div>
        }
    </div>
}
else
{
    <YouDontHaveAccess Entity="Access"></YouDontHaveAccess>
}
@code {
    [Parameter] public Core.Models.Result Access { get; set; } = new();
    [Parameter] public RenderFragment? ContentTemplate { get; set; }
    [Parameter] public RenderFragment? HeaderTemplate { get; set; }
}