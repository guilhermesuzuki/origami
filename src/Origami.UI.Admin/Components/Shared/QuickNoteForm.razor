@inherits BasicForm<OrigamiQuickNote>

<div class="quick-note @Class">
    <BasicHeaderNotes Entity="this.Entity"></BasicHeaderNotes>
    <BasicHeader Class="mt-3" Entity="this.Entity"></BasicHeader>
    <ul class="inline-list mt-3">
        <li>
            <LanguageWrittenOn Entity="this.Entity"></LanguageWrittenOn>
        </li>
    </ul>
    <ul class="inline-list mt-3">
        <li>
            <MudTextField FullWidth="true"
                          Immediate="true"
                          @bind-Value="@Entity.Note"
                          HelperText="@Text.Lower("Type your note here")"></MudTextField>
        </li>
    </ul>
    <div class="buttons mt-3 p-3 text-center">
        <div class="btn-group">
            <button class="btn btn-success text-white fw-bold" @onclick="Save" disabled="@this.DisableTheSaveButton">
                <i class="fa-solid fa-floppy-disk"></i>
                @Text.Lower("Save")
            </button>
            <button class="btn btn-secondary text-white fw-bold" @onclick="UndoChanges" disabled="@this.Entity.New">
                <i class="fa-solid fa-rotate-left"></i>
                @Text.Lower("Undo changes")
            </button>
            <button class="btn btn-info text-white fw-bold" @onclick="CreateEntity">
                <i class="fa-solid fa-square-plus"></i>
                @Text.Lower("New")
            </button>
        </div>
    </div>
</div>

@code {

    public override void Save()
    {
        try
        {
            var hub = new Core.Models.Result<OrigamiQuickNote>(Entity);

            Entity.AuthorId = this.UserFacade.User.Id;
            Entity.BlogId = this.UserFacade.BlogId;
            Entity.DateCreated = DateTime.UtcNow;

            var context = new DataOperationContext<OrigamiQuickNote>(this.UserFacade.User, DateTime.UtcNow, this.Entity);

            using (var transaction = new TransactionScope())
            {
                this.Super.QuickNotes.SmartSave(context, true).Push(hub);
                if (hub.Ok)
                {
                    transaction.Complete();
                }
            }

            this.CreateEntity().Wait();

            this.UserFacade.Result = hub;
            this.Saved.InvokeAsync(this.Entity);
        }
        catch (Exception e)
        {
            this.UserFacade.Result = new() { ErrorMessage = e.GetMessage() };
        }
    }
}
