@inherits Basic
@implements IId
@inject ISocialProfileDeleteRepository _socialProfileDelete

@if (Id != Guid.Empty)
{
    var socialProfileDelete = _socialProfileDelete.ReadFromDatabase().Id(Id);
    if (socialProfileDelete != null)
    {
        <div class="user-activity-social-profile-delete @Class bg-danger text-white p-3">
            <label class="fw-bold">
                @Text.Lower("Profile data was wiped out")
            </label>
            <ul class="inline-list small">
                <li style="width:33.34%;">
                    <i class="fa-solid fa-comment"></i>
                    @Text.Lower("{0} Post Comment(s)", socialProfileDelete.PostComments)
                </li>
                <li style="width:33.33%;">
                    <i class="fa-solid fa-face-laugh-beam"></i>
                    @Text.Lower("{0} Post Reaction(s)", socialProfileDelete.PostCommentReactions)
                </li>
                <li style="width:33.33%;">
                    <i class="fa-solid fa-star"></i>
                    @Text.Lower("{0} Post Rating(s)", socialProfileDelete.PostRatings)
                </li>
            </ul>
            <ul class="inline-list small">
                <li style="width:33.34%;">
                    <i class="fa-solid fa-comment"></i>
                    @Text.Lower("{0} Video Comment(s)", socialProfileDelete.VideoComments)
                </li>
                <li style="width:33.33%;">
                    <i class="fa-solid fa-face-laugh-beam"></i>
                    @Text.Lower("{0} Video Reaction(s)", socialProfileDelete.VideoCommentReactions)
                </li>
                <li style="width:33.33%;">
                    <i class="fa-solid fa-star"></i>
                    @Text.Lower("{0} Video Rating(s)", socialProfileDelete.VideoRatings)
                </li>
            </ul>
        </div>
    }
}

@code {
    [Parameter] public override Guid Id { get; set; }
}
