@using FluentValidation
@inherits Basic
@implements IEntityNull<HubContentPost>

@if (Entity != null)
{
    var validation = this.Validator?.Validate(this.Entity);
    <div class="post-summary @Class">
        <table class="w-100" style="max-width: 500px;">
            <thead>
                <tr>
                    <td class="fw-bold">@Text.Original("Name")</td>
                    <td class="fw-bold">@Text.Original("Error")</td>
                    <td></td>
                </tr>
            </thead>
            <tbody>
                @if (validation is { IsValid: false })
                {
                    foreach(var error in validation.Errors)
                    {
                        <tr>
                            <td>@error.PropertyName</td>
                            <td>@error.ErrorMessage</td>
                            <td class="text-danger" style="width: 20px;">
                                <i class="fa-solid fa-circle-xmark"></i>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
}

@code {
    [Parameter] public HubContentPost? Entity { get; set; }
    [Inject] public IValidator<HubContentPost>? Validator { get; set; }
}
