@inherits BasicFormFullContent<OrigamiQuickNote, HubContentQuickNote>

<div class="quick-note @Class">
    <ul class="inline-list">
        <li class="w-50">
            <LanguageWrittenOn Entity="this.Entity.Entity"></LanguageWrittenOn>
        </li>
        <li class="w-50">
            <MudTextField ReadOnly="true"
            FullWidth="true"
            Immediate="true"
            Value="@Author.Username.ToLower()"
            HelperText="@Text.Lower("Author")"></MudTextField>
        </li>
    </ul>
    <ul class="inline-list">
        <li>
            <MudTextField FullWidth="true"
            Immediate="true"
            @bind-Value="@Entity.Entity.Title"
            HelperText="@Text.Lower("Type Here")"></MudTextField>
        </li>
    </ul>
    <div class="btn-group w-100 mt-3">
        <button class="btn btn-success" disabled="@DisableTheSaveButton" @onclick="Save">@Text.Upper("Save and publish")</button>
    </div>
</div>

@code {
    public override void Save()
    {
        try
        {
            var hub = new Core.Models.Result<OrigamiQuickNote>(Entity.Entity);

            Entity.Entity.AuthorId = this.UserFacade.User.Id;
            Entity.Entity.BlogId = this.UserFacade.BlogId;
            Entity.Entity.DateCreated = DateTime.UtcNow;
            Entity.Entity.Background = OrigamiConstants.BackgroundGradients[Random.Shared.Next(OrigamiConstants.BackgroundGradients.Length)];

            using (var transaction = new TransactionScope())
            {
                this.HubContentRepository.Save(this.Entity, this.UserFacade.User).Push(hub);
                hub.OnSuccess(() => this.HubContentRepository.Publish(this.Entity, this.UserFacade.User).Push(hub));
                hub.OnSuccess(() => transaction.Complete());
            }

            this.CreateEntity().Wait();

            this.UserFacade.Result = hub;
        }
        catch (Exception e)
        {
            this.UserFacade.Result = new() { Error = e.GetMessage() };
        }
    }
}
