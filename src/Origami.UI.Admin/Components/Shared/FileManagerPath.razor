@inherits Basic
@implements IVirtualPath

<div class="file-manager-path @Class d-inline-flex align-items-start">
    @foreach (var path in this.PathBrokenDown)
    {
        <span class="cursor-pointer d-inline-block me-1" @onclick="async () => await this.OnPathClicked.InvokeAsync(path.VirtualPath)" @onclick:stopPropagation=true>
            <span class="text-decoration-underline">@path.Name</span>
            @if (path.Context != null)
            {
                <HeaderLite Class="xx-small" Entity="path.Context"></HeaderLite>
            }
        </span>
        @if (path != this.PathBrokenDown.Last())
        {
            <span class="me-1">></span>
        }
    }
</div>

@code {
    [Parameter] public string VirtualPath { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> OnPathClicked { get; set; }

    protected IList<Path> PathBrokenDown = [];

    protected void BreaksDownVirtualPath()
    {
        PathBrokenDown.Clear();

        var virtualPath = this.VirtualPath.Trim('/');
        var split = virtualPath.Split('/');

        for (int i = 0; i < split.Length; i++)
        {
            var path = new Path
            {
                Name = split[i],
                VirtualPath = string.Join('/', split[0..(i + 1)]),
            };
            path.Context = this.Super.GuessWho(path.Name);
            this.PathBrokenDown.Add(path);
        }
    }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        this.BreaksDownVirtualPath();
    }

    protected class Path : IVirtualPath, IName
    {
        public string Name { get; set; } = string.Empty;
        public string VirtualPath { get; set; } = string.Empty;
        public object? Context { get; set; } = null;
    }
}
