@inherits BasicFormFull<OrigamiBlog>

<style>
    .basic-header .line-1 { display: block; }
</style>
<div class="blog-form @Class">
    <div class="row">
        <div class="col-12 col-xxl-4">
            <div class="p-3">
                <BasicHeaderNotes Entity="this.Entity"></BasicHeaderNotes>
                <BasicHeader Class="mt-3" Entity="this.Entity"></BasicHeader>
                <ul class="inline-list mt-3">
                    <li>
                        <MudTextField Immediate="true"
                                      FullWidth="true"
                                      @bind-Value="@Entity.Name"
                                      HelperText="@Text.Lower("Name")"></MudTextField>
                    </li>
                    <li>
                        <MudTextField Immediate="true"
                                      FullWidth="true"
                                      @bind-Value="@Entity.Slug"
                                      HelperText="@Text.Lower("Slug")"></MudTextField>
                    </li>
                </ul>
                <ul class="inline-list mt-3">
                    <li>
                        <MudTextField ReadOnly="true"
                                      FullWidth="true"
                                      Immediate="true"
                                      Value="@(Text.Lower(Entity.IsPrimary.YesNo()))"
                                      HelperText="@Text.Lower("Primary")"></MudTextField>
                    </li>
                    <li>
                        <MudTextField ReadOnly="true"
                                      FullWidth="true"
                                      Immediate="true"
                                      Value="@(Text.Lower(Entity.IsActive.YesNo()))"
                                      HelperText="@Text.Lower("Active")"></MudTextField>
                    </li>
                </ul>
            </div>
            @if (this.Entity.New == false)
            {
                <div class="content p-3 mt-3">
                    <div class="w-100 text-white bg-secondary text-center">
                        <i class="bi bi-file-earmark-text-fill"></i>
                        @Text.Lower("Content")
                    </div>
                    <MudDataGrid T="OrigamiContent" Class="border mt-3" Items="_getContent()" SortMode="SortMode.None" Filterable="false" RowClassFunc="this.RowClassFunc">
                        <Columns>
                            <TemplateColumn>
                                <HeaderTemplate>
                                    @Text.Upper("Header")
                                </HeaderTemplate>
                                <CellTemplate>
                                    <ContentHeaderInline Entity="context.Item"></ContentHeaderInline>
                                </CellTemplate>
                            </TemplateColumn>
                            <TemplateColumn HeaderClass="col-3">
                                <HeaderTemplate>
                                    <span>@Text.Upper("Publish Date")</span>
                                </HeaderTemplate>
                                <CellTemplate>
                                    @if (context.Item.IsPublished)
                                    {
                                        <i class="fa-solid fa-thumbs-up me-1"></i>
                                        <span>@context.Item.DatePublished.Humanize()</span>
                                    }
                                </CellTemplate>
                            </TemplateColumn>
                        </Columns>
                        <PagerContent>
                            <MudDataGridPager T="OrigamiContent" PageSizeOptions="[10, 25, 50, 100]" />
                        </PagerContent>
                    </MudDataGrid>
                </div>
            }
        </div>
        <div class="col-12 col-xxl-8">
            <div class="row">
                <div class="col-12">
                    <div class="text-center p-3">
                        <HeaderImageCard Entity="@Entity"></HeaderImageCard>
                        <MudFileUpload T="IBrowserFile" FilesChanged="UploadHeader" Accept=".png, .jpg, .bmp, .tiff" MaximumFileCount="1">
                            <CustomContent>
                                <div class="btn-group mt-2 w-100">
                                    <button class="btn btn-light w-100" @onclick="context.OpenFilePickerAsync">
                                        <i class="fa-solid fa-cloud-arrow-up"></i>
                                        <div>@Text.Lower("Only image files")</div>
                                        <div class="x-small">@Text.Original("{0}MB max.", 6)</div>
                                    </button>
                                    <button class="btn btn-light w-100" @onclick="() => this.FileManagerForImages = true">
                                        <i class="fa-solid fa-folder"></i>
                                        @Text.Lower("Pick from file manager")
                                    </button>
                                    <button class="btn btn-light w-100" @onclick="ClearHeader">
                                        <i class="fa-solid fa-trash-can"></i>
                                        @Text.Lower("Clear header")
                                    </button>
                                </div>
                            </CustomContent>
                            <SelectedTemplate></SelectedTemplate>
                        </MudFileUpload>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="buttons mt-3 p-3 text-center position-sticky" style="bottom: 0;">
        <div class="btn-group">
            <button class="btn btn-success text-white fw-bold" @onclick="Save" disabled="@this.DisableTheSaveButton">
                <i class="fa-solid fa-floppy-disk"></i>
                @Text.Lower("Save")
            </button>
            <button class="btn btn-secondary text-white fw-bold" @onclick="UndoChanges" disabled="@this.Entity.New">
                <i class="fa-solid fa-rotate-left"></i>
                @Text.Lower("Undo changes")
            </button>
            <button class="btn btn-info text-white fw-bold" @onclick="CreateEntity">
                <i class="fa-solid fa-square-plus"></i>
                @Text.Lower("New")
            </button>
        </div>
    </div>
</div>
@if (FileManagerForImages)
{
    <div class="position-fixed popup-container">
        <div class="border shadow-lg position-relative" style="width: 90%; height: 90%;">
            <div class="overflow-auto" style="height:100%; padding-bottom: 70px;">
                <FileManager Mode="Image" OnFileClicked="this.ImageFromFileManagerWillAssignEntityHeader"></FileManager>
            </div>
            <ul class="inline-list position-absolute w-100 border bg-white" style="bottom:0; z-index: 50;">
                <li></li>
                <li class="text-right">
                    <div class="btn-group p-3">
                        <button class="btn btn-secondary" @onclick="() => this.FileManagerForImages = false">
                            <i class="fa-solid fa-circle-xmark"></i>
                            @Text.Lower("Close window")
                        </button>
                    </div>
                </li>
            </ul>
        </div>
    </div>
}
@code {
    private IEnumerable<OrigamiContent> _getContent()
    {
        return this.Super.Contents.ReadFromCache().Blog(this.Entity.Id).OrderBy(x => x.Title);
    }

    private string RowClassFunc(OrigamiContent content, int index)
    {
        var sb = new StringBuilder();

        if (content.IsDeleted) sb.Append(" deleted");

        return sb.ToString();
    }
}
