@inherits Basic
@implements IId
@inject IPostRepository _post
@inject IContentCommentReactionRepository _postCommentReaction
@inject IContentCommentRepository _postComment
@inject IContentRatingRepository _postRating

@if (Id != Guid.Empty)
{
    var rating = _postRating.ReadFromCache().Id(Id);
    if (rating != null)
    {
        var post = this.Super.Contents.ReadFromCache().OfType<OrigamiPost>().Id(rating.ContentId)!;
        <div class="user-activity-post-rating @Class">
            <label class="fw-bold">@Text.Lower("Rated {0} On:", rating.Rating)</label>
            <PostHeaderLite Entity="post"></PostHeaderLite>
        </div>
    }
}

@code {
    [Parameter] public override Guid Id { get; set; }
}
