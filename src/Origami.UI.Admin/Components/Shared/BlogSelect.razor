@inherits Basic

<MudSelect Class="blog-select"
           FullWidth="true"
           Immediate="true"
           MultiSelection="false"
           Disabled="@Disabled"
           @bind-Value="this.UserFacade.BlogId"
           Style="@Style"
           HelperText="@Text.Lower("Blog")">
    @foreach (var blog in this._getBlogs())
    {
        <MudSelectItem Value="@blog.Id">
            <BlogHeaderLite Entity="blog"></BlogHeaderLite>
        </MudSelectItem>
    }
</MudSelect>

    @code {
    [Parameter] public bool Disabled { get; set; }

    [Parameter] public string Style { get; set; } = string.Empty;

    private IEnumerable<OrigamiBlog> _getBlogs()
    {
        var blogs = from ub in this.Super.UserBlogs.ReadFromCache()
                    join b in this.Super.Blogs.ReadFromCache() on ub.BlogId equals b.Id
                    where b.IsDeleted == false
                    where ub.UserId == this.UserFacade.User.Id
                    select b;

        return blogs;
    }
}
