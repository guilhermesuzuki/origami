@inherits Basic
@implements IId
@inject IVideoRepository _video
@inject IContentCommentReactionRepository _videoCommentReaction
@inject IContentCommentRepository _videoComment
@inject IContentRatingRepository _videoRating

@if (Id != Guid.Empty)
{
    var reaction = _videoCommentReaction.ReadFromCache().Id(Id);
    if (reaction != null)
    {
        var comment = _videoComment.ReadFromCache().Id(reaction.CommentId);
        var video = this.Super.Contents.ReadFromCache().OfType<OrigamiVideo>().Id(comment!.ContentId);
        <div class="user-activity-video-comment-reaction @Class">
            <label class="fw-bold">@Text.Lower("Reacted {0} To:", reaction.Reaction)</label>
            <VideoHeaderLite Entity="video"></VideoHeaderLite>
            <CommentLite Class="mt-2 p-2 frame-purple" Entity="comment"></CommentLite>
        </div>
    }
}

@code {
    [Parameter] public override Guid Id { get; set; }
}
