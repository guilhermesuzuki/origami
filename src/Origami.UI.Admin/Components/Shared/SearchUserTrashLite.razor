@inherits Basic

<div class="search-user-trash-lite @Class">
    <div class="search-field position-relative">
        <ul class="expand-size">
            <li>
                <MudTextField T="string"
                              FullWidth="true"
                              Immediate="true"
                              HelperText="@Text.Lower("Type in here to search")"
                              @bind-Value:get="@_search"
                              @bind-Value:set="@_startQuery"></MudTextField>
            </li>
            <li class="position-relative ms-2" style="flex:none;">
                <button class="m-auto" @onclick="() => this._startQuery(string.Empty)" disabled="@(this._search.Has() ? false : true)">
                    <i class="fa-solid fa-broom"></i>
                </button>
            </li>
        </ul>
    </div>
    @if (this._hits.Any() == true)
    {
        <div class="search-results mt-3 border shadow-lg p-3">
            <div class="row">
                @foreach (var hit in _hits)
                {
                    <div class="cursor-pointer col-12 col-xxl-3" @onclick="() => OnSelect(hit)" @onclick:stopPropagation="true">
                        @if (hit.Type.Like("Blog") == true)
                        {
                            var blog = this.Super.Blogs.ReadFromCache().Id(hit.Id);
                            <BlogHeaderInline Entity="blog"></BlogHeaderInline>
                        }
                        else if (hit.Type.Like("OrigamiPage") == true)
                        {
                            var page = this.Super.Contents.ReadFromCache().Id(hit.Id);
                            <ContentHeaderInline Entity="page"></ContentHeaderInline>
                        }
                        else if (hit.Type.Like("OrigamiPost") == true)
                        {
                            var post = this.Super.Contents.ReadFromCache().Id(hit.Id);
                            <ContentHeaderInline Entity="post"></ContentHeaderInline>
                        }
                        else if (hit.Type.Like("OrigamiVideo") == true)
                        {
                            var video = this.Super.Contents.ReadFromCache().Id(hit.Id);
                            <ContentHeaderInline Entity="video"></ContentHeaderInline>
                        }
                        else if (hit.Type.Like("OrigamiSpecialPage") == true)
                        {
                            var specialPage = this.Super.Contents.ReadFromCache().Id(hit.Id);
                            <ContentHeaderInline Entity="specialPage"></ContentHeaderInline>
                        }
                        else if (hit.Type.Like("OrigamiSpecialMessage") == true)
                        {
                            var specialMessage = this.Super.Contents.ReadFromCache().Id(hit.Id);
                            <ContentHeaderInline Entity="specialMessage"></ContentHeaderInline>
                        }
                        else if (hit.Type.Like("ContentComment") == true)
                        {
                            var comment = this.Super.ContentComments.ReadFromCache().Id(hit.Id);
                            <CommentLite Entity="comment" ShowParentHeader="true"></CommentLite>
                        }
                        else if (hit.Type.Like("Category") == true)
                        {
                            var category = this.Super.Categories.ReadFromCache().Id(hit.Id);
                            <CategoryHeaderInline Entity="category"></CategoryHeaderInline>
                        }
                        else if (hit.Type.Like("User") == true)
                        {
                            var user = this.Super.Users.ReadFromCache().Id(hit.Id);
                            <UserHeader Entity="user"></UserHeader>
                        }
                        else if (hit.Type.Like("Role") == true)
                        {
                            var role = this.Super.Roles.ReadFromCache().Id(hit.Id);
                            <RoleHeaderLite Entity="role"></RoleHeaderLite>
                        }
                        else if (hit.Type.Like("OrigamiQuickNote") == true)
                        {
                            var quickNote = this.Super.Contents.ReadFromCache().OfType<OrigamiQuickNote>().Id(hit.Id);
                            <QuickNoteHeaderLite Entity="quickNote"></QuickNoteHeaderLite>
                        }
                        else if (hit.Type.Like("OrigamiSoftwareRelease") == true)
                        {
                            var softwareRelease = this.Super.Contents.ReadFromCache().OfType<OrigamiSoftwareRelease>().Id(hit.Id);
                            <ContentHeaderInline Entity="softwareRelease"></ContentHeaderInline>
                        }
                    </div>
                }
            </div>
        </div>
    }
    else if (this._search.Has() == true)
    {
        <NothingToSeeHere Class="mt-3 shadow-lg p-3 border"></NothingToSeeHere>
    }
</div>

@code {
    private string _search = string.Empty;

    /// <summary>
    /// List of hits found in the search
    /// </summary>
    private IEnumerable<OrigamiUserTrash> _hits = [];

    /// <summary>
    /// Search timer
    /// </summary>
    private System.Timers.Timer? _searchTimer;

    /// <summary>
    /// Search repository to use
    /// </summary>
    [Inject] protected ISearch<OrigamiUserTrash> Search { get; set; } = null!;

    [Parameter] public EventCallback<OrigamiUserTrash> OnHitSelected { get; set; }

    /// <summary>
    /// Clears the hits list
    /// </summary>
    private void _clearHits()
    {
        this._hits = [];
    }

    /// <summary>
    /// User has typed-in and will start the timer
    /// </summary>
    /// <param name="queryTerm"></param>
    private void _startQuery(string queryTerm)
    {
        this._search = queryTerm;
        this._clearHits();

        if (_searchTimer != null)
        {
            _searchTimer.Stop();
            _searchTimer = null;
        }

        _searchTimer = new();
        _searchTimer.Enabled = true;
        _searchTimer.AutoReset = false;
        _searchTimer.Interval = 750;
        _searchTimer.Elapsed += (o, e) =>
        {
            this._queryLucene(queryTerm);
        };

        _searchTimer.Start();
    }

    /// <summary>
    /// Searches for the <paramref name="queryTerm"/>
    /// </summary>
    /// <param name="queryTerm"></param>
    /// <returns></returns>
    private void _queryLucene(string queryTerm)
    {
        queryTerm = queryTerm.Trim();

        this._clearHits();

        if (queryTerm.Length < 2)
        {
            this.InvokeAsync(this.StateHasChanged);
            return;
        }

        this._hits = this.Search.Search(queryTerm);
        this.InvokeAsync(this.StateHasChanged);
    }

    protected virtual void OnSelect(OrigamiUserTrash item)
    {
        if (this.OnHitSelected.HasDelegate)
        {
            this.OnHitSelected.InvokeAsync(item);
        }
    }
}
