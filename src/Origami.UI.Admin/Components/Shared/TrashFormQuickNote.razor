@inherits BasicForm<OrigamiQuickNote>

<div class="quick-note @Class">
    <BasicHeaderNotes Entity="this.Entity"></BasicHeaderNotes>
    <BasicHeader Class="mt-3" Entity="this.Entity"></BasicHeader>
    <ul class="inline-list mt-3">
        <li>
            <LanguageWrittenOn Entity="this.Entity" ReadOnly="true"></LanguageWrittenOn>
        </li>
    </ul>
    <ul class="inline-list mt-3">
        <li>
            <MudTextField FullWidth="true"
                          Immediate="true"
                          @bind-Value="@Entity.Note"
                          ReadOnly="true"
                          HelperText="@Text.Lower("Note")"></MudTextField>
        </li>
    </ul>
</div>

