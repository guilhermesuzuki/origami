@inherits BasicFormFull<OrigamiContentComment>
@inject IVideoRepository _video
@inject ISocialProfileRepository _socialProfile
@inject IContentCommentReactionRepository _videoCommentReaction

<div class="trash-form-video-comment @Class">
    @if (this.Entity.New)
    {
        <div class="w-100 text-white bg-secondary text-center">
            @Text.Lower("Select a comment")
        </div>
    }
    else
    {
        var video = this.Super.Videos.ReadFromCache().Id(Entity.ContentId);
        var socialProfile = this.Super.SocialProfiles.ReadFromCache().Id(Entity.SocialProfileId);

        <div class="row">
            <div class="col-12">
                <BasicHeaderNotes Entity="this.Entity"></BasicHeaderNotes>
                <VideoHeaderLite Class="mt-3" Entity="video"></VideoHeaderLite>
                <SocialProfileHeader Class="mt-3 p-3 border shadow-sm" Entity="socialProfile"></SocialProfileHeader>
                <BasicHeader Class="mt-3" Entity="this.Entity"></BasicHeader>
                <ul class="inline-list mt-3">
                    <li>
                        <MudTextField ReadOnly="true"
                                      FullWidth="true"
                                      Immediate="true"
                                      AdornmentIcon="@_pinnedBy?.SocialNetwork.Icon().Value"
                                      Adornment="Adornment.Start"
                                      Value="@_pinnedBy.Name()"
                                      Class="social-profile icon"
                                      HelperText="@Text.Lower("Pinned by")"></MudTextField>
                    </li>
                    <li>
                        <MudTextField ReadOnly="true"
                                      FullWidth="true"
                                      Immediate="true"
                                      AdornmentIcon="@_moderatedBy?.SocialNetwork.Icon().Value"
                                      Adornment="Adornment.Start"
                                      Class="social-profile icon"
                                      Value="@_moderatedBy.Name()"
                                      HelperText="@Text.Lower("Moderated by")"></MudTextField>
                    </li>
                </ul>
                <ul class="inline-list mt-3">
                    <li>
                        <Filler></Filler>
                    </li>
                    <li>
                        <ul class="inline-list w-100">
                            <li>
                                <MudTextField ReadOnly="true"
                                              AdornmentIcon="@Icons.Material.Filled.FactCheck"
                                              Adornment="Adornment.Start"
                                              Value="@Text.Lower(Entity.IsApproved.YesNo())"
                                              HelperText="@Text.Lower("Approved")"></MudTextField>
                            </li>
                            <li>
                                <MudTextField ReadOnly="true"
                                              AdornmentIcon="@Icons.Material.Filled.Block"
                                              Adornment="Adornment.Start"
                                              Value="@Text.Lower(Entity.IsSpam.YesNo())"
                                              HelperText="@Text.Lower("Spam")"></MudTextField>
                            </li>
                            <li>
                                <MudTextField ReadOnly="true"
                                              AdornmentIcon="@Icons.Material.Filled.Delete"
                                              Adornment="Adornment.Start"
                                              Value="@Text.Lower(Entity.IsDeleted.YesNo())"
                                              HelperText="@Text.Lower("Deleted")"></MudTextField>
                            </li>
                        </ul>
                    </li>
                </ul>
            </div>
            <div class="col-12 mt-3">
                <div class="text-center">
                    <div class="w-100 text-white bg-secondary text-center mb-3">
                        @Text.Lower("Reactions")
                    </div>
                    @foreach (var reaction in _videoCommentReaction.Reactions(Entity).GroupBy(x => x.Reaction))
                    {
                        <label class="post-comment-reaction pe-1 me-1 border" style="border-radius: 12px; padding-left: 3px; padding-right: 6px; padding-bottom: 3px;">
                            <span>@reaction.Key</span>
                            <span>@reaction.Count()</span>
                        </label>
                    }
                    <MudDataGrid Class="mt-3" T="OrigamiContentCommentReaction" Items="_videoCommentReaction.Reactions(Entity).OrderByDescending(x => x.DateCreated)">
                        <Columns>
                            <TemplateColumn>
                                <CellTemplate>
                                    <SocialProfileHeaderLite Entity="_socialProfile.ReadFromCache().Id(context.Item.SocialProfileId)"></SocialProfileHeaderLite>
                                    <div class="x-small">
                                        <i class="fa-solid fa-calendar"></i>
                                        @context.Item.DateCreated
                                    </div>
                                </CellTemplate>
                            </TemplateColumn>
                            <TemplateColumn CellClass="text-right">
                                <CellTemplate>
                                    @context.Item.Reaction
                                </CellTemplate>
                            </TemplateColumn>
                        </Columns>
                        <PagerContent>
                            <MudDataGridPager T="OrigamiContentCommentReaction" />
                        </PagerContent>
                    </MudDataGrid>
                </div>
            </div>
        </div>

        @if (Entity.ParentId != null)
        {
            var parent = this.Super.ContentComments.ReadFromCache().Id(Entity.ParentId.Value);
            <div class="mt-3 border p-3 shadow-sm">
                <span class="small fw-bold">
                    <i class="fa-solid fa-reply"></i>
                    @Text.Lower("Answering")
                </span>
                <CommentLite Class="" Entity="parent"></CommentLite>
            </div>
        }

        <div class="border-top border-bottom mt-3 p-3 bg-light bg-gradient post-comment-text" style="margin-left: -1rem; margin-right: -1rem;font-size:x-large;">
            @Entity.Content.Markup()
        </div>
    }

</div>

@code {
    private OrigamiSocialProfile? _pinnedBy
    {
        get => this._socialProfile.ReadFromCache().Id(this.Entity.PinnedById);
    }

    private OrigamiSocialProfile? _moderatedBy
    {
        get => this._socialProfile.ReadFromCache().Id(this.Entity.ModeratedById);
    }
}
