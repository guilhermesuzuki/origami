@inherits Basic
@implements IEntityNull<OrigamiCategory>

@if (Entity != null)
{
    <div class="trash-form-category @Class">
        <BasicHeaderNotes Entity="Entity"></BasicHeaderNotes>
        @if (this.Entity.ParentId != null)
        {
            var parent = this.Super.Categories.ReadFromCache().Id(this.Entity.ParentId.Value);
            <div class="category-parent mt-3">
                <div class="xx-small">@Text.Lower("Parent")</div>
                <CategoryHeaderLite Class="fw-bold shadow-sm border p-2" Entity="parent"></CategoryHeaderLite>
            </div>
        }
        <div class="mt-3 text-center p-3 border">
            <img src="@(this.Entity.Get().Image.Source)" style="width:120px; height: 120px;" />
        </div>
        <BasicHeader Class="mt-3" Entity="Entity"></BasicHeader>
        <ul class="inline-list mt-3">
            <li>
                <MudTextField ReadOnly="true"
                              FullWidth="true"
                              @bind-Value="@Entity.Name"
                              HelperText="@Text.Lower("Name")"></MudTextField>
            </li>
            <li>
                <MudTextField FullWidth="true"
                              ReadOnly="true"
                              Value="@Entity.Slug"
                              HelperText="@Text.Lower("Slug")"></MudTextField>
            </li>
        </ul>
        <MudTextField Class="mt-3"
                      FullWidth="true"
                      ReadOnly="true"
                      @bind-Value="@Entity.Description"
                      HelperText="@Text.Lower("Description")"></MudTextField>

        @if (this.Entity != null)
        {
            var children = this.Super.Categories.ReadFromCache().GetChildren(this.Entity).OrderBy(x => x.Name);
            @if (children.Any() == true)
            {
                <div class="page-parent mt-3">
                    <div class="xx-small">@Text.Lower("Children will be purged too")</div>
                    @foreach (var child in children)
                    {
                        <div class="shadow-sm border p-2 mt-1">
                            <CategoryHeaderLite Entity="child"></CategoryHeaderLite>
                        </div>
                    }
                </div>
            }
        }
    </div>
}

@code {
    [Parameter] public OrigamiCategory? Entity { get; set; }
}
