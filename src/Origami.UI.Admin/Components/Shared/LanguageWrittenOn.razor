@inherits Basic
@implements IEntityNull<ILanguageWrittenOn>

@if (this.Entity != null)
{
    <MudSelect Class="language-written-on"
               FullWidth="true"
               Immediate="true"
               MultiSelection="false"
               InputClass="d-inline-flex align-items-center"
               @bind-Value:get="@Entity.LanguageWrittenOn"
               @bind-Value:set="(language) => this.Entity.LanguageWrittenOn = language"
               ReadOnly="@ReadOnly"
               HelperText="@Text.Lower("Language")">
        @foreach (var language in OrigamiConstants.AllLanguages())
        {
            <MudSelectItem Value="language.Name">
                <Language Entity="language"></Language>
            </MudSelectItem>
        }
    </MudSelect>
}

@code {
    [Parameter] public ILanguageWrittenOn? Entity { get; set; }
    [Parameter] public bool ReadOnly { get; set; } = false;

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        this._setLanguageWrittenOn();
    }

    private void _setLanguageWrittenOn()
    {
        if (this.Entity != null)
        {
            var language = OrigamiConstants.ContentLanguages().FirstOrDefault(x => x.Language.Like(this.Entity.LanguageWrittenOn)).Language;
            if (language.Has() == false) this.Entity.LanguageWrittenOn = this.Entity.LanguageWrittenOn.Language();
        }
    }
}
