@inherits BasicForm<OrigamiVideo>

@if (this.Entity != null)
{
    <div class="trash-form-video @Class">
        <BasicHeaderNotes Entity="Entity"></BasicHeaderNotes>
        <ContentHeaderLite Class="mt-3" Entity="Entity"></ContentHeaderLite>
        <VideoMediaFile Class="mt-3" Entity="Entity"></VideoMediaFile>
        <BasicHeader Class="mt-3" Entity="Entity"></BasicHeader>
        <ul class="inline-list mt-3">
            <li>
                <MudTextField @bind-Value="this.Entity.Title"
                              HelperText="@Text.Lower("Title")"
                              AdornmentIcon="@Icons.Material.Filled.Description"
                              Adornment="Adornment.Start"
                              ReadOnly="true"></MudTextField>
            </li>
            <li>
                <MudTextField ReadOnly="true"
                              AdornmentIcon="@Icons.Material.Filled.Link"
                              Adornment="Adornment.Start"
                              @bind-Value="@Entity.Slug"
                              HelperText="@Text.Lower("Slug")"></MudTextField>
            </li>
        </ul>
        <ul class="inline-list mt-3">
            <li>
                <MudTextField ReadOnly="true"
                              AdornmentIcon="@Icons.Material.Filled.CalendarMonth"
                              Adornment="Adornment.Start"
                              @bind-Value="@Entity.DateReleased"
                              HelperText="@Text.Lower("Date released")"></MudTextField>
            </li>
            <li>
                <MudTextField ReadOnly="true"
                              AdornmentIcon="@Icons.Material.Filled.Comment"
                              Adornment="Adornment.Start"
                              Value="@(Text.Lower(Entity.IsCommentEnabled.YesNo()))"
                              HelperText="@Text.Lower("Are comments enabled?")"></MudTextField>
            </li>
        </ul>
        @if (Entity.Description.Has() == true)
        {
            <div class="border-top border-bottom mt-3 p-3 bg-light bg-gradient" style="margin-left: -1rem; margin-right: -1rem;">
                @Entity.Description
            </div>
        }
        @if (Entity.Content.Has() == true)
        {
            <div class="border-top border-bottom mt-3 p-3 bg-light bg-gradient video-comment-text" style="margin-left: -1rem; margin-right: -1rem;">
                @Entity.Content.Markup()
            </div>
        }
    </div>
}

