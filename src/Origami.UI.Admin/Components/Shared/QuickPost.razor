@inherits BasicForm<OrigamiPost>
@inject IPostRepository _post

<div class="quick-post @Class">
    <ul class="inline-list">
        <li class="w-50">
            <LanguageWrittenOn Entity="this.Entity"></LanguageWrittenOn>
        </li>
        <li class="w-50">
            <MudTextField ReadOnly="true"
            FullWidth="true"
            Immediate="true"
            Value="@Author.Username.ToLower()"
            HelperText="@Text.Lower("Author")"></MudTextField>
        </li>
    </ul>

    <ul class="inline-list">
        <li>
            <MudTextField FullWidth="true"
            Immediate="true"
            @bind-Value="@Entity.Title"
            HelperText="@Text.Lower("Title")"
            Required="true"></MudTextField>
        </li>
    </ul>

    <ul class="inline-list">
        <li>
            <MudTextField FullWidth="true"
            Immediate="true"
            @bind-Value="@Entity.Content"
            HelperText="@Text.Lower("Type Here")"
            Required="true"></MudTextField>
        </li>
    </ul>

    <div class="btn-group w-100 mt-3">
        <button class="btn btn-success" disabled="@DisableTheSaveButton" @onclick="Save">@Text.Upper("Save and Publish")</button>
    </div>
</div>


@code {

    protected override bool DisableTheSaveButton
    {
        get
        {
            if (this.Entity.Title.Has() == false) return true;
            if (this.Entity.Content.Has() == false) return true;
            return false;
        }
    }

    public override void Save()
    {
        try
        {
            var result = new Core.Models.Result<OrigamiPost>(Entity);

            Entity.BlogId = this.UserFacade.BlogId;
            Entity.IsPublished = true;
            Entity.DateCreated = DateTime.UtcNow;
            Entity.DatePublished = DateTime.UtcNow;

            var context = new DataOperationContext<OrigamiPost>(this.UserFacade.User, DateTime.UtcNow, this.Entity);

            using (var transaction = new TransactionScope())
            {
                _post.SmartSave(context, true).Push(result);
                if (result.Ok)
                {
                    transaction.Complete();
                }
            }

            this.CreateEntity().Wait();

            this.UserFacade.Result = result;
        }
        catch (Exception e)
        {
            this.UserFacade.Result = new() { ErrorMessage = e.GetMessage() };
        }
    }
}
