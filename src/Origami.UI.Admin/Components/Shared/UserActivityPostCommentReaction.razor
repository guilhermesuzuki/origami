@inherits Basic
@implements IId
@inject IPostRepository _post
@inject IPostCommentReactionRepository _postCommentReaction
@inject IPostCommentRepository _postComment
@inject IPostRatingRepository _postRating

@if (Id != Guid.Empty)
{
    var reaction = _postCommentReaction.ReadFromCache().Id(Id);
    if (reaction != null)
    {
        var comment = _postComment.ReadFromCache().Id(reaction.CommentId);
        var post = _post.ReadFromCache().Id(comment!.PostId)!;
        <div class="user-activity-post-comment-reaction @Class">
            <label class="fw-bold">@Text.Lower("Reacted {0} To:", reaction.Reaction)</label>
            <PostHeaderLite Entity="post"></PostHeaderLite>
            <CommentLite Class="mt-2 p-2 frame-purple" Entity="comment"></CommentLite>
        </div>
    }
}

@code {
    [Parameter] public override Guid Id { get; set; }
}
