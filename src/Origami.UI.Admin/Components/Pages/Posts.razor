@page "/posts"
@inherits BasicAdminGrid<OrigamiPost>
@implements IFilter
@inject IPostCategoryRepository _postCategory
@inject IBlogRepository _blogs
@inject IPostRepository _posts
@inject IPostCommentRepository _postComment
@inject IPostViewRepository _postView

<style>
    .post-header-lite .language { display: none !important; }
    .categories .id { display:none !important; }
</style>
<Root Access="this.CanAccess()">
    <HeaderTemplate>
        <div class="p-3 border-bottom">
            <div class="row">
                <div class="d-inline-flex align-items-center col-12 col-xxl-8">
                    <ul class="inline-list w-100">
                        <li style="width:80%;">
                            <i class="fa-solid fa-file-lines pe-1"></i>
                            <span class="me-3">@Text.Get("Posts", Text.Styles.Uppercase)</span>
                            <div class="btn-group pe-1">
                                <button class="btn btn-light text-danger border border-danger" disabled="@this.DisableTheDeleteButton" @onclick="this.DeleteSelectedEntities">
                                    <i class="fa-solid fa-trash-can"></i>
                                </button>
                            </div>
                            <div class="btn-group">
                                <button class="btn btn-success text-white" title="@Text.Lower("Publish post(s)")" disabled="@this.DisableTheDeleteButton" @onclick="this.PublishSelectedEntities">
                                    <i class="fa-solid fa-file-arrow-up"></i>
                                </button>
                                <button class="btn btn-warning text-white" title="@Text.Lower("Unpublish post(s)")" disabled="@this.DisableTheDeleteButton" @onclick="this.UnpublishSelectedEntities">
                                    <i class="fa-solid fa-file-arrow-down"></i>
                                </button>
                            </div>
                        </li>
                        <li style="width:20%;">
                            <MudSelect T="string" HelperText="@Text.Lower("Filter")" @bind-Value:get="Filter" @bind-Value:set="(filter) => SetFilterAndRefreshUI(filter)">
                                <MudSelectItem T="string" Value="@(new string("all"))">@Text.Original("All")</MudSelectItem>
                                <MudSelectItem T="string" Value="@(new string("published"))">@Text.Original("Published")</MudSelectItem>
                                <MudSelectItem T="string" Value="@(new string("drafts"))">@Text.Original("Drafts")</MudSelectItem>
                            </MudSelect>
                        </li>
                    </ul>
                </div>
                <div class="col-12 col-xxl-4">
                    <BlogSelect></BlogSelect>
                </div>
            </div>
        </div>
        <div class="p-3 border-bottom">
            <div class="row">
                <div class="col-12">
                    <SearchLite T="OrigamiPost" OnHitSelected="this.OnSearchResultSelected"></SearchLite>
                </div>
            </div>
        </div>
    </HeaderTemplate>
    <ContentTemplate>
        <div class="p-3">
            <div class="row">
                <div class="datagrid-options col-12 text-right mb-1">
                    <DataGridOptions Deleted="this.IncludeDeletedEntitiesInDataGrid" DeletedChanged="this.OnIncludeDeletedEntitiesChanged"></DataGridOptions>
                </div>
                <div class="posts col-12">
                    <MudDataGrid @ref="DataGrid" T="OrigamiPost" ServerData="GetEntities" Filterable="false" SortMode="SortMode.None" Class="border selectable" SelectedItems="this.SelectedEntities" MultiSelection="true" SelectedItemsChanged="this.SelectedEntitiesChanged"
                                 RowClassFunc="this.RowClassFunc" Bordered="true" SelectOnRowClick="false">
                        <Columns>
                            <SelectColumn T="OrigamiPost"></SelectColumn>
                            <TemplateColumn Title="@Text.Upper("Title")">
                                <CellTemplate>
                                    <div class="cursor-pointer" @onclick="() => OnEdit(context.Item)">
                                        <PostRating Class="" Entity="context.Item" ShowLanguage="false"></PostRating><br />
                                        <PostHeaderLite2 Entity="context.Item"></PostHeaderLite2>
                                    </div>
                                </CellTemplate>
                            </TemplateColumn>
                            <TemplateColumn Title="@Text.Upper("Header")" CellClass="col-2">
                                <CellTemplate>
                                    <div class="w-100" style="height:150px; background-image: url(@context.Item.Get().HeaderImage); background-size: cover; background-position: center;"></div>
                                    <div class="mt-1 p-1 border">
                                        <ul class="inline-list text-center">
                                            <li>
                                                <i class="fa-solid fa-eye"></i>
                                                @_postView.GetViews(context.Item)
                                            </li>
                                            <li>
                                                <i class="fa-solid fa-comment"></i>
                                                @_postComment.GetComments(context.Item)
                                            </li>
                                        </ul>
                                    </div>
                                </CellTemplate>
                            </TemplateColumn>
                            <TemplateColumn Title="@Text.Upper("Categories")" Sortable="false" Filterable="false" CellClass="col-2 categories">
                                <CellTemplate>
                                    @foreach (var category in this.Super.GetCategories(context.Item))
                                    {
                                        <CategoryHeaderLite Class="mb-1 p-2 shadow-sm border" Entity="category"></CategoryHeaderLite>
                                    }
                                </CellTemplate>
                            </TemplateColumn>
                            <TemplateColumn Title="@Text.Upper("Published")" Sortable="false" Filterable="false" CellClass="col-1 text-center">
                                <CellTemplate>
                                    @if (context.Item.IsPublished)
                                    {
                                        <i class="fa-solid fa-thumbs-up"></i>
                                        @if (context.Item.DatePublished != null)
                                        {
                                            <div class="small">@context.Item.DatePublished</div>
                                        }
                                    }
                                </CellTemplate>
                            </TemplateColumn>
                            <TemplateColumn Title="@Text.Upper("Date")" Sortable="false" Filterable="false" CellClass="col-1 text-center">
                                <CellTemplate>
                                    <i class="fa-solid fa-calendar"></i>
                                    <div class="small">@context.Item.GetDate()</div>
                                </CellTemplate>
                            </TemplateColumn>
                        </Columns>
                        <PagerContent>
                            <MudDataGridPager T="OrigamiPost" />
                        </PagerContent>
                        <NoRecordsContent>
                            <NoEntriesWereFound></NoEntriesWereFound>
                        </NoRecordsContent>
                    </MudDataGrid>
                </div>
                <div class="posts-form col-12 mt-3">
                    <PostForm Class="p-3 shadow-sm border" Entity="this.SelectedEntity" Saved="this.EntitySaved" Cancelled="this.EntityCancelled" Created="this.EntityCreated"></PostForm>
                </div>
            </div>
        </div>
    </ContentTemplate>
</Root>
@code {

    protected override string DefaultOrdering => $"{nameof(OrigamiPost.Title)}";

    protected virtual Result<OrigamiPost> PublishEntity(OrigamiPost entity)
    {
        var context = new DataOperationContext<OrigamiPost>(this.UserFacade.User, DateTime.UtcNow, entity);
        return _posts.SmartPublish(context, true);
    }

    protected virtual Result<OrigamiPost> UnpublishEntity(OrigamiPost entity)
    {
        var context = new DataOperationContext<OrigamiPost>(this.UserFacade.User, DateTime.UtcNow, entity);
        return _posts.SmartUnpublish(context, true);
    }

    protected async Task PublishSelectedEntities()
    {
        await ExecuteWithSelectedEntities(
            async () =>
            {
                return await DialogService.ShowMessageBoxAsync(
                    Text.Upper("Publish {0} item(s)", SelectedEntities.Count),
                    Text.Original("Are you sure?"),
                    yesText: Text.Lower("Yes"),
                    noText: Text.Lower("No"));
            },
            this.PublishEntity
        );
    }

    protected async Task UnpublishSelectedEntities()
    {
        await ExecuteWithSelectedEntities(
            async () =>
            {
                return await DialogService.ShowMessageBoxAsync(
                    Text.Upper("Unpublish {0} item(s)", SelectedEntities.Count),
                    Text.Original("Are you sure?"),
                    yesText: Text.Lower("Yes"),
                    noText: Text.Lower("No"));
            },
            this.UnpublishEntity
        );
    }

    protected override void OnInitialized()
    {
        base.OnInitialized();
        var filter = this.NavigationManager!.Uri.QueryString("filter");
        this.Filter = filter.Has() ? filter : this.Filter;
    }
}
