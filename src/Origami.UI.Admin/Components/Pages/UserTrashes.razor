@page "/user/trashes"
@inherits BasicAdminGrid<OrigamiUserTrash>

<style>
    .trashes .id .is-deleted { display: none; }
    .deleted { opacity: 1 !important; background: initial !important; }
</style>
<Root Access="this.CanAccess()">
    <HeaderTemplate>
        <div class="p-3 border-bottom">
            <div class="row">
                <div class="d-inline-flex align-items-center col-12 col-xxl-8">
                    <i class="fa-solid fa-trash-can pe-1"></i>
                    <span class="me-3">@Text.Get("User trashes", Text.Styles.Uppercase)</span>
                    <div class="btn-group">
                        <button class="btn btn-danger text-white" disabled="@this.DisableThePurgeButton" @onclick="this.PurgeSelectedEntities">
                            <i class="fa-solid fa-database"></i>
                            <i class="fa fa-ban" style="position: absolute; right: 8px; bottom: 8px; font-size: 8px;"></i>
                        </button>
                        <button class="btn btn-success text-white" disabled="@this.DisableTheRestoreButton" @onclick="this.RestoreSelectedEntities">
                            <i class="fa-solid fa-trash-can"></i>
                            <i class="fa fa-ban" style="position: absolute; right: 8px; bottom: 8px; font-size: 8px;"></i>
                        </button>
                    </div>
                </div>
                <div class="col-12 col-xxl-4">
                    <BlogSelect IncludeDeletedBlogs="true"></BlogSelect>
                </div>
            </div>
        </div>
        <div class="p-3 border-bottom">
            <div class="row">
                <div class="col-12">
                    <SearchUserTrashLite OnHitSelected="this.OnSearchResultSelected"></SearchUserTrashLite>
                </div>
            </div>
        </div>
    </HeaderTemplate>
    <ContentTemplate>
        <div class="p-3">
            <div class="row">
                <div class="trashes col-12 col-xxl-8">
                    <MudDataGrid @ref="DataGrid" T="OrigamiUserTrash" ServerData="GetEntities" Filterable="false" SortMode="SortMode.None" Class="border selectable" SelectedItems="this.SelectedEntities" MultiSelection="true" SelectedItemsChanged="this.SelectedEntitiesChanged"
                                 RowClassFunc="RowClassFunc" Bordered="true" SelectOnRowClick="false">
                        <Columns>
                            <SelectColumn T="OrigamiUserTrash"></SelectColumn>
                            <TemplateColumn>
                                <CellTemplate>
                                    <div class="cursor-pointer" @onclick="() => OnEdit(context.Item)">
                                        @if (context.Item.Type.Like("Blog") == true)
                                        {
                                            var blog = this.Super.Blogs.ReadFromCache().Id(context.Item.Id);
                                            <BlogHeaderLite Entity="blog"></BlogHeaderLite>
                                        }
                                        else if (context.Item.Type.Like("Page") == true)
                                        {
                                            var page = this.Super.Contents.ReadFromCache().OfType<OrigamiPage>().Id(context.Item.Id);
                                            <PageHeaderLite2 Entity="page"></PageHeaderLite2>
                                        }
                                        else if (context.Item.Type.Like("Post") == true)
                                        {
                                            var post = this.Super.Contents.ReadFromCache().OfType<OrigamiPost>().Id(context.Item.Id);
                                            <PostHeaderLite2 Entity="post"></PostHeaderLite2>
                                        }
                                        else if (context.Item.Type.Like("Video") == true)
                                        {
                                            var video = this.Super.Contents.ReadFromCache().OfType<OrigamiVideo>().Id(context.Item.Id);
                                            <VideoHeaderLite2 Entity="video"></VideoHeaderLite2>
                                        }
                                        else if (context.Item.Type.Like("ContentComment") == true)
                                        {
                                            var comment = this.Super.ContentComments.ReadFromCache().Id(context.Item.Id);
                                            <CommentLite Entity="comment" ShowParentHeader="true"></CommentLite>
                                        }
                                        else if (context.Item.Type.Like("Category") == true)
                                        {
                                            var category = this.Super.Categories.ReadFromCache().Id(context.Item.Id);
                                            <CategoryHeaderLite Entity="category"></CategoryHeaderLite>
                                        }
                                        else if (context.Item.Type.Like("User") == true)
                                        {
                                            var user = this.Super.Users.ReadFromCache().Id(context.Item.Id);
                                            <UserHeaderLite Entity="user"></UserHeaderLite>
                                        }
                                        else if (context.Item.Type.Like("Role") == true)
                                        {
                                            var role = this.Super.Roles.ReadFromCache().Id(context.Item.Id);
                                            <RoleHeaderLite Entity="role"></RoleHeaderLite>
                                        }
                                        else if (context.Item.Type.Like("QuickNote") == true)
                                        {
                                            var note = this.Super.QuickNotes.ReadFromCache().Id(context.Item.Id);
                                            <QuickNoteHeaderLite Entity="note"></QuickNoteHeaderLite>
                                        }
                                        else if (context.Item.Type.Like("SpecialPage") == true)
                                        {
                                            var page = this.Super.GetSpecialPages().Id(context.Item.Id);
                                            <SpecialPageHeaderLite2 Entity="page"></SpecialPageHeaderLite2>
                                        }
                                        else if (context.Item.Type.Like("SpecialMessage") == true)
                                        {
                                            var message = this.Super.GetSpecialMessages().Id(context.Item.Id);
                                            <SpecialMessageHeaderLite Entity="message"></SpecialMessageHeaderLite>
                                        }
                                    </div>
                                </CellTemplate>
                            </TemplateColumn>
                            <TemplateColumn Title="@Text.Upper("Type")" Sortable="false" Filterable="false" CellClass="col-1 text-center">
                                <CellTemplate>
                                    <div class="small">
                                        @if (context.Item.Type.Like("PostComment") == true)
                                        {
                                            <span>@Text.Original("Comment in post")</span>
                                        }
                                        else if (context.Item.Type.Like("VideoComment") == true)
                                        {
                                            <span>@Text.Original("Comment in video")</span>
                                        }
                                        else if (context.Item.Type.Like("QuickNote") == true)
                                        {
                                            <span>@Text.Original("Quick note")</span>
                                        }
                                        else if (context.Item.Type.Like("SpecialPage") == true)
                                        {
                                            <span>@Text.Original("Special page")</span>
                                        }
                                        else if (context.Item.Type.Like("SpecialMessage") == true)
                                        {
                                            <span>@Text.Original("Special message")</span>
                                        }
                                        else
                                        {
                                            <span>@context.Item.Type</span>
                                        }
                                    </div>
                                </CellTemplate>
                            </TemplateColumn>
                            <TemplateColumn Title="@Text.Upper("Date")" Sortable="false" Filterable="false" CellClass="col-1 text-center">
                                <CellTemplate>
                                    <i class="fa-solid fa-calendar"></i>
                                    <div class="small">@context.Item.GetDate()</div>
                                </CellTemplate>
                            </TemplateColumn>
                        </Columns>
                        <PagerContent>
                            <MudDataGridPager T="OrigamiUserTrash" />
                        </PagerContent>
                        <NoRecordsContent>
                            <NoEntriesWereFound></NoEntriesWereFound>
                        </NoRecordsContent>
                    </MudDataGrid>
                </div>
                <div class="trashes-form col-12 col-xxl-4">
                    <UserTrashForm Class="p-3 shadow-sm border position-sticky" Entity="this.SelectedEntity" Saved="this.EntitySaved" Cancelled="this.EntityCancelled" Created="this.EntityCreated"></UserTrashForm>
                </div>
            </div>
        </div>
    </ContentTemplate>
</Root>
@code {

    protected override string DefaultOrdering => $"{nameof(OrigamiUserTrash.BlogId)},{nameof(OrigamiUserTrash.Type)},{nameof(OrigamiUserTrash.Name)},{nameof(OrigamiUserTrash.Title)}";

    /// <summary>
    /// Retrieves the deleted items
    /// </summary>
    /// <returns></returns>
    protected override IEnumerable<OrigamiUserTrash> GetItems()
    {
        using var db = this.DbContextFactory.CreateDbContext();

        var query = from trash in db.Set<OrigamiUserTrash>().AsNoTracking()
                    where new Guid[2] { Guid.Empty, this.UserFacade.BlogId }.Contains(trash.BlogId)
                    select trash;

        return query.ToList();
    }
}
