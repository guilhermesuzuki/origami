@page "/password/reset/{Key}"
@inherits BasicAdmin
@layout Layout.CleanLayout

@if (Key.Has() == true)
{
    var reset = this._getReset();
    if (reset != null)
    {
        var user = this._getUser();
        <div class="password-reset-wrapper mt-3">
            <ul class="inline-list text-center border bg-light p-2">
                <li>
                    <UserHeaderInline Entity="user" Class=""></UserHeaderInline>
                </li>
            </ul>
            <ul class="inline-list mt-3">
                <li>
                    <MudTextField FullWidth="true" T="string" Immediate="true" HelperText="@Text.Lower("New password")" InputType="InputType.Password" @bind-Value="_newPassword1"></MudTextField>
                </li>
                <li>
                    <MudTextField FullWidth="true" T="string" Immediate="true" HelperText="@Text.Lower("Confirm password")" InputType="InputType.Password" @bind-Value="_newPassword2"></MudTextField>
                </li>
            </ul>
            <div class="btn-group mt-3 w-100">
                <button class="btn btn-success text-white" disabled="@_disableLogin" @onclick="_reset">
                    <i class="fa-solid fa-floppy-disk"></i>
                    @Text.Lower("Save")
                </button>
                <button class="btn btn-warning text-white" @onclick="_clear">
                    <i class="fa-solid fa-broom"></i>
                    @Text.Lower("Clear")
                </button>
            </div>
        </div>
    }
    else
    {
        <div class="text-center fs-3">
            <span>@Text.Lower("Oops, this key is not valid or it was already used to reset your password")</span>
        </div>
    }
}

@code {
    private string _newPassword1 = string.Empty;
    private string _newPassword2 = string.Empty;

    [Parameter] public string Key { get; set; } = string.Empty;

    private bool _disableLogin
    {
        get
        {
            if (_newPassword1.Has() == false) return true;
            if (_newPassword2.Has() == false) return true;
            return false;
        }
    }

    private void _clear()
    {
        _newPassword1 = string.Empty;
        _newPassword2 = string.Empty;
    }

    private void _reset()
    {
        var u = this._getUser();
        if (u != null)
        {
            using (var transaction = new TransactionScope())
            {
                var ctx = u.GetContext();
                var hub = this.Super.Users.ResetPassword(ctx, this.Key, _newPassword1, _newPassword2, true);
                if (hub.Ok == false)
                {
                    this.UserFacade.Result = hub;
                    return;
                }
                transaction.Complete();
            }
            this.UserFacade.Result = new();
            this.NavigationManager.NavigateTo("/login");
        }
        // send email to user saying password has been modified
    }

    private OrigamiUserPasswordReset? _getReset()
    {
        using var db = this.DbContextFactory.CreateDbContext();
        return db.Set<OrigamiUserPasswordReset>().AsNoTracking().NonDeleted().FirstOrDefault(x => x.Key == Key);
    }

    private OrigamiUser? _getUser()
    {
        var reset = _getReset();
        if (reset == null) return null;

        using var db = this.DbContextFactory.CreateDbContext();
        return db.Set<OrigamiUser>().AsNoTracking().FirstOrDefault(x => x.Id == reset.UserId);
    }
}
