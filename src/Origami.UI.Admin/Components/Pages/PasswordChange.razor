@page "/password/change"
@using System.Security.Claims
@inherits BasicPage
@inject AuthenticationStateProvider myAuthenticationStateProvider
@inject IUserRepository userRepository

<div class="header p-3 border-bottom">
    <div class="row">
        <div class="d-inline-flex align-items-center col-12 col-xxl-8">
            <i class="fa-solid fa-key pe-1"></i>
            <span class="me-3">@Text.Upper("Change password")</span>
        </div>
        <div class="col-12 col-xxl-4">
            <BlogSelect Disabled="true" Style="visibility: hidden;"></BlogSelect>
        </div>
    </div>
</div>

<div class="p-3">
    <div class="row">
        <div class="col-12 col-xxl-4">
            <div class="p-3 border">
                <MudTextField FullWidth="true"
                              Immediate="true"
                              T="string"
                              HelperText="@Text.Lower("Current password")"
                              InputType="InputType.Password"
                              @bind-Value="_currentPassword"
                              AdornmentIcon="@Icons.Material.Filled.Password"
                              Adornment="Adornment.Start"></MudTextField>
                <MudTextField FullWidth="true"
                              Immediate="true"
                              T="string"
                              HelperText="@Text.Lower("New password")"
                              InputType="InputType.Password"
                              @bind-Value="_newPassword1"
                              AdornmentIcon="@Icons.Material.Filled.Password"
                              Adornment="Adornment.Start"></MudTextField>
                <MudTextField FullWidth="true"
                              Immediate="true"
                              T="string"
                              HelperText="@Text.Lower("Repeat new password")"
                              InputType="InputType.Password"
                              @bind-Value="_newPassword2"
                              AdornmentIcon="@Icons.Material.Filled.Password"
                              Adornment="Adornment.Start"></MudTextField>
                <div class="btn-group mt-3 w-100">
                    <button class="btn btn-success w-50" disabled="@_disableSavingPassword" @onclick="_savePassword">
                        <i class="fa-solid fa-floppy-disk"></i>
                        @Text.Lower("Save password")
                    </button>
                    <button class="btn btn-warning w-50 text-white" @onclick="_clear">
                        <i class="fa-solid fa-broom"></i>
                        @Text.Lower("Clear")
                    </button>
                </div>
                <div class="buttons btn-group mt-3 w-100">
                    <button class="btn btn-danger text-white fw-bold" @onclick="this.ForgotPassword">
                        <i class="fa-solid fa-user-lock"></i>
                        @Text.Lower("Forgot password")
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
@if (_resetPassword.Has() == true)
{
    <div class="position-absolute popup-container">
        <div class="border shadow-lg position-relative">
            <div class="fs-1 text-center p-3">
                <span>@Text.Original("Your temporary password: {0}", _resetPassword)</span>
            </div>
            <ul class="inline-list w-100 border bg-white" style="bottom:0; z-index: 50;">
                <li></li>
                <li class="text-right">
                    <div class="btn-group p-3">
                        <button class="btn btn-secondary" @onclick="() => this._resetPassword = string.Empty">
                            <i class="fa-solid fa-circle-xmark"></i>
                            @Text.Lower("Close window")
                        </button>
                    </div>
                </li>
            </ul>
        </div>
    </div>
}
@code {
    private string _currentPassword = string.Empty;
    private string _newPassword1 = string.Empty;
    private string _newPassword2 = string.Empty;
    private string _resetPassword = string.Empty;

    private bool _disableSavingPassword
    {
        get
        {
            if (_currentPassword.Has() == false) return true;
            if (_newPassword1.Has() == false) return true;
            if (_newPassword2.Has() == false) return true;

            return false;
        }
    }

    private void _clear()
    {
        _currentPassword = string.Empty;
        _newPassword1 = string.Empty;
        _newPassword2 = string.Empty;
    }

    private async Task _savePassword()
    {
        var result = new Result<OrigamiUser>();

        using (var transaction = new TransactionScope())
        {
            var context = new DataOperationContext<OrigamiUser>(this.UserFacade.User, this.UserFacade.User);
            result = this.userRepository.ChangePassword(context, _currentPassword, _newPassword1, _newPassword2);
            try
            {
                if (result.Ok)
                {
                    transaction.Complete();

                    if (result.Entity != null)
                    {
                        this.userRepository.UpdateCache(result.Entity);
                    }
                }
            }
            catch (Exception ex)
            {
                result.Error = ex.GetMessage();
            }
            finally
            {
                this.UserFacade.Result = result;
            }
        }

        if (result.Ok)
        {
            await this.JSRuntime.InvokeVoidAsync("$.removeCookie", this.Configuration.GetUserCookieKey(), new { path = "/" });
            this.NavigationManager!.Refresh(true);
        }
    }

    public void ForgotPassword()
    {
        using var transaction = new TransactionScope();
        var ctx = this.UserFacade.User.GetContext(this.UserFacade.User);
        var hub = this.Super.Users.ForgotOwnPassword(ctx, true);
        if (hub.Ok == true && hub.Entity.Has() == true)
        {
            transaction.Complete();
            this._resetPassword = hub.Entity;
        }
        this.UserFacade.Result = hub;
    }
}
