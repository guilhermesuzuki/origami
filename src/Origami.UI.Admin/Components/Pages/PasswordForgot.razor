@page "/password/forgot"
@inherits BasicPage
@layout CleanLayout

<div class="forgot-password-wrapper">
    <ul class="inline-list mt-3">
        <li>
            <MudTextField FullWidth="true" T="string" Immediate="true" HelperText="@Text.Lower("E-mail")" @bind-Value="_email"></MudTextField>
        </li>
    </ul>
    <div class="btn-group mt-3 w-100">
        <button class="btn btn-success text-white" disabled="@_disableLogin" @onclick="_forgotPassword">
            <i class="fa-solid fa-floppy-disk"></i>
            @Text.Lower("Save")
        </button>
        <button class="btn btn-warning text-white" @onclick="() => { this._email = string.Empty; }">
            <i class="fa-solid fa-broom"></i>
            @Text.Lower("Clear")
        </button>
    </div>
</div>

@code {
    private string _email = string.Empty;

    private bool _disableLogin
    {
        get
        {
            if (_email.Has() == false) return true;
            if (_email.Email() == false) return true;
            return false;
        }
    }

    private async Task _forgotPassword()
    {
        using var db = await this.DbContextFactory.CreateDbContextAsync();

        var query = from x in db.Set<OrigamiUser>().AsNoTracking().NonDeleted()
                    where x.Email.Equals(_email.Trim())
                    select x;

        var user = query.FirstOrDefault();
        if (user != null)
        {
            var ctx = user.GetContext();
            var innerHub = this.Super.Users.ResetPassword(ctx, true);
            if (innerHub.Ok == true)
            {
                var client = this.GetHttpClient();
                var response = await client.GetAsync($"/email/password/reset/{innerHub.Entity}");
                if (response.IsSuccessStatusCode == true)
                {
                    //reads the response content
                    var html = await response.Content.ReadAsStringAsync();
                    //send the email
                    this.UserFacade.Result = this.Super.Emails.Send(Text.Original("Password reset link"), new() { HtmlBody = html }, [user.Email]);
                }
            }
        }

        var hub = new Core.Models.Result()
        {
            Info = Text.Original("If the e-mail address you entered is correct, you will receive an e-mail with instructions on how to change your password")
        };

        this.UserFacade.Result = hub;
    }
}
