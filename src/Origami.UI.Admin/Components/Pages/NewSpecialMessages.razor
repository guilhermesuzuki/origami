@page "/n/specialmessages"
@inherits BasicAdminGridContent2<OrigamiSpecialMessage, HubContentSpecialMessage>

<Root Access="this.CanAccess()">
    <HeaderTemplate>
        <div class="p-3 border-bottom">
            <div class="row">
                <div class="d-inline-flex align-items-center col-12 col-xxl-8">
                    <ul class="inline-list w-100">
                        <li style="width:80%;">
                            <i class="fa-solid fa-file-lines pe-1"></i>
                            <span class="me-3">@Text.Get("Special messages", Text.Styles.Uppercase)</span>
                            <div class="btn-group pe-1">
                                <button class="btn btn-light text-danger border border-danger" disabled="@this.DisableTheDeleteButton" @onclick="this.DeleteSelectedEntities">
                                    <i class="fa-solid fa-trash-can"></i>
                                </button>
                            </div>
                            <div class="btn-group me-1">
                                <button class="btn btn-success text-white" title="@Text.Lower("Publish message(s)")" disabled="@this.DisableTheDeleteButton" @onclick="this.PublishSelectedEntities">
                                    <i class="fa-solid fa-file-arrow-up"></i>
                                </button>
                                <button class="btn btn-warning text-white" title="@Text.Lower("Unpublish message(s)")" disabled="@this.DisableTheDeleteButton" @onclick="this.UnpublishSelectedEntities">
                                    <i class="fa-solid fa-file-arrow-down"></i>
                                </button>
                            </div>
                            <div class="btn-group me-1">
                                <button class="btn btn-info text-white fw-bold" @onclick="this.New">
                                    <i class="fa-solid fa-square-plus"></i>
                                    @Text.Lower("New")
                                </button>
                            </div>
                        </li>
                        <li style="width:20%;">
                            <MudSelect T="string" HelperText="@Text.Lower("Filter")" @bind-Value:get="Filter" @bind-Value:set="SetFilterAndRefreshUI">
                                <MudSelectItem T="string" Value="@(new string("all"))">@Text.Original("All")</MudSelectItem>
                                <MudSelectItem T="string" Value="@(new string("published"))">@Text.Original("Published")</MudSelectItem>
                                <MudSelectItem T="string" Value="@(new string("drafts"))">@Text.Original("Drafts")</MudSelectItem>
                            </MudSelect>
                        </li>
                    </ul>
                </div>
                <div class="col-12 col-xxl-4">
                    <BlogSelect></BlogSelect>
                </div>
            </div>
        </div>
    </HeaderTemplate>
    <ContentTemplate>
        <div class="p-3">
            <div class="row">
                <div class="datagrid-options col-12 text-right mb-1">
                    <DataGridOptions Deleted="this.IncludeDeletedEntitiesInDataGrid" DeletedChanged="this.OnIncludeDeletedEntitiesChanged"></DataGridOptions>
                </div>
                <div class="posts col-12">
                    <MudDataGrid @ref="DataGrid" T="HubContentSpecialMessage" ServerData="GetEntities" Filterable="false" SortMode="SortMode.None" Class="border selectable" SelectedItems="this.SelectedEntities" MultiSelection="true" SelectedItemsChanged="this.SelectedEntitiesChanged"
                                 Bordered="true" SelectOnRowClick="false" RowClassFunc="this.RowClassFunc">
                        <Columns>
                            <SelectColumn T="HubContentSpecialMessage"></SelectColumn>
                            <TemplateColumn Title="@Text.Upper("Title")">
                                <CellTemplate>
                                    <div class="cursor-pointer" @onclick="() => OnEdit(context.Item)">
                                        <ContentHeaderInline Entity="context.Item.Entity"></ContentHeaderInline>
                                    </div>
                                </CellTemplate>
                            </TemplateColumn>
                            <TemplateColumn Title="@Text.Upper("Header")">
                                <CellTemplate>
                                    <SpecialMessageHeader Entity="context.Item.Entity"></SpecialMessageHeader>
                                </CellTemplate>
                            </TemplateColumn>
                            <TemplateColumn Title="@Text.Upper("Published")" Sortable="false" Filterable="false" CellClass="col-1 text-center">
                                <CellTemplate>
                                    @if (context.Item.Entity?.IsPublished ?? false)
                                    {
                                        <i class="fa-solid fa-thumbs-up"></i>
                                        <div class="small">@context.Item.Entity.DatePublished</div>
                                    }
                                </CellTemplate>
                            </TemplateColumn>
                            <TemplateColumn Title="@Text.Upper("Date")" Sortable="false" Filterable="false" CellClass="col-1 text-center">
                                <CellTemplate>
                                    <i class="fa-solid fa-calendar"></i>
                                    <div class="small">@context.Item.Entity?.GetDate()</div>
                                </CellTemplate>
                            </TemplateColumn>
                            <TemplateColumn Title="@Text.Upper("Actions")" Sortable="false" Filterable="false" CellClass="col-1 text-center">
                                <CellTemplate>
                                    <div class="btn-group-vertical w-100">
                                        <button class="btn btn-light" title="@Text.Original("Edit")" @onclick="() => OnEdit(context.Item)">
                                            <i class="fa-solid fa-pen-to-square"></i>
                                        </button>
                                    </div>
                                </CellTemplate>
                            </TemplateColumn>
                        </Columns>
                        <PagerContent>
                            <MudDataGridPager T="HubContentSpecialMessage" />
                        </PagerContent>
                        <NoRecordsContent>
                            <NoEntriesWereFound></NoEntriesWereFound>
                        </NoRecordsContent>
                    </MudDataGrid>
                </div>
            </div>
        </div>
        <MudDialog @bind-Visible="IsSelectedEntityNotNull" Options="this.DialogOptions">
            <TitleContent>
                @Text.Upper("Editor")
            </TitleContent>
            <DialogContent>
                <div class="position-relative pt-3 pb-3" style="width: 1700px; height: 1000px; max-width:100%; max-height: 100%;">
                    <NewSpecialMessageForm Entity="this.SelectedEntity" Class="w-100 h-100" Saved="this.EntitySaved" Cancelled="this.EntityCancelled" Created="this.EntityCreated"></NewSpecialMessageForm>
                </div>
            </DialogContent>
        </MudDialog>
    </ContentTemplate>
</Root>
@code {
    protected override string DefaultOrdering => $"{nameof(OrigamiSpecialMessage.Title)}";
}
