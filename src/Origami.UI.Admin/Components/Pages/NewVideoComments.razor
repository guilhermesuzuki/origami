@page "/n/videos/comments"
@inherits BasicAdminGrid2<OrigamiContentComment>

<Root Access="this.CanAccess()">
    <HeaderTemplate>
        <div class="p-3 border-bottom">
            <div class="row">
                <div class="d-inline-flex align-items-center col-12 col-xxl-8">
                    <i class="fa-solid fa-comment pe-1"></i>
                    <span class="me-3">@Text.Upper("Videos comments")</span>
                    <button class="btn btn-light text-danger border border-danger" disabled="@this.DisableTheDeleteButton" @onclick="this.DeleteSelectedEntities">
                        <i class="fa-solid fa-trash-can"></i>
                    </button>
                </div>
                <div class="col-12 col-xxl-4">
                    <BlogSelect></BlogSelect>
                </div>
            </div>
        </div>
    </HeaderTemplate>
    <ContentTemplate>
        <div class="p-3">
            <div class="row">
                <div class="datagrid-options col-12 text-right mb-1">
                    <DataGridOptions Deleted="this.IncludeDeletedEntitiesInDataGrid" DeletedChanged="this.OnIncludeDeletedEntitiesChanged"></DataGridOptions>
                </div>
                <div class="videos-comments col-12">
                    <MudDataGrid @ref="DataGrid" T="OrigamiContentComment" ServerData="GetEntities" Filterable="false" SortMode="SortMode.None" Class="border selectable" SelectedItems="this.SelectedEntities" MultiSelection="true" SelectedItemsChanged="this.SelectedEntitiesChanged"
                                 RowClassFunc="this.RowClassFunc" Bordered="true" SelectOnRowClick="false">
                        <Columns>
                            <SelectColumn T="OrigamiContentComment"></SelectColumn>
                            <TemplateColumn Title="@Text.Upper("Comment")">
                                <CellTemplate>
                                    <div class="cursor-pointer" @onclick="() => OnEdit(context.Item)">
                                        @if (context.Item.ParentId != null)
                                        {
                                            var parent = this.Super.ContentComments.ReadFromCache().Id(context.Item.ParentId.Value);
                                            @if (parent != null)
                                            {
                                                <CommentLite Class="mb-3 p-3 border bg-primary-subtle shadow-sm" Entity="parent"></CommentLite>
                                            }
                                        }
                                        <div class="ps-3" style="border-left: gray 2px solid;">
                                            <CommentLite Class="p-3 border bg-secondary-subtle shadow-sm" Entity="context.Item"></CommentLite>
                                        </div>
                                    </div>
                                </CellTemplate>
                            </TemplateColumn>
                            <TemplateColumn Title="@Text.Upper("Video")" HeaderClass="col-3">
                                <CellTemplate>
                                    @if (context.Item != null)
                                    {
                                        var video = this.Super.Contents.ReadFromCache().Id(context.Item.ContentId);
                                        <ContentHeaderInline Entity="video"></ContentHeaderInline>
                                    }
                                </CellTemplate>
                            </TemplateColumn>
                        </Columns>
                        <PagerContent>
                            <MudDataGridPager T="OrigamiContentComment" />
                        </PagerContent>
                        <NoRecordsContent>
                            <NoEntriesWereFound></NoEntriesWereFound>
                        </NoRecordsContent>
                    </MudDataGrid>
                </div>
            </div>
        </div>
        <MudDialog @bind-Visible="IsSelectedEntityNotNull" Options="this.DialogOptions">
            <TitleContent>
                @Text.Upper("Editor")
            </TitleContent>
            <DialogContent>
                <div class="position-relative pt-3 pb-3 dialog-content">
                    <NewCommentForm Class="" Entity="this.SelectedEntity" Saved="this.EntitySaved" Cancelled="this.EntityCancelled"></NewCommentForm>
                </div>
            </DialogContent>
        </MudDialog>
    </ContentTemplate>
</Root>
@code
{
    protected override string DefaultOrdering => $"{nameof(OrigamiContentComment.DateCreated)} DESC";

    protected override IEnumerable<OrigamiContentComment> GetEntities()
    {
        return from comment in base.GetEntities()
               join content in this.Super.Contents.ReadFromCache().OfType<OrigamiVideo>() on comment.ContentId equals content.Id
               select comment;
    }
}
