@page "/login"
@using BootstrapBlazor.Components
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Identity
@using System.Security.Claims
@using Microsoft.Extensions.Options
@using Microsoft.IdentityModel.Tokens
@using System.IdentityModel.Tokens.Jwt
@using Origami.Core.Models.Jwt
@inherits BasicPage
@layout CleanLayout

@inject AuthenticationStateProvider myAuthenticationStateProvider
@inject IUserRepository userRepository
@inject IUserRoleRepository userRoleRepository
@inject IOptions<JwtConfiguration> jwtConfiguration
@inject ILoginRepository loginRepository

@if (SyncRoot != null)
{
    <div class="login-wrapper mt-3">
        @if (loginRepository.GetCurrentStep() == ILoginRepository.Steps.Step1_ValidateCredentials)
        {
            <ul class="inline-list mt-3">
                <li>
                    <MudTextField FullWidth="true" T="string" Immediate="true" HelperText="@Text.Lower("Username")" @bind-Value="loginRepository.Username" OnKeyUp="this._onLogin"></MudTextField>
                </li>
                <li>
                    <MudTextField FullWidth="true" T="string" Immediate="true" HelperText="@Text.Lower("Password")" InputType="InputType.Password" @bind-Value="loginRepository.Password" OnKeyUp="this._onLogin"></MudTextField>
                </li>
            </ul>
            <div class="btn-group mt-3 w-100">
                <button class="btn btn-success text-white w-100" disabled="@loginRepository.ShouldDisableLogin" @onclick="loginRepository.GoNextAsync" type="submit">
                    <i class="fa-solid fa-right-to-bracket"></i>
                    @Text.Lower("Login")
                </button>
                <button class="btn btn-warning text-white w-100" @onclick="loginRepository.ClearCredentials">
                    <i class="fa-solid fa-broom"></i>
                    @Text.Lower("Clear")
                </button>
                <button class="btn btn-danger text-white w-100" @onclick="_forgotPassword">
                    <i class="fa-solid fa-user-lock"></i>
                    @Text.Lower("Forgot password")
                </button>
            </div>
        }
        else if (loginRepository.GetCurrentStep() == ILoginRepository.Steps.Step2_MustChangePassword)
        {
            <ul class="inline-list">
                <li>
                    <MudTextField FullWidth="true" T="string" Immediate="true" HelperText="@Text.Lower("New password")" InputType="InputType.Password" @bind-Value="loginRepository.NewPassword1"></MudTextField>
                </li>
                <li>
                    <MudTextField FullWidth="true" T="string" Immediate="true" HelperText="@Text.Lower("Confirm password")" InputType="InputType.Password" @bind-Value="loginRepository.NewPassword2"></MudTextField>
                </li>
            </ul>
            <div class="btn-group mt-3 w-100">
                <button class="btn btn-success text-white" disabled="@loginRepository.ShouldDisablePasswordChange" @onclick="loginRepository.GoNextAsync">
                    <i class="fa-solid fa-floppy-disk"></i>
                    @Text.Lower("Change password")
                </button>
                <button class="btn btn-warning text-white" @onclick="loginRepository.ClearChangePassword">
                    <i class="fa-solid fa-broom"></i>
                    @Text.Lower("Clear")
                </button>
                <button class="btn btn-secondary text-white" @onclick="loginRepository.GoBackAsync">
                    <i class="fa-solid fa-circle-chevron-left"></i>
                    @Text.Lower("Go back")
                </button>
            </div>
        }
        else if (loginRepository.GetCurrentStep() == ILoginRepository.Steps.Step3_MustEnable2MFA)
        {
            <ul class="inline-list step3 must-enable-2fa">
                <li class="text-center">
                    <div class="qr-code-wrapper">
                        <div>@Text.Original("Scan this QR code with your authenticator app")</div>
                        <img class="qr-code" src="@this.loginRepository.User.GetTOTPQrCode()" />
                    </div>
                    <div class="uri-wrapper mt-3">
                        <div>@Text.Original("Or use this URI")</div>
                        <span class="uri">@this.loginRepository.User.GetTOTPUri()</span>
                    </div>
                </li>
                <li class="text-center">
                    <div class="recovery-codes row">
                        @foreach (var recoveryCode in this.loginRepository.TOTPRecoveryCodes)
                        {
                            <div class="recovery-code col-6">
                                <span>@recoveryCode</span>
                            </div>
                        }
                    </div>
                </li>
            </ul>
            <div class="step3 validate-code mt-3">
                <ul class="inline-list">
                    <li>
                        <MudTextField FullWidth="true" T="string" Immediate="true" HelperText="@Text.Lower("Enter the TOTP code here")" InputType="InputType.Password" @bind-Value="loginRepository.TOTPCodeForEnablement"></MudTextField>
                    </li>
                </ul>
            </div>
            <div class="btn-group mt-3 w-100">
                <button class="btn btn-success text-white" disabled="@loginRepository.ShouldDisable2FAEnablement" @onclick="loginRepository.GoNextAsync">
                    <i class="fa-solid fa-clipboard-check"></i>
                    @Text.Lower("Validate the TOTP code and proceed")
                </button>
                <button class="btn btn-warning text-white" @onclick="loginRepository.ClearEnable2FA">
                    <i class="fa-solid fa-broom"></i>
                    @Text.Lower("Clear")
                </button>
                <button class="btn btn-secondary text-white" @onclick="loginRepository.GoBackAsync">
                    <i class="fa-solid fa-circle-chevron-left"></i>
                    @Text.Lower("Go back")
                </button>
            </div>
        }
        else if (_step == Steps.Step4_Validate2FA)
        {
            <div class="step4 validate-2fa">
                <ul class="inline-list">
                    <li>
                        <MudTextField FullWidth="true" T="string" Immediate="true" HelperText="@Text.Lower("2FA code")" InputType="InputType.Password" @bind-Value="loginRepository.TOTPCodeForValidation"></MudTextField>
                    </li>
                </ul>
            </div>
            <div class="btn-group mt-3 w-100">
                <button class="btn btn-success text-white" disabled="@loginRepository.ShouldDisable2FAValidation" @onclick="loginRepository.GoNextAsync">
                    <i class="fa-solid fa-check-to-slot"></i>
                    @Text.Lower("Validate the 2FA code and login")
                </button>
                <button class="btn btn-warning text-white" @onclick="loginRepository.Clear2FA">
                    <i class="fa-solid fa-broom"></i>
                    @Text.Lower("Clear")
                </button>
                <button class="btn btn-secondary text-white" @onclick="loginRepository.GoBackAsync">
                    <i class="fa-solid fa-circle-chevron-left"></i>
                    @Text.Lower("Go back")
                </button>
            </div>
        }
    </div>
}

@code {

    private enum Steps
    {
        Step1_ValidateCredentials = 1,
        Step2_MustChangePassword = 2,
        Step3_MustEnable2MFA = 3,
        Step4_Validate2FA = 4,
    }

    private OrigamiUser _user = new();
    private Stack<Steps> _currentStep = new();
    private string _newPassword1 = string.Empty;
    private string _newPassword2 = string.Empty;
    private string _password = string.Empty;
    private string _totpCodeLogin = string.Empty;
    private string _totpCodeValidation = string.Empty;
    private string _username = string.Empty;
    private string[] _totpRecoveryCodes = [];

    private bool _disableLogin
    {
        get
        {
            if (_username.Has() == false) return true;
            if (_password.Has() == false) return true;
            return false;
        }
    }

    private bool _disablePasswordChange
    {
        get
        {
            if (_newPassword1.Has() == false) return true;
            if (_newPassword2.Has() == false) return true;
            return false;
        }
    }

    private bool _disable2FAEnablement
    {
        get
        {
            if (_totpCodeValidation.Has() == false) return true;
            return false;
        }
    }

    private bool _disable2FAValidation
    {
        get
        {
            if (_totpCodeLogin.Has() == false) return true;
            return false;
        }
    }

    private Steps _step => this._currentStep.Count > 0 ? this._currentStep.Peek() : Steps.Step1_ValidateCredentials;

    private void _goBack()
    {
        this._currentStep.TryPop(out _);
    }

    private async Task _goNext()
    {
        if (_step == Steps.Step1_ValidateCredentials)
        {
            if (_user.MustChangePassword == true)
            {
                _mustChangePassword();
                return;
            }

            _2FA();
        }
        else if (_step == Steps.Step2_MustChangePassword)
        {
            _2FA();
        }
        else if (_step == Steps.Step3_MustEnable2MFA)
        {
            this._currentStep.Push(Steps.Step4_Validate2FA);
        }
        else if (_step == Steps.Step4_Validate2FA)
        {
            await _welcomeToTheApplication();
        }
    }

    private void _clear()
    {
        switch (_step)
        {
            case Steps.Step1_ValidateCredentials:
                _username = string.Empty;
                _password = string.Empty;
                break;
            case Steps.Step2_MustChangePassword:
                _newPassword1 = string.Empty;
                _newPassword2 = string.Empty;
                break;
            case Steps.Step3_MustEnable2MFA:
                _totpCodeValidation = string.Empty;
                break;
            case Steps.Step4_Validate2FA:
                _totpCodeLogin = string.Empty;
                break;
        }
    }

    private string _generateJwtToken(OrigamiUser user)
    {
        //starts generating the JWT token
        var issuer = jwtConfiguration.Value.Issuer;
        var audience = jwtConfiguration.Value.Audience;
        var key = Encoding.ASCII.GetBytes(jwtConfiguration.Value.Key);

        var tokenDescriptor = new SecurityTokenDescriptor
        {
            Subject = new ClaimsIdentity(
                    [
                        new Claim(ClaimTypes.NameIdentifier, user.Id.ToString()),
                        new Claim(JwtRegisteredClaimNames.Email, user.EmailAddress),
                    ]),
            Expires = DateTime.UtcNow.AddMonths(6),
            Issuer = issuer,
            Audience = audience,
            SigningCredentials = new SigningCredentials(new SymmetricSecurityKey(key), SecurityAlgorithms.HmacSha512Signature)
        };

        var tokenHandler = new JwtSecurityTokenHandler();
        var token = tokenHandler.CreateToken(tokenDescriptor);
        var jwtToken = tokenHandler.WriteToken(token);
        return jwtToken;
    }

    private void _mustChangePassword()
    {
        this.UserFacade.Result = new() { Info = Text.Original("You must change your password") };
        this._currentStep.Push(Steps.Step2_MustChangePassword);
    }

    private void _2FA()
    {
        if (_user.TOTPSecret == Guid.Empty)
        {
            this.UserFacade.Result = new() { Info = Text.Original("You must enable two-factor authentication") };
            this._currentStep.Push(Steps.Step3_MustEnable2MFA);
            return;
        }

        this._currentStep.Push(Steps.Step4_Validate2FA);
    }

    private async Task _login()
    {
        var user = this.Super.Users.LookupUserInDatabase(_username, _password);
        if (user != null)
        {
            this._user = user;
            await _goNext();
        }
        else
        {
            var hub = new Result<OrigamiUser>();

            hub.Error = Text.Original("Username and password do not exist in the database");
            hub.Error = Text.Original("User may have been deleted or blocked");

            this.UserFacade.Result = hub;
        }
    }

    private async Task _changePassword()
    {
        var hub = this.Super.Users.ChangePassword(
            this.UserFacade.User.GetContext(),
            this._password,
            this._newPassword1,
            this._newPassword2);

        try
        {
            if (hub.Ok)
            {
                await _goNext();
                return;
            }
        }
        finally
        {
            this.UserFacade.Result = hub;
        }
    }

    private async Task _onLogin(KeyboardEventArgs args)
    {
        if (args.Key.Like("Enter") == true && _disableLogin == false)
        {
            await _login();
        }
    }

    private void _forgotPassword()
    {
        this.NavigationManager.NavigateTo("/password/forgot", false);
    }

    private async Task _welcomeToTheApplication()
    {
        this.UserFacade.User = this._user;
        this.Super.Users.UpdateCache(this._user);

        var token = this._generateJwtToken(this.UserFacade.User);
        await this.JSRuntime.InvokeVoidAsync("$.cookie", this.Configuration.GetUserCookieKey(), token, new { path = "/", expires = 180, });

        var returnUrl = this.NavigationManager!.Uri.QueryString("ReturnUrl");
        this.NavigationManager!.NavigateTo(returnUrl.Has() ? returnUrl : "/", true);
    }

    protected override void OnInitialized()
    {
        base.OnInitialized();
        this._currentStep.Clear();
        this._currentStep.Push(Steps.Step1_ValidateCredentials);
        this._totpRecoveryCodes = this.Super.Users.GenerateTOTPRecoveryCodes();
    }
}
