@page "/login"
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Identity
@using System.Security.Claims
@using Microsoft.Extensions.Options
@using Microsoft.IdentityModel.Tokens
@using System.IdentityModel.Tokens.Jwt
@using Origami.Core.Models.Jwt
@inherits BasicPage
@layout CleanLayout

@inject AuthenticationStateProvider myAuthenticationStateProvider
@inject IUserRepository userRepository
@inject IUserRoleRepository userRoleRepository
@inject IOptions<JwtConfiguration> jwtConfiguration

<div class="login-wrapper mt-3">
    @if (this._mustChangePassword == false)
    {
        <BlogSelect></BlogSelect>
        <ul class="inline-list mt-3">
            <li>
                <MudTextField FullWidth="true" T="string" Immediate="true" HelperText="@Text.Lower("Username")" @bind-Value="_username" OnKeyUp="this._onLogin"></MudTextField>
            </li>
            <li>
                <MudTextField FullWidth="true" T="string" Immediate="true" HelperText="@Text.Lower("Password")" InputType="InputType.Password" @bind-Value="_password" OnKeyUp="this._onLogin"></MudTextField>
            </li>
        </ul>
        <div class="btn-group mt-3 w-100">
            <button class="btn btn-success text-white w-100" disabled="@_disableLogin" @onclick="_login" type="submit">
                <i class="fa-solid fa-right-to-bracket"></i>
                @Text.Lower("Login")
            </button>
            <button class="btn btn-warning text-white w-100" @onclick="_clear">
                <i class="fa-solid fa-broom"></i>
                @Text.Lower("Clear")
            </button>
            <button class="btn btn-danger text-white w-100" @onclick="_forgotPassword">
                <i class="fa-solid fa-user-lock"></i>
                @Text.Lower("Forgot password")
            </button>
        </div>
    }
    else
    {
        <ul class="inline-list">
            <li>
                <MudTextField FullWidth="true" T="string" Immediate="true" HelperText="@Text.Lower("New password")" InputType="InputType.Password" @bind-Value="_newPassword1"></MudTextField>
            </li>
            <li>
                <MudTextField FullWidth="true" T="string" Immediate="true" HelperText="@Text.Lower("Confirm password")" InputType="InputType.Password" @bind-Value="_newPassword2"></MudTextField>
            </li>
        </ul>
        <div class="btn-group mt-3 w-100">
            <button class="btn btn-success text-white" disabled="@_disableLogin" @onclick="_changePassword">
                <i class="fa-solid fa-floppy-disk"></i>
                @Text.Lower("Save")
            </button>
            <button class="btn btn-warning text-white" @onclick="() => { this._newPassword1 = this._newPassword2 = string.Empty; }">
                <i class="fa-solid fa-broom"></i>
                @Text.Lower("Clear")
            </button>
            <button class="btn btn-secondary text-white" @onclick="_clear">
                <i class="fa-solid fa-circle-chevron-left"></i>
                @Text.Lower("Go back")
            </button>
        </div>
    }
</div>

@code {
    private bool _mustChangePassword = false;
    private string _newPassword1 = string.Empty;
    private string _newPassword2 = string.Empty;
    private string _password = string.Empty;
    private string _username = string.Empty;

    private bool _disableLogin
    {
        get
        {
            if (_username.Has() == false) return true;
            if (_password.Has() == false) return true;
            return false;
        }
    }

    private void _clear()
    {
        _mustChangePassword = false;
        _username = string.Empty;
        _password = string.Empty;
        _newPassword1 = string.Empty;
        _newPassword2 = string.Empty;
    }

    private string _generateJwtToken(OrigamiUser user)
    {
        //starts generating the JWT token
        var issuer = jwtConfiguration.Value.Issuer;
        var audience = jwtConfiguration.Value.Audience;
        var key = Encoding.ASCII.GetBytes(jwtConfiguration.Value.Key);

        var tokenDescriptor = new SecurityTokenDescriptor
        {
            Subject = new ClaimsIdentity(
                    [
                        new Claim(ClaimTypes.NameIdentifier, user.Id.ToString()),
                        new Claim(JwtRegisteredClaimNames.Email, user.EmailAddress),
                    ]),
            Expires = DateTime.UtcNow.AddMonths(6),
            Issuer = issuer,
            Audience = audience,
            SigningCredentials = new SigningCredentials(new SymmetricSecurityKey(key), SecurityAlgorithms.HmacSha512Signature)
        };

        var tokenHandler = new JwtSecurityTokenHandler();
        var token = tokenHandler.CreateToken(tokenDescriptor);
        var jwtToken = tokenHandler.WriteToken(token);
        return jwtToken;
    }

    private async Task _login()
    {
        var blog = this.Super.Blogs.ReadFromCache().Id(this.UserFacade.BlogId);
        if (blog != null)
        {
            var user = this.Super.Users.LookupUserInDatabase(_username, _password);
            if (user != null)
            {
                this.UserFacade.User = user;
                this.userRepository.UpdateCache(user);

                if (user.MustChangePassword == true)
                {
                    this._mustChangePassword = true;
                    this.UserFacade.Result = new() { ErrorMessage = Text.Original("You must change your password") };
                    return;
                }

                var token = this._generateJwtToken(user);
                await this.JSRuntime.InvokeVoidAsync("$.cookie", this.Configuration.GetUserCookieKey(), token, new { path = "/", expires = 365, });

                var returnUrl = this.NavigationManager!.Uri.QueryString("ReturnUrl");
                this.NavigationManager!.NavigateTo(returnUrl.Has() ? returnUrl : "/", true);
            }
            else
            {
                var hub = new Result<OrigamiUser>();

                hub.ErrorMessage = Text.Original("Username and password do not exist in the database");
                hub.ErrorMessage = Text.Original("User may have been deleted or blocked");

                this.UserFacade.Result = hub;
            }
        }
        else
        {
            this.UserFacade.Result = new() { ErrorMessage = Text.Original("Blog could not be found") };
        }
    }

    private void _changePassword()
    {
        var hub = this.Super.Users.ChangePassword(
            this.UserFacade.User.GetContext(),
            this._password,
            this._newPassword1,
            this._newPassword2);

        try
        {
            if (hub.Ok)
            {
                var returnUrl = this.NavigationManager!.Uri.QueryString("ReturnUrl");
                this.NavigationManager!.NavigateTo(returnUrl.Has() ? returnUrl : "/", false);
            }
        }
        finally
        {
            this.UserFacade.Result = hub;
        }
    }

    private async Task _onLogin(KeyboardEventArgs args)
    {
        if (args.Key.Like("Enter") == true && _disableLogin == false)
        {
            await _login();
        }
    }

    private void _forgotPassword()
    {
        this.NavigationManager.NavigateTo("/password/forgot", false);
    }
}
