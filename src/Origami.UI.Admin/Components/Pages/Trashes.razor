@page "/trashes"
@inherits BasicAdminGrid<OrigamiTrash>

<style>
    .trashes .id .is-deleted { display: none; }
    .deleted { opacity: 1 !important; background: initial !important; }
</style>
<Root Access="this.CanAccess()">
    <HeaderTemplate>
        <div class="p-3 border-bottom">
            <div class="row">
                <div class="d-inline-flex align-items-center col-12 col-xxl-8">
                    <i class="fa-solid fa-trash-can pe-1"></i>
                    <span class="me-3">@Text.Get("Other trashes", Text.Styles.Uppercase)</span>
                    <div class="btn-group">
                        <button class="btn btn-danger text-white" disabled="@this.DisableThePurgeButton" @onclick="this.PurgeSelectedEntities">
                            <i class="fa-solid fa-database"></i>
                            <i class="fa fa-ban" style="position: absolute; right: 8px; bottom: 8px; font-size: 8px;"></i>
                        </button>
                        <button class="btn btn-success text-white" disabled="@this.DisableTheRestoreButton" @onclick="this.RestoreSelectedEntities">
                            <i class="fa-solid fa-trash-can"></i>
                            <i class="fa fa-ban" style="position: absolute; right: 8px; bottom: 8px; font-size: 8px;"></i>
                        </button>
                    </div>
                </div>
                <div class="col-12 col-xxl-4">
                    <BlogSelect Disabled="true" Style="visibility: hidden;"></BlogSelect>
                </div>
            </div>
        </div>
        <div class="p-3 border-bottom">
            <div class="row">
                <div class="col-12">
                    <SearchTrashLite OnHitSelected="this.OnSearchResultSelected"></SearchTrashLite>
                </div>
            </div>
        </div>
    </HeaderTemplate>
    <ContentTemplate>
        <div class="p-3">
            <div class="row">
                <div class="trashes col-12 col-xxl-8">
                    <MudDataGrid @ref="DataGrid" T="OrigamiTrash" ServerData="GetEntities" Filterable="false" SortMode="SortMode.None" Class="border selectable" SelectedItems="this.SelectedEntities" MultiSelection="true" SelectedItemsChanged="this.SelectedEntitiesChanged"
                                 RowClassFunc="RowClassFunc" Bordered="true" SelectOnRowClick="false">
                        <Columns>
                            <SelectColumn T="OrigamiTrash"></SelectColumn>
                            <TemplateColumn>
                                <CellTemplate>
                                    <div class="cursor-pointer" @onclick="() => OnEdit(context.Item)">
                                        @if (context.Item.Type.Like("Blog") == true)
                                        {
                                            var blog = this.Super.Blogs.ReadFromCache().Id(context.Item.Id);
                                            <BlogHeaderLite Entity="blog"></BlogHeaderLite>
                                        }
                                        else if (context.Item.Type.Like("SpecialPage") == true)
                                        {
                                            var page = this.Super.GetSpecialPages().Id(context.Item.Id);
                                            <SpecialPageHeaderLite2 Entity="page"></SpecialPageHeaderLite2>
                                        }
                                        else if (context.Item.Type.Like("SpecialMessage") == true)
                                        {
                                            var message = this.Super.GetSpecialMessages().Id(context.Item.Id);
                                            <SpecialMessageHeaderLite Entity="message"></SpecialMessageHeaderLite>
                                        }
                                    </div>
                                </CellTemplate>
                            </TemplateColumn>
                            <TemplateColumn Title="@Text.Upper("Type")" Sortable="false" Filterable="false" CellClass="col-1 text-center">
                                <CellTemplate>
                                    <div class="small">
                                        @if (context.Item.Type.Like("SpecialPage") == true)
                                        {
                                            <span>@Text.Original("Special page")</span>
                                        }
                                        else if (context.Item.Type.Like("SpecialMessage") == true)
                                        {
                                            <span>@Text.Original("Special message")</span>
                                        }
                                        else 
                                        {
                                            <span>@Text.Original(context.Item.Type)</span>
                                        }
                                    </div>
                                </CellTemplate>
                            </TemplateColumn>
                            <TemplateColumn Title="@Text.Upper("Date")" Sortable="false" Filterable="false" CellClass="col-1 text-center">
                                <CellTemplate>
                                    <i class="fa-solid fa-calendar"></i>
                                    <div class="small">@context.Item.GetDate()</div>
                                </CellTemplate>
                            </TemplateColumn>
                        </Columns>
                        <PagerContent>
                            <MudDataGridPager T="OrigamiTrash" />
                        </PagerContent>
                        <NoRecordsContent>
                            <NoEntriesWereFound></NoEntriesWereFound>
                        </NoRecordsContent>
                    </MudDataGrid>
                </div>
                <div class="trashes-form col-12 col-xxl-4">
                    <TrashForm Class="p-3 shadow-sm border position-sticky" Entity="this.SelectedEntity" Saved="this.EntitySaved" Cancelled="this.EntityCancelled" Created="this.EntityCreated"></TrashForm>
                </div>
            </div>
        </div>
    </ContentTemplate>
</Root>
@code {

    protected override string DefaultOrdering => $"{nameof(OrigamiUserTrash.Type)}, {nameof(OrigamiUserTrash.Name)}, {nameof(OrigamiUserTrash.Title)}";

    /// <summary>
    /// Retrieves the deleted items
    /// </summary>
    /// <returns></returns>
    protected override IEnumerable<OrigamiTrash> GetItems()
    {
        using var db = this.DbContextFactory.CreateDbContext();
        return db.Set<OrigamiTrash>().AsNoTracking().ToList();
    }
}
