@page "/videos/comments"
@inherits BasicAdminGrid<OrigamiContentComment>
@inject IVideoRepository _video
@inject IBlogRepository _blogs

<Root Access="this.CanAccess()">
    <HeaderTemplate>
        <div class="p-3 border-bottom">
            <div class="row">
                <div class="d-inline-flex align-items-center col-12 col-xxl-8">
                    <i class="fa-solid fa-comment pe-1"></i>
                    <span class="me-3">@Text.Upper("Videos Comments")</span>
                    <button class="btn btn-light text-danger border border-danger" disabled="@this.DisableTheDeleteButton" @onclick="this.DeleteSelectedEntities">
                        <i class="fa-solid fa-trash-can"></i>
                    </button>
                </div>
                <div class="col-12 col-xxl-4">
                    <BlogSelect></BlogSelect>
                </div>
            </div>
        </div>
        <div class="p-3 border-bottom">
            <div class="row">
                <div class="col-12">
                    <SearchLite T="OrigamiContentComment" OnHitSelected="this.OnSearchResultSelected"></SearchLite>
                </div>
            </div>
        </div>
    </HeaderTemplate>
    <ContentTemplate>
        <div class="p-3">
            <div class="row">
                <div class="datagrid-options col-12 text-right mb-1">
                    <DataGridOptions Deleted="this.IncludeDeletedEntitiesInDataGrid" DeletedChanged="this.OnIncludeDeletedEntitiesChanged"></DataGridOptions>
                </div>
                <div class="videos-comments col-12">
                    <MudDataGrid @ref="DataGrid" T="OrigamiContentComment" ServerData="GetEntities" Filterable="false" SortMode="SortMode.None" Class="border selectable" SelectedItems="this.SelectedEntities" MultiSelection="true" SelectedItemsChanged="this.SelectedEntitiesChanged"
                                 RowClassFunc="this.RowClassFunc" Bordered="true" SelectOnRowClick="false">
                        <Columns>
                            <SelectColumn T="OrigamiContentComment"></SelectColumn>
                            <TemplateColumn Title="@Text.Upper("Comment")">
                                <CellTemplate>
                                    <div class="cursor-pointer" @onclick="() => OnEdit(context.Item)">
                                        <CommentLite Entity="context.Item"></CommentLite>
                                        @if (context.Item.ParentId != null)
                                        {
                                            var parent = this.Super.ContentComments.ReadFromCache().Id(context.Item.ParentId);
                                            <div class="mt-3 border p-3 shadow-sm">
                                                <span class="small fw-bold">
                                                    <i class="fa-solid fa-reply"></i>
                                                    @Text.Lower("Answering")
                                                </span>
                                                <CommentLite Entity="parent"></CommentLite>
                                            </div>
                                        }
                                    </div>
                                </CellTemplate>
                            </TemplateColumn>
                            <TemplateColumn Title="@Text.Upper("Video")" CellClass="col-4">
                                <CellTemplate>
                                    @{
                                        var video = this.Super.Contents.ReadFromCache().OfType<OrigamiVideo>().Id(context.Item.ContentId);
                                        <VideoHeaderLite2 Entity="video"></VideoHeaderLite2>
                                    }
                                </CellTemplate>
                            </TemplateColumn>
                        </Columns>
                        <PagerContent>
                            <MudDataGridPager T="OrigamiContentComment" />
                        </PagerContent>
                        <NoRecordsContent>
                            <NoEntriesWereFound></NoEntriesWereFound>
                        </NoRecordsContent>
                    </MudDataGrid>
                </div>
                <div class="videos-comments-form col-12 mt-3">
                    <VideoCommentForm Class="p-3 shadow-sm border position-sticky" Entity="this.SelectedEntity" Saved="this.EntitySaved" Cancelled="this.EntityCancelled"></VideoCommentForm>
                </div>
            </div>
        </div>
    </ContentTemplate>
</Root>
@code 
{
    protected override string DefaultOrdering => $"{nameof(OrigamiContentComment.DateCreated)} DESC";
}
