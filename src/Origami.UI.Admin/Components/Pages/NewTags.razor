@page "/n/tags"
@inherits BasicAdminGrid2<OrigamiContentTag>

<Root Access="this.CanAccess()">
    <HeaderTemplate>
        <div class="p-3 border-bottom">
            <div class="row">
                <div class="d-inline-flex align-items-center col-12 col-xxl-8">
                    <i class="fa-solid fa-tag pe-1"></i>
                    <span class="me-3">@Text.Upper("Tags")</span>
                    <button class="btn btn-danger text-white" disabled="@this.DisableThePurgeButton" @onclick="this.PurgeSelectedEntities">
                        <i class="fa-solid fa-database"></i>
                        <i class="fa fa-ban" style="position: absolute; right: 8px; bottom: 8px; font-size: 8px;"></i>
                    </button>
                </div>
                <div class="col-12 col-xxl-4">
                    <BlogSelect></BlogSelect>
                </div>
            </div>
        </div>
    </HeaderTemplate>
    <ContentTemplate>
        <div class="p-3">
            <div class="row">
                <div class="tags col-12">
                    <MudDataGrid @ref="DataGrid" T="OrigamiContentTag" ServerData="GetEntities" Filterable="false" SortMode="SortMode.None" Class="border selectable" SelectedItems="this.SelectedEntities" MultiSelection="true"
                                 SelectedItemsChanged="this.SelectedEntitiesChanged" RowClassFunc="RowClassFunc" Bordered="true" SelectOnRowClick="false">
                        <Columns>
                            <SelectColumn T="OrigamiContentTag"></SelectColumn>
                            <TemplateColumn Title="@Text.Upper("Name")" Sortable="false" Filterable="false" SortBy="x => nameof(x.Tag)">
                                <CellTemplate>
                                    <div class="cursor-pointer" @onclick="() => OnEdit(context.Item)">
                                        <ContentTagHeaderInline Entity="context.Item"></ContentTagHeaderInline>
                                    </div>
                                </CellTemplate>
                            </TemplateColumn>
                            <TemplateColumn Title="@Text.Upper("Posts, videos")" Sortable="false" Filterable="false" CellClass="col-2">
                                <CellTemplate>
                                    <div class="p-1">
                                        <span>@Text.Lower("{0} post(s)", this.Super.GetContents(context.Item, this.UserFacade.BlogId).OfType<OrigamiPost>().Published().Count())</span>
                                    </div>
                                    <div class="p-1 mt-1">
                                        <span>@Text.Lower("{0} video(s)", this.Super.GetContents(context.Item, this.UserFacade.BlogId).OfType<OrigamiVideo>().Published().Count())</span>
                                    </div>
                                </CellTemplate>
                            </TemplateColumn>
                            <TemplateColumn Title="@Text.Upper("Actions")" Sortable="false" Filterable="false" HeaderClass="col-1 text-center">
                                <CellTemplate>
                                    <div class="btn-group-vertical w-100">
                                        <button class="btn btn-light" title="@Text.Original("Edit")" @onclick="() => OnEdit(context.Item)">
                                            <i class="fa-solid fa-pen-to-square"></i>
                                        </button>
                                    </div>
                                </CellTemplate>
                            </TemplateColumn>
                        </Columns>
                        <PagerContent>
                            <MudDataGridPager T="OrigamiContentTag" />
                        </PagerContent>
                        <NoRecordsContent>
                            <NoEntriesWereFound></NoEntriesWereFound>
                        </NoRecordsContent>
                    </MudDataGrid>
                </div>
            </div>
        </div>
        <MudDialog @bind-Visible="IsSelectedEntityNotNull" Options="this.DialogOptions">
            <TitleContent>
                @Text.Upper("Editor")
            </TitleContent>
            <DialogContent>
                <div class="position-relative pt-3 pb-3 dialog-content">
                    <NewTagForm Entity="this.SelectedEntity" Class="w-100 h-100" Saved="this.EntitySaved" Cancelled="this.EntityCancelled" Created="this.EntityCreated"></NewTagForm>
                </div>
            </DialogContent>
        </MudDialog>
    </ContentTemplate>
</Root>
@code {
    protected override string DefaultOrdering => $"{nameof(OrigamiContentTag.Tag)}";

    protected override string RowClassFunc(OrigamiContentTag entity, int index)
    {
        var result = base.RowClassFunc(entity, index);
        if (entity.Tag == SelectedEntity?.Tag && entity.Slug == SelectedEntity?.Slug) result += " selected-row";
        return result;
    }

    protected override IEnumerable<OrigamiContentTag> GetEntities()
    {
        return base.GetEntities().DistinctBy(x => x.Tag);
    }
}
