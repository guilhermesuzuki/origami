@page "/backups"
@using Microsoft.Data.SqlClient
@inherits BasicAdminGrid<OrigamiBackup>
@implements IFilter

<Root Access="this.CanAccess()">
    <HeaderTemplate>
        <div class="p-3 border-bottom">
            <div class="row">
                <div class="d-inline-flex align-items-center col-12 col-xxl-8">
                    <ul class="inline-list w-100">
                        <li style="width:80%;">
                            <i class="fa-solid fa-database pe-1"></i>
                            <span class="pe-3">@Text.Get("Backups", Text.Styles.Uppercase)</span>
                            <div class="btn-group pe-1">
                                <button class="btn btn-light text-danger border border-danger" disabled="@this.DisableTheDeleteButton" @onclick="this.PurgeSelectedEntities">
                                    <i class="fa-solid fa-trash-can"></i>
                                </button>
                            </div>
                            <div class="btn-group pe-1">
                                <button class="btn btn-success text-white" title="@Text.Lower("Backup files and database")" disabled="@this.DisableTheBackupButton" @onclick="this.BackupOrigami">
                                    <i class="bi bi-database-fill-add"></i>
                                    <span>@Text.Lower("Backup")</span>
                                </button>
                                <button class="btn btn-warning text-white" title="@Text.Lower("Restore files and database from a backup in the list below")" disabled="@this.DisableTheRestoreButton" @onclick="this.RestoreOrigamiPrompt">
                                    <i class="bi bi-database-fill-exclamation"></i>
                                    <span>@Text.Lower("Restore from list")</span>
                                </button>
                            </div>
                            <RestoreFromZip DisableTheRestoreZipButton="@this.DisableTheRestoreZipButton" Class="pe-1" RestorationIsDone="() => this.DataGrid.ReloadServerData()"></RestoreFromZip>
                        </li>
                        <li style="width:20%;">
                        </li>
                    </ul>
                </div>
                <div class="col-12 col-xxl-4">
                    <BlogSelect Style="visibility:hidden;"></BlogSelect>
                </div>
            </div>
        </div>
    </HeaderTemplate>
    <ContentTemplate>
        @if (this.Repository is IBackupRestoreRepository backupRestoreRepository && backupRestoreRepository.Current != null)
        {
            <div class="p-3">
                <div class="p-3 border border-warning rounded bg-light bg-gradient">
                    <div class="row">
                        <div class="col-12">
                            <i class="bi bi-exclamation-triangle-fill text-warning pe-1"></i>
                            @if (backupRestoreRepository.Current is OrigamiBackupRestore)
                            {
                                @Text.Original("A restore process is currently running. Some actions are disabled until the process is complete.")
                            }
                            else
                            {
                                @Text.Original("A backup process is currently running. Some actions are disabled until the process is complete.")
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
        <div class="p-3">
            <div class="row">
                <div class="pages col-12">
                    <MudDataGrid @ref="DataGrid" T="OrigamiBackup" ServerData="GetEntities" Filterable="false" SortMode="SortMode.None" Class="border" SelectedItems="this.SelectedEntities" MultiSelection="false" SelectedItemsChanged="this.SelectedEntitiesChanged"
                                 RowClassFunc="this.RowClassFunc" Bordered="true" SelectOnRowClick="false">
                        <Columns>
                            <SelectColumn T="OrigamiBackup"></SelectColumn>
                            <TemplateColumn Title="@Text.Upper("Title")">
                                <CellTemplate>
                                    <div>
                                        @if (context.Item is OrigamiBackupRestore)
                                        {
                                            <div>
                                                <i class="bi bi-database-fill-exclamation"></i>
                                                @Text.Original("Restore")
                                            </div>
                                        }
                                        else
                                        {
                                            <div>
                                                <i class="bi bi-database-fill-add"></i>
                                                @Text.Original("Backup")
                                            </div>
                                        }
                                        <Id Class="x-small" Entity="context.Item"></Id>
                                    </div>
                                </CellTemplate>
                            </TemplateColumn>
                            <TemplateColumn Title="@Text.Upper("User")" CellClass="col-2 text-center">
                                <CellTemplate>
                                    @if (context.Item.AuthorId != Guid.Empty)
                                    {
                                        var user = this.Super.Users.ReadFromCache().Id(context.Item.AuthorId);
                                        @if (user != null)
                                        {
                                            <span><i class="bi bi-person-fill"></i>@user.Username (@user.DisplayName)</span>
                                        }
                                    }
                                </CellTemplate>
                            </TemplateColumn>
                            <TemplateColumn Title="@Text.Upper("Download")" CellClass="col-1 text-center">
                                <CellTemplate>
                                    @if (this.Super.Files.FileExists(context.Item.File) == true)
                                    {
                                        var file = this.Super.Files.GetFile(context.Item.File)!;
                                        <button @onclick="() => DownloadFile(file)" @onclick:stopPropagation="true">
                                            <i class="fa-solid fa-file-arrow-down"></i>
                                        </button>
                                    }
                                </CellTemplate>
                            </TemplateColumn>
                        </Columns>
                        <PagerContent>
                            <MudDataGridPager T="OrigamiBackup" />
                        </PagerContent>
                        <NoRecordsContent>
                            <NoEntriesWereFound></NoEntriesWereFound>
                        </NoRecordsContent>
                    </MudDataGrid>
                </div>
                <div class="pages-form col-12 mt-3">
                </div>
            </div>
        </div>
        <MudDialog @bind-Visible="_showUserCredentialsPrompt" Options="_dialogOptions" Style="min-width: 500px;">
            <TitleContent>
                <div class="dialog-title">
                    <div>@Text.Original("Please inform a set of user credentials with elevated priviledges to restore the backup")</div>
                    <div>@Text.Original("And it must a different user than current user accessing the database")</div>
                </div>
            </TitleContent>
            <DialogContent>
                <div class="dialog-content">
                    <ul class="inline-list">
                        <li>
                            <MudTextField FullWidth="true" T="string" Immediate="true" HelperText="@Text.Lower("Username")" @bind-Value="_username"></MudTextField>
                        </li>
                        <li>
                            <MudTextField FullWidth="true" T="string" Immediate="true" HelperText="@Text.Lower("Password")" InputType="InputType.Password" @bind-Value="_password"></MudTextField>
                        </li>
                    </ul>
                    <div class="btn-group w-100 mt-3">
                        <button class="btn btn-success w-100" disabled="@(_username.Has() == false || _password.Has() == false)" @onclick="RestoreOrigamiConfirmation">@Text.Lower("Proceed")</button>
                        <button class="btn btn-warning w-100" @onclick="() => { _username = string.Empty; _password = string.Empty; }">@Text.Lower("Clear")</button>
                    </div>
                </div>
            </DialogContent>
        </MudDialog>
    </ContentTemplate>
</Root>
@code {

    protected override string DefaultOrdering => $"{nameof(OrigamiBackup.DateCreated)}";

    private readonly DialogOptions _dialogOptions = new() { CloseOnEscapeKey = true, CloseButton = false, CloseOnNavigation = true, MaxWidth = MaxWidth.Large, };

    private bool _showUserCredentialsPrompt = false;
    private string _username = string.Empty;
    private string _password = string.Empty;

    /// <summary>
    /// Disables the restore button if a restore process is currently running.
    /// </summary>
    protected override bool DisableTheRestoreButton
    {
        get
        {
            if (this.Repository is IBackupRestoreRepository backupRestoreRepository && backupRestoreRepository.Current != null)
            {
                return true;
            }
            if (this.SelectedEntities.Any() == true)
            {
                var entity = this.SelectedEntities.First();
                return entity is OrigamiBackupRestore;
            }
            return base.DisableTheRestoreButton;
        }
    }

    /// <summary>
    /// Disables the restore zip file button.
    /// </summary>
    protected bool DisableTheRestoreZipButton
    {
        get
        {
            if (this.Repository is IBackupRestoreRepository backupRestoreRepository && backupRestoreRepository.Current != null)
            {
                return true;
            }
            return false;
        }
    }

    protected bool DisableTheBackupButton
    {
        get
        {
            if (this.Repository is IBackupRestoreRepository backupRestoreRepository && backupRestoreRepository.Current != null)
            {
                return true;
            }
            return false;
        }
    }

    protected async Task BackupOrigami()
    {
        var ok = await DialogService.ShowMessageBoxAsync(
            Text.Upper("Backup files and database"),
            Text.Original("Are you sure?"),
            yesText: Text.Lower("Yes"),
            noText: Text.Lower("No"));

        if (ok == false) return;

        if (this.Repository is IBackupRestoreRepository backupRestoreRepository)
        {
            var scope = new TransactionScope(
                TransactionScopeOption.Required,
                TransactionScopeAsyncFlowOption.Enabled);

            backupRestoreRepository.BackupRestoreTask = Task.Run(async () =>
            {
                using (scope)
                {
                    var hub = await backupRestoreRepository.BackupAsync(this.UserFacade.User);
                    if (hub.Ok)
                    {
                        scope.Complete();
                        await this.InvokeAsync(async () => await this.DataGrid.ReloadServerData());
                    }
                    UserFacade.Result = hub;
                }
            });
        }
    }

    protected async Task RestoreOrigamiPrompt()
    {
        var ok = await DialogService.ShowMessageBoxAsync(
            Text.Upper("Restore files and database"),
            Text.Original("Are you sure?"),
            yesText: Text.Lower("Yes"),
            noText: Text.Lower("No"));

        if (ok == false) return;

        this._showUserCredentialsPrompt = true;
    }

    protected async Task RestoreOrigamiConfirmation()
    {
        try
        {
            this._showUserCredentialsPrompt = false;

            if (this.Repository is IBackupRestoreRepository backupRestoreRepository)
            {
                var builder = new SqlConnectionStringBuilder(this.Configuration.GetOrigamiConnectionString());
                if (builder.UserID.Like(_username) == true)
                {
                    await DialogService.ShowMessageBoxAsync(
                        Text.Upper("Restore files and database"),
                        Text.Original("The user must be different than the current user"),
                        yesText: Text.Lower("Ok"));
                    return;
                }

                builder.UserID = _username;
                builder.Password = _password;

                //private scope to test the connection string with the new credentials
                {
                    using var sqlConnection = new SqlConnection(builder.ConnectionString);
                    await sqlConnection.OpenAsync();
                }

                backupRestoreRepository.BackupRestoreTask = Task.Run(async () =>
                {
                    using var scope = new TransactionScope(TransactionScopeOption.Required, TransactionScopeAsyncFlowOption.Enabled);
                    var hub = await backupRestoreRepository.RestoreAsync(this.UserFacade.User, this.SelectedEntities.First(), builder.ConnectionString);
                    if (hub.Ok)
                    {
                        scope.Complete();
                        await this.InvokeAsync(async () => await this.DataGrid.ReloadServerData());
                    }
                    UserFacade.Result = hub;
                });
            }
        }
        catch (Exception ex)
        {
            this.UserFacade.Result = new(ex);
        }
    }

    protected override void OnInitialized()
    {
        base.OnInitialized();
        this.AppFacade.RefreshingTheUI += (obj, args) =>
        {
            if (obj is string s)
            {
                if (s.Like(OrigamiConstants.Events.Backup) == true) this.InvokeAsync(this.StateHasChanged);
                if (s.Like(OrigamiConstants.Events.BackupComplete) == true) this.InvokeAsync(this.StateHasChanged);
                if (s.Like(OrigamiConstants.Events.Restore) == true) this.InvokeAsync(this.StateHasChanged);
                if (s.Like(OrigamiConstants.Events.RestoreComplete) == true) this.InvokeAsync(this.StateHasChanged);
            }
        };
    }

    private string _user()
    {
        var builder = new SqlConnectionStringBuilder(this.Configuration.GetOrigamiConnectionString());
        return builder.UserID;
    }
}
