@page "/email/password/reset/{Key1}"
@inherits Basic
@layout EmailLayout

@if (this.Key1.Has() == true)
{
    var pwd = this.Super.UserPasswordResets.ReadFromDatabase().NonDeleted().FirstOrDefault(x => x.Key == this.Key1);
    if (pwd != null)
    {
        var user = this.Super.Users.ReadFromDatabase().FirstOrDefault(x => x.Id == pwd.UserId);
        if (user != null)
        {
            var link = this.NavigationManager.BaseUri.TrimEnd('/') + "/password/reset/" + Key1;
            <div style="text-align:center;">
                <div style="display: inline-block; width:49%;">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" style="height: 15px;"><!--!Font Awesome Free 6.7.2 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2025 Fonticons, Inc.--><path d="M234.5 5.7c13.9-5 29.1-5 43.1 0l192 68.6C495 83.4 512 107.5 512 134.6l0 242.9c0 27-17 51.2-42.5 60.3l-192 68.6c-13.9 5-29.1 5-43.1 0l-192-68.6C17 428.6 0 404.5 0 377.4L0 134.6c0-27 17-51.2 42.5-60.3l192-68.6zM256 66L82.3 128 256 190l173.7-62L256 66zm32 368.6l160-57.1 0-188L288 246.6l0 188z" /></svg>
                </div>
                <div style="display: inline-block; width:49%;">
                    <img src="@user.HeaderImage" style="height:15px;" />
                    <span>@user.Username.ToLower()</span>
                </div>
            </div>
            <div>
                <h1>@Text.Original("Password Reset")</h1>
                <ul>
                    <li>@Text.Original("User"): @user.Username.ToLower()</li>
                </ul>
                <p>
                    @Text.Original("You asked for a password reset and here's the link to paste in your browser"):
                </p>
                <ul>
                    <li><b>@link</b></li>
                    <li><a href="@link" class="">@Text.Original("Or click here to reset password")</a></li>
                </ul>
                <p>
                    <span style="text-decoration:underline">@Text.Original("Don't share that link")<span>.</span></span>
                    @Text.Original("If you did not request this, please ignore this email")<span>.</span>
                </p>
            </div>
        }
    }
}

@code {
    [Parameter] public string Key1 { get; set; } = string.Empty;
}