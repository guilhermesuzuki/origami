@page "/pages"
@page "/pages/{NanoId}"
@inherits BasicAdminGridContent<OrigamiPage, HubContentPage>

<style>
    .related-pages .id { display: none !important; }
</style>
<Root Access="this.CanAccess()">
    <HeaderTemplate>
        <div class="p-3 border-bottom">
            <div class="row">
                <div class="d-inline-flex align-items-center col-12 col-xxl-8">
                    <ul class="inline-list w-100">
                        <li style="width:80%;">
                            <i class="fa-solid fa-file-lines pe-1"></i>
                            <span class="pe-3">@Text.Get("Pages", Text.Styles.Uppercase)</span>
                            <div class="btn-group pe-1">
                                <button class="btn btn-light text-danger border border-danger" disabled="@this.DisableTheDeleteButton" @onclick="this.DeleteSelectedEntities">
                                    <i class="fa-solid fa-trash-can"></i>
                                </button>
                            </div>
                            <div class="btn-group pe-1">
                                <button class="btn btn-success text-white" title="@Text.Lower("Publish page(s)")" disabled="@this.DisableTheDeleteButton" @onclick="this.PublishSelectedEntities">
                                    <i class="fa-solid fa-file-arrow-up"></i>
                                </button>
                                <button class="btn btn-warning text-white" title="@Text.Lower("Unpublish page(s)")" disabled="@this.DisableTheDeleteButton" @onclick="this.UnpublishSelectedEntities">
                                    <i class="fa-solid fa-file-arrow-down"></i>
                                </button>
                            </div>
                            <div class="btn-group pe-1">
                                <button class="btn btn-success text-white" title="@Text.Lower("Promote to front-page")" disabled="@this.DisableTheFrontPageButton" @onclick="this.PromoteToFrontPageSelectedEntities">
                                    <i class="fa-solid fa-file-circle-check"></i>
                                </button>
                                <button class="btn btn-warning text-white" title="@Text.Lower("Demote from front-page")" disabled="@this.DisableTheFrontPageButton" @onclick="this.DemoteFromFrontPageSelectedEntities">
                                    <i class="fa-solid fa-file-circle-xmark"></i>
                                </button>
                            </div>
                        </li>
                        <li style="width:20%;">
                            <MudSelect T="string" HelperText="@Text.Lower("Filter")" @bind-Value:get="Filter" @bind-Value:set="(filter) => SetFilterAndRefreshUI(filter)">
                                <MudSelectItem T="string" Value="@(new string("all"))">@Text.Original("All")</MudSelectItem>
                                <MudSelectItem T="string" Value="@(new string("published"))">@Text.Original("Published")</MudSelectItem>
                                <MudSelectItem T="string" Value="@(new string("drafts"))">@Text.Original("Drafts")</MudSelectItem>
                            </MudSelect>
                        </li>
                    </ul>
                </div>
                <div class="col-12 col-xxl-4">
                    <BlogSelect></BlogSelect>
                </div>
            </div>
        </div>
    </HeaderTemplate>
    <ContentTemplate>
        <div class="p-3">
            <div class="row">
                <div class="datagrid-options col-12 text-right mb-1">
                    <DataGridOptions Deleted="this.IncludeDeletedEntitiesInDataGrid" DeletedChanged="this.OnIncludeDeletedEntitiesChanged"></DataGridOptions>
                </div>
                <div class="pages col-12">
                    <MudDataGrid @ref="DataGrid" T="HubContentPage" ServerData="GetEntities" Filterable="false" SortMode="SortMode.None" Class="border selectable" SelectedItems="this.SelectedEntities" MultiSelection="true" SelectedItemsChanged="this.SelectedEntitiesChanged"
                                 RowClassFunc="this.RowClassFunc" Bordered="true" SelectOnRowClick="false">
                        <Columns>
                            <SelectColumn T="HubContentPage"></SelectColumn>
                            <TemplateColumn Title="@Text.Upper("Title")">
                                <CellTemplate>
                                    <div class="cursor-pointer" @onclick="() => OnEdit(context.Item)">
                                        <ContentTitleColumn Entity="context.Item.Entity"></ContentTitleColumn>
                                    </div>
                                </CellTemplate>
                            </TemplateColumn>
                            <TemplateColumn Title="@Text.Upper("Header")" CellClass="col-2">
                                <CellTemplate>
                                    <ContentHeaderColumn Entity="context.Item.Entity"></ContentHeaderColumn>
                                </CellTemplate>
                            </TemplateColumn>
                            <TemplateColumn Title="@Text.Upper("Related pages")" Sortable="false" Filterable="false" CellClass="col-2 related-pages">
                                <CellTemplate>
                                    @if (context.Item.Parent != null)
                                    {
                                        <div class="parent-page">
                                            <div class="xx-small">@Text.Lower("Parent")</div>
                                            <div class="shadow-sm border p-2">
                                                <ContentHeaderInline Class="" Entity="context.Item.Parent"></ContentHeaderInline>
                                            </div>
                                        </div>
                                    }
                                    @foreach (var page in context.Item.Children.OrderBy(x => x.Title))
                                    {
                                        if (this.IncludeDeletedEntitiesInDataGrid == false && page.IsDeleted)
                                        {
                                            continue;
                                        }
                                        <div class="page-child mt-1 shadow-sm border p-2 @(page.IsDeleted ? "deleted" : null)">
                                            <ContentHeaderInline Class="" Entity="page"></ContentHeaderInline>
                                        </div>
                                    }
                                </CellTemplate>
                            </TemplateColumn>
                            <TemplateColumn Title="@Text.Upper("Published")" Sortable="false" Filterable="false" CellClass="col-1 text-center">
                                <CellTemplate>
                                    @if (context.Item.Entity.IsPublished)
                                    {
                                        <i class="fa-solid fa-thumbs-up"></i>
                                        <div class="small">@context.Item.Entity.DatePublished</div>
                                    }
                                </CellTemplate>
                            </TemplateColumn>
                            <TemplateColumn Title="@Text.Upper("Date")" Sortable="false" Filterable="false" CellClass="col-1 text-center">
                                <CellTemplate>
                                    <i class="fa-solid fa-calendar"></i>
                                    <div class="small">@context.Item.Entity.GetDate()</div>
                                </CellTemplate>
                            </TemplateColumn>
                        </Columns>
                        <PagerContent>
                            <MudDataGridPager T="HubContentPage" />
                        </PagerContent>
                        <NoRecordsContent>
                            <NoEntriesWereFound></NoEntriesWereFound>
                        </NoRecordsContent>
                    </MudDataGrid>
                </div>
                <div class="pages-form col-12 mt-3">
                    <PageForm Class="p-3 shadow-sm border position-sticky" Entity="this.SelectedEntity" Saved="this.EntitySaved" Cancelled="this.EntityCancelled" Created="this.EntityCreated"></PageForm>
                </div>
            </div>
        </div>
    </ContentTemplate>
</Root>
@code {

    protected override string DefaultOrdering => $"{nameof(OrigamiPage.Title)}";

    /// <summary>
    /// Can the user delete the selected entities?
    /// </summary>
    protected virtual bool DisableTheFrontPageButton => SelectedEntities.Any() == false;

    protected override IEnumerable<OrigamiPage> GetItems()
    {
        if (this.IncludeDeletedEntitiesInDataGrid)
        {
            return base.GetItems();
        }

        return from x in base.GetItems()
               where x.IsDeleted == false
               where this.Super.IsParentDeleted(x) == false
               select x;
    }

    protected override void OnEdit(HubContentPage entity)
    {
        GhostOfTheNavigator.NavigateTo($"/pages/{entity.Entity.NanoId}");
    }
}
