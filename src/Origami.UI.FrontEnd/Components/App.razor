@using Origami.Core
@using Origami.Core.Data
@inject ISettingsRepository _settings
@{
    var lang = CultureInfo.CurrentUICulture.Name;
    var blogSettings = _settings.GetSettings();
    var favicon = blogSettings.LogoUrl;
    var faviconExtension = Path.GetExtension(favicon).TrimStart('.');
}
<!DOCTYPE html>
<html class="site-is-frontend" lang="@lang">
<head>
    @if (favicon.Has() == true)
    {
        <link rel="icon" type="image/@faviconExtension" href="@favicon" />
    }
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <base href="/" />
    <HeadOutlet></HeadOutlet>
    <CustomHeadOutlet></CustomHeadOutlet>
</head>
<body>
    <Routes @rendermode="InteractiveServer"></Routes>
    <script src="_framework/blazor.web.js"></script>
    <script src="_content/MudBlazor/MudBlazor.min.js"></script>
    <script src="_content/TinyMCE.Blazor/tinymce-blazor.js"></script>
    <script src="_content/Origami.UI/lib/jquery/jquery.js"></script>
    <script src="_content/Origami.UI/lib/jquery-migrate/jquery-migrate.js"></script>
    <script src="_content/Origami.UI/lib/jquery-cookie/jquery.cookie.js"></script>
    <script type="module" src="https://cdn.jsdelivr.net/npm/emoji-picker-element@@^1/index.js"></script>
    <script src="_content/Origami.UI/lib/yoxview/yox.js" type="text/javascript"></script>
    <script src="_content/Origami.UI/lib/yoxview/jquery.yoxview-2.21.js" type="text/javascript"></script>
    <!-- cdnjs for jquery lazy -->
    <script type="text/javascript" src="//cdnjs.cloudflare.com/ajax/libs/jquery.lazy/1.7.9/jquery.lazy.min.js"></script>
    <script type="text/javascript" src="//cdnjs.cloudflare.com/ajax/libs/jquery.lazy/1.7.9/jquery.lazy.plugins.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/prismjs@1.29/prism.min.js" data-manual></script>
    <script src="https://cdn.jsdelivr.net/npm/prismjs@1.29/plugins/autoloader/prism-autoloader.min.js"></script>
    <script src="_content/Origami.UI/lib/common.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js" integrity="sha384-ndDqU0Gzau9qJ1lfW4pNLlhNTkCfHzAVBReH9diLvGRem5+R9g2FzA8ZGN954O5Q" crossorigin="anonymous"></script>
</body>
</html>

