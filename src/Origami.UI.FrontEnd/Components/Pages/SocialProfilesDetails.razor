@page "/socialprofiles/{NanoId}"
@using Microsoft.EntityFrameworkCore
@inherits BasicPage

@inject IContentCommentReactionRepository _contentCommentReaction
@inject IContentCommentRepository _contentComment
@inject IContentRatingRepository _contentRating
@inject ISocialProfileDeleteRepository _socialProfileForDeletion
@inject ISocialProfileRepository _socialProfile
@inject ISubscriberRepository _subscriber

<Root>
    @if (this.SocialProfile.New == false)
    {
        <style>
                .social-profile ul { list-style: none; padding-left: 0; margin-bottom: 0; }
        </style>
        <div class="social-profile-details">
            <div class="row">
                <div class="col-12 col-xl-4">
                    <div class="p-3 shadow-lg position-sticky" style="top: 1rem;">
                        <div class="w-100 text-center fs-4 p-2">
                            <i class="fa-solid fa-user"></i>
                            @Text.Lower("Profile Information")
                        </div>
                        @if (SocialProfile.ProfilePicture().Has() == true)
                        {
                            <div class="row mt-3">
                                <div class="col-12 text-center">
                                    <div class="fs-5">@Text.Lower("Logo • Avatar")</div>
                                    <img src="@SocialProfile.ProfilePicture()" onerror="this.onerror=null; this.src='@(OrigamiConstants.NoUser)'" height="128" />
                                </div>
                            </div>
                        }
                        <div class="row mt-3">
                            <div class="col-12">
                                <div class="fs-5">@Text.Lower("Name")</div>
                                <SocialProfileHeaderInline ProfilePicture="false" Entity="this.SocialProfile"></SocialProfileHeaderInline>
                            </div>
                        </div>
                        <div class="row mt-3">
                            <div class="col-12">
                                <div class="fs-5">@Text.Lower("Subscriber")?</div>
                                @if (this.Subscriber()?.IsDeleted == false)
                                {
                                    <span class="yes">@Text.Lower("Yes, since"): @(this.Subscriber()!.DateModified ?? this.Subscriber()!.DateCreated)</span>
                                }
                                else
                                {
                                    <span class="no">@Text.Lower("No")</span>
                                }
                            </div>
                        </div>
                        <div class="row mt-3">
                            <div class="col-12 col-xl-6">
                                <div class="fs-5">
                                    @Text.Lower("Ratings")
                                </div>
                                <span>
                                    @_contentRating.RatingsFromProfile(this.SocialProfile).Count()
                                </span>
                            </div>
                            <div class="col-12 col-xl-6">
                                <div class="fs-5">
                                    @Text.Lower("Reactions")
                                </div>
                                <span>
                                    @(_contentCommentReaction.ReactionsFromProfile(this.SocialProfile).Count() + this.Super.ContentReactions.ReactionsFromProfile(this.SocialProfile).Count())
                                </span>
                            </div>
                        </div>
                        <div class="row mt-3">
                            <div class="col-12">
                                <div class="fs-5">
                                    @Text.Lower("Comments [including deleted]")
                                </div>
                                <span>
                                    @_contentComment.CommentsFromProfile(this.SocialProfile, true).Count()
                                </span>
                            </div>
                        </div>
                        <AuthorizeView>
                            <Authorized>
                                @if (this.NanoId == this.UserFacade.SocialProfile.NanoId)
                                {
                                    <button class="w-100 mt-3 btn bg-warning text-white" @onclick="this.WipeData">
                                        <i class="fa-solid fa-triangle-exclamation pe-1"></i>
                                        @Text.Lower("Wipe all data from the website")
                                    </button>
                                    @if (this.Subscriber() == null || this.Subscriber()!.IsDeleted == true)
                                    {
                                        <button class="w-100 mt-3 btn bg-success text-white" @onclick="this.Subscribe">
                                            <i class="fa-solid fa-user-plus pe-1"></i>
                                            @Text.Lower("Subscribe to the website")
                                        </button>
                                    }
                                    else
                                    {
                                        <button class="w-100 mt-3 btn bg-danger text-white" @onclick="this.Unsubscribe">
                                            <i class="fa-solid fa-user-minus pe-1"></i>
                                            @Text.Lower("Unsubscribe from the website")
                                        </button>
                                    }
                                    @* incognito mode *@
                                    @if (this.UserFacade.SocialProfile.IsModerator)
                                    {
                                        @if (this._incognitoMode == true)
                                        {
                                            <button class="w-100 p-2 btn bg-danger text-white border mt-3" @onclick="this.LeaveIncognito">
                                                <i class="fa-solid fa-user-secret"></i>
                                                @Text.Lower("Leave incognito")
                                            </button>
                                        }
                                        else
                                        {
                                            <button class="w-100 p-2 btn bg-danger text-white border mt-3" @onclick="this.EnterIncognito">
                                                <i class="fa-solid fa-user-secret"></i>
                                                @Text.Lower("Enter incognito")
                                            </button>
                                        }
                                    }
                                    <button class="w-100 p-2 btn border-danger text-danger border mt-3" @onclick="this.Logout">
                                        <i class="fa-solid fa-right-from-bracket"></i>
                                        @Text.Lower("Logout")
                                    </button>
                                }
                            </Authorized>
                        </AuthorizeView>
                    </div>
                </div>

                <div class="col-12 col-xxl-8">
                    <div class="p-3 shadow-lg">
                        <div class="w-100 text-center fs-4 p-2">
                            <i class="fa-solid fa-bolt"></i>
                            @Text.Lower("User Activity")
                        </div>
                        <MudDataGrid @ref="_userActivities" T="OrigamiUserActivity" Class="border-top" ServerData="this.UserActivities" SortMode="SortMode.None" Filterable="false">
                            <Columns>
                                <TemplateColumn>
                                    <CellTemplate>
                                        <span class="fw-bold">
                                            <i class="fa-solid fa-calendar"></i>
                                            @context.Item.Date
                                        </span>
                                        @if (context.Item.Type.Like("ContentCommentReaction") == true)
                                        {
                                            <UserActivityContentCommentReaction Id="@context.Item.Id"></UserActivityContentCommentReaction>
                                        }
                                        else if (context.Item.Type.Like("ContentComment") == true)
                                        {
                                            <UserActivityContentComment Id="@context.Item.Id"></UserActivityContentComment>
                                        }
                                        else if (context.Item.Type.Like("ContentRating") == true)
                                        {
                                            <UserActivityContentRating Id="@context.Item.Id"></UserActivityContentRating>
                                        }
                                        else if (context.Item.Type.Like("ContentReaction") == true)
                                        {
                                            <UserActivityContentReaction Id="@context.Item.Id"></UserActivityContentReaction>
                                        }
                                        else if (context.Item.Type.Like("SocialProfileDelete") == true)
                                        {
                                            <UserActivitySocialProfileDelete Id="@context.Item.Id"></UserActivitySocialProfileDelete>
                                        }
                                        else if (context.Item.Type.Like("SocialProfileLogsIntoWebsiteEvent") == true)
                                        {
                                            <UserActivitySocialProfileLogsIntoWebsite Id="@context.Item.Id"></UserActivitySocialProfileLogsIntoWebsite>
                                        }
                                        else if (context.Item.Type.Like("SocialProfileSubscribesToWebsiteEvent") == true)
                                        {
                                            <UserActivitySocialProfileSubscribesToWebsite Id="@context.Item.Id"></UserActivitySocialProfileSubscribesToWebsite>
                                        }
                                        else if (context.Item.Type.Like("SocialProfileUnsubscribesFromWebsiteEvent") == true)
                                        {
                                            <UserActivitySocialProfileUnsubscribesFromWebsite Id="@context.Item.Id"></UserActivitySocialProfileUnsubscribesFromWebsite>
                                        }
                                    </CellTemplate>
                                </TemplateColumn>
                            </Columns>
                            <PagerContent>
                                <MudDataGridPager T="OrigamiUserActivity" PageSizeOptions="[5, 10, 25, 50, 100]"></MudDataGridPager>
                            </PagerContent>
                        </MudDataGrid>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <NothingToSeeHere Subtitle="@Text.Lower("Profile Not Found")"></NothingToSeeHere>
    }
</Root>

    @code {
    /// <summary>
    /// User Activities DataGrid
    /// </summary>
    private MudDataGrid<OrigamiUserActivity>? _userActivities;

    protected OrigamiSocialProfile SocialProfile = new();
    protected IEnumerable<OrigamiSocialProfileDelete>? SocialProfileForDeletions;
    protected IEnumerable<IDateCreated>? Interactions;

    [Parameter] public string NanoId { get; set; } = string.Empty;

    private bool _incognitoMode = false;

    protected void LoadSocialProfile()
    {
        this.SocialProfile = this.Super.SocialProfiles.ReadFromCache().NonDeleted().NanoId(this.NanoId) ?? new();
    }

    protected Task<GridData<OrigamiUserActivity>> UserActivities(GridState<OrigamiUserActivity> state, CancellationToken token)
    {
        var orders = new StringBuilder();

        //iterates through every sort definition
        foreach (var definition in state.SortDefinitions)
        {
            orders.AppendFormat(",{0} {1}",
                definition.SortBy,
                definition.Descending ? "DESC" : "ASC");
        }

        var filters = new StringBuilder($"({nameof(OrigamiUserActivity.SocialProfileId)} == \"{this.SocialProfile.Id}\")");

        //iterates through every filter definition
        foreach (var definition in state.FilterDefinitions)
        {
            filters.AppendFormat("&& ({0})", definition.Filter());
        }

        var orderBy = orders.ToString();

        using var db = DbContextFactory.CreateDbContext();

        var result = db.Set<OrigamiUserActivity>().AsNoTracking().Query(
            state.PageSize,
            state.Page * state.PageSize,
            filters.ToString(),
            orderBy != string.Empty ? orderBy[1..] : $"{nameof(OrigamiUserActivity.Date)} DESC"
        );

        return Task.FromResult(new GridData<OrigamiUserActivity> { Items = result.Rows, TotalItems = (int)result.NumberOfRows, });
    }

    protected void LoadInteractions()
    {
        this._userActivities?.ReloadServerData();
    }

    protected void LoadSocialProfileDeletions()
    {
        if (this.SocialProfile.Has() == false) return;

        using var db = this.DbContextFactory.CreateDbContext();

        this.SocialProfileForDeletions = db.Set<OrigamiSocialProfileDelete>().AsNoTracking()
            .Where(x => x.SocialProfileId == this.SocialProfile.Id)
            .OrderByDescending(x => x.DateCreated)
            .ToList();
    }

    /// <summary>
    /// Wipes the user's data from the website (like reactions, comments and ratings)
    /// </summary>
    private async Task WipeData()
    {
        var answer = await this.DialogService.ShowMessageBoxAsync(
            title: Text.Upper("Are you sure?"),
            message: Text.Lower("This will delete all your data from the website"),
            yesText: Text.Lower("Yes"),
            noText: Text.Lower("No")) ?? false;

        if (answer)
        {
            var context = new DataOperationContext<OrigamiSocialProfile>(new(), DateTime.UtcNow, this.UserFacade.SocialProfile);

            UserFacade.Result = this._socialProfileForDeletion.WipeDataOut(context, false);

            this.LoadSocialProfile();
            this.LoadInteractions();
            this.LoadSocialProfileDeletions();
        }
    }

    private OrigamiSubscriber? Subscriber()
    {
        return this.Super.Subscribers.ReadFromCache()
            .NonDeleted()
            .Where(x => x.SocialProfileId == this.SocialProfile.Id)
            .Where(x => x.IsVerified)
            .FirstOrDefault();
    }

    /// <summary>
    /// The user leaves the incognito mode
    /// </summary>
    private async Task LeaveIncognito()
    {
        var remove = await this.JSRuntime.InvokeAsync<bool>("$.removeCookie", "incognito-mode", new { path = "/" });
        if (remove == true) this.GhostOfTheNavigator.NavigateTo(this.GhostOfTheNavigator.Uri, true);
    }

    /// <summary>
    /// The user enters the incognito mode
    /// </summary>
    private async Task EnterIncognito()
    {
        var remove = await this.JSRuntime.InvokeAsync<bool>("$.removeCookie", "incognito-mode", new { path = "/" });
        var add = await this.JSRuntime.InvokeAsync<string>("$.cookie", "incognito-mode", 1, new { path = "/", expires = 365, });
        this.GhostOfTheNavigator.NavigateTo(this.GhostOfTheNavigator.Uri, true);
    }

    protected override void OnInitialized()
    {
        base.OnInitialized();
        this.LoadSocialProfile();
        this.LoadSocialProfileDeletions();
        this.LoadInteractions();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        base.OnAfterRender(firstRender);
        this._loadIncognitoMode(firstRender);
    }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        this._userActivities?.ReloadServerData();
    }

    private async void _loadIncognitoMode(bool firstRender)
    {
        if (firstRender)
        {
            this._incognitoMode = await this.JSRuntime.IncognitoModeAsync();
            this.StateHasChanged();
        }
    }
}
