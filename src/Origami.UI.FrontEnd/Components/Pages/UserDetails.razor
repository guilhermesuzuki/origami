@page "/users/{NanoId}"
@inherits BasicPage

<Root>
    @if (this.NanoId.Has() == true)
    {
        var user = this.GetUser();
        if (user != null)
        {
            <div class="user-details @Class">
                <div>
                    <ul class="inline-list p-3 border">
                        <li class="w-25">
                            <HeaderImageCard Entity="user"></HeaderImageCard>
                        </li>
                        <li class="p-3">
                            <ul class="inline-list">
                                <li>
                                    <MudTextField @bind-Value="user.DisplayName"
                                                  Immediate="true"
                                                  Required="true"
                                                  ReadOnly="true"
                                                  HelperText="@Text.Lower("Display name")"></MudTextField>
                                </li>
                            </ul>
                            <ul class="inline-list mt-3">
                                <li>
                                    <MudTextField @bind-Value="user.FirstName"
                                                  Immediate="true"
                                                  ReadOnly="true"
                                                  HelperText="@Text.Lower("First name")"></MudTextField>
                                </li>
                            </ul>
                            <ul class="inline-list mt-3">
                                <li>
                                    <MudTextField @bind-Value="user.LastName"
                                                  Immediate="true"
                                                  ReadOnly="true"
                                                  HelperText="@Text.Lower("Last name")"></MudTextField>
                                </li>
                            </ul>
                            <ul class="inline-list mt-3">
                                <li>
                                    <MudTextField @bind-Value="user.Website"
                                                  ReadOnly="true"
                                                  Immediate="true"
                                                  Adornment="Adornment.Start"
                                                  AdornmentIcon="@Icons.Material.Filled.Web"
                                                  HelperText="@Text.Lower("Website")"></MudTextField>
                                </li>
                            </ul>
                            <ul class="inline-list mt-3">
                                <li>
                                    <MudTextField @bind-Value="user.GitHub"
                                                  ReadOnly="true"
                                                  Immediate="true"
                                                  Adornment="Adornment.Start"
                                                  AdornmentIcon="@Icons.Custom.Brands.GitHub"
                                                  HelperText="@Text.Lower("GitHub")"></MudTextField>
                                </li>
                            </ul>
                            <ul class="inline-list mt-3">
                                <li>
                                    <MudTextField @bind-Value="user.LinkedIn"
                                                  ReadOnly="true"
                                                  Immediate="true"
                                                  Adornment="Adornment.Start"
                                                  AdornmentIcon="@Icons.Custom.Brands.LinkedIn"
                                                  HelperText="@Text.Lower("LinkedIn")"></MudTextField>
                                </li>
                            </ul>
                            <ul class="inline-list mt-3">
                                <li>
                                    <MudTextField @bind-Value="user.Facebook"
                                                  ReadOnly="true"
                                                  Immediate="true"
                                                  Adornment="Adornment.Start"
                                                  AdornmentIcon="@Icons.Custom.Brands.Facebook"
                                                  HelperText="@Text.Lower("Facebook")"></MudTextField>
                                </li>
                            </ul>
                            <ul class="inline-list mt-3">
                                <li>
                                    <MudTextField @bind-Value="user.Instagram"
                                                  ReadOnly="true"
                                                  Immediate="true"
                                                  Adornment="Adornment.Start"
                                                  AdornmentIcon="@Icons.Custom.Brands.Instagram"
                                                  HelperText="@Text.Lower("Instagram")"></MudTextField>
                                </li>
                            </ul>
                        </li>
                    </ul>
                </div>
                <div class="row">
                    <div class="col-12 col-xxl-6">
                        <div class="p-3 border mt-3">
                            <div class="w-100 text-white bg-secondary text-center">
                                <i class="bi bi-file-earmark-text-fill"></i>
                                @Text.Lower("Quick notes")
                            </div>
                            <MudDataGrid @ref="_quickNotesGrid" Class="mt-3" T="OrigamiQuickNote" ServerData="this.GetQuickNotes" Filterable="false" SortMode="SortMode.None">
                                <Columns>
                                    <TemplateColumn>
                                        <CellTemplate>
                                            <ContentHeader Entity="context.Item" ShowRelatedContent="false"></ContentHeader>
                                        </CellTemplate>
                                    </TemplateColumn>
                                </Columns>
                                <PagerContent>
                                    <MudDataGridPager T="OrigamiQuickNote" PageSizeOptions="new int[] { 5, 10, 25, }"></MudDataGridPager>
                                </PagerContent>
                            </MudDataGrid>
                        </div>
                    </div>
                    <div class="col-12 col-xxl-6">
                        <div class="p-3 border mt-3">
                            <div class="w-100 text-white bg-secondary text-center">
                                <i class="bi bi-file-earmark-text-fill"></i>
                                @Text.Lower("Pages")
                            </div>
                            <MudDataGrid @ref="_pagesGrid" Class="mt-3" T="OrigamiPage" ServerData="this.GetPages" Filterable="false" SortMode="SortMode.None">
                                <Columns>
                                    <TemplateColumn>
                                        <CellTemplate>
                                            <ContentHeader Entity="context.Item" ShowRelatedContent="false"></ContentHeader>
                                        </CellTemplate>
                                    </TemplateColumn>
                                </Columns>
                                <PagerContent>
                                    <MudDataGridPager T="OrigamiPage" PageSizeOptions="new int[] { 5, 10, 25, }"></MudDataGridPager>
                                </PagerContent>
                            </MudDataGrid>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-12 col-xxl-6">
                        <div class="p-3 border mt-3">
                            <div class="w-100 text-white bg-secondary text-center">
                                <i class="bi bi-file-earmark-text-fill"></i>
                                @Text.Lower("Posts")
                            </div>
                            <MudDataGrid @ref="_postsGrid" Class="mt-3" T="OrigamiPost" ServerData="this.GetPosts" Filterable="false" SortMode="SortMode.None">
                                <Columns>
                                    <TemplateColumn>
                                        <CellTemplate>
                                            <ContentHeader Entity="context.Item"></ContentHeader>
                                        </CellTemplate>
                                    </TemplateColumn>
                                </Columns>
                                <PagerContent>
                                    <MudDataGridPager T="OrigamiPost" PageSizeOptions="new int[] { 5, 10, 25, }"></MudDataGridPager>
                                </PagerContent>
                            </MudDataGrid>
                        </div>
                    </div>
                    <div class="col-12 col-xxl-6">
                        <div class="p-3 border mt-3">
                            <div class="w-100 text-white bg-secondary text-center">
                                <i class="fa-solid fa-video"></i>
                                @Text.Lower("Videos")
                            </div>
                            <MudDataGrid @ref="_videosGrid" Class="mt-3" T="OrigamiVideo" ServerData="this.GetVideos" Filterable="false" SortMode="SortMode.None">
                                <Columns>
                                    <TemplateColumn>
                                        <CellTemplate>
                                            <ContentHeader Entity="context.Item"></ContentHeader>
                                        </CellTemplate>
                                    </TemplateColumn>
                                </Columns>
                                <PagerContent>
                                    <MudDataGridPager T="OrigamiVideo" PageSizeOptions="new int[] { 5, 10, 25, }"></MudDataGridPager>
                                </PagerContent>
                            </MudDataGrid>
                        </div>
                    </div>
                </div>
            </div>
        }
        else
        {
            <NothingToSeeHere></NothingToSeeHere>
        }
    }
</Root>

    @code {
    [Parameter] public string NanoId { get; set; } = string.Empty;

    protected MudDataGrid<OrigamiPage> _pagesGrid = new();
    protected MudDataGrid<OrigamiPost> _postsGrid = new();
    protected MudDataGrid<OrigamiQuickNote> _quickNotesGrid = new();
    protected MudDataGrid<OrigamiVideo> _videosGrid = new();

    /// <summary>
    /// This method should retrieve the Entities from database or memory
    /// </summary>
    /// <param name="state"></param>
    /// <param name="token"></param>
    /// <returns></returns>
    protected virtual Task<GridData<Core.Models.OrigamiPage>> GetPages(GridState<Core.Models.OrigamiPage> state, CancellationToken token)
    {
        var orders = new StringBuilder();

        //iterates through every sort definition
        foreach (var definition in state.SortDefinitions)
        {
            orders.AppendFormat(",{0} {1}", definition.SortBy, definition.Descending ? "DESC" : "ASC");
        }

        var filters = new StringBuilder($"{nameof(Core.Models.OrigamiPage.AuthorId)} == \"{GetUser().Id}\"");

        //iterates through every filter definition
        foreach (var definition in state.FilterDefinitions)
        {
            filters.AppendFormat(" && ({0})", definition.Filter());
        }

        var orderBy = orders.ToString();

        //pulls information from cache
        var result = this.Super.Contents.ReadFromCache().OfType<OrigamiPage>().Published().Query(
            state.PageSize,
            state.Page * state.PageSize,
            filters.ToString(),
            orderBy != string.Empty ? orderBy[1..] : $"{nameof(Core.Models.OrigamiPage.Title)}"
        );

        return Task.FromResult(new GridData<Core.Models.OrigamiPage> { Items = result.Rows, TotalItems = result.NumberOfRows, });
    }

    /// <summary>
    /// This method should retrieve the Entities from database or memory
    /// </summary>
    /// <param name="state"></param>
    /// <param name="token"></param>
    /// <returns></returns>
    protected virtual Task<GridData<OrigamiPost>> GetPosts(GridState<OrigamiPost> state, CancellationToken token)
    {
        var orders = new StringBuilder();

        //iterates through every sort definition
        foreach (var definition in state.SortDefinitions)
        {
            orders.AppendFormat(",{0} {1}", definition.SortBy, definition.Descending ? "DESC" : "ASC");
        }

        var filters = new StringBuilder($"{nameof(OrigamiPost.AuthorId)} == \"{GetUser().Id}\"");

        //iterates through every filter definition
        foreach (var definition in state.FilterDefinitions)
        {
            filters.AppendFormat(" && ({0})", definition.Filter());
        }

        var orderBy = orders.ToString();

        //pulls information from cache
        var result = this.Super.Contents.ReadFromCache().OfType<OrigamiPost>().Published().Query(
            state.PageSize,
            state.Page * state.PageSize,
            filters.ToString(),
            orderBy != string.Empty ? orderBy[1..] : $"{nameof(OrigamiPost.DateCreated)} DESC"
        );

        return Task.FromResult(new GridData<OrigamiPost> { Items = result.Rows, TotalItems = result.NumberOfRows, });
    }

    /// <summary>
    /// This method should retrieve the Entities from database or memory
    /// </summary>
    /// <param name="state"></param>
    /// <param name="token"></param>
    /// <returns></returns>
    protected virtual Task<GridData<OrigamiVideo>> GetVideos(GridState<OrigamiVideo> state, CancellationToken token)
    {
        var orders = new StringBuilder();

        //iterates through every sort definition
        foreach (var definition in state.SortDefinitions)
        {
            orders.AppendFormat(",{0} {1}", definition.SortBy, definition.Descending ? "DESC" : "ASC");
        }

        var filters = new StringBuilder($"{nameof(OrigamiVideo.AuthorId)} == \"{GetUser().Id}\"");

        //iterates through every filter definition
        foreach (var definition in state.FilterDefinitions)
        {
            filters.AppendFormat(" && ({0})", definition.Filter());
        }

        var orderBy = orders.ToString();

        //pulls information from cache
        var result = this.Super.Contents.ReadFromCache().OfType<OrigamiVideo>().Published().Query(
            state.PageSize,
            state.Page * state.PageSize,
            filters.ToString(),
            orderBy != string.Empty ? orderBy[1..] : $"{nameof(OrigamiVideo.DateCreated)} DESC"
        );

        return Task.FromResult(new GridData<OrigamiVideo> { Items = result.Rows, TotalItems = result.NumberOfRows, });
    }

    /// <summary>
    /// This method should retrieve the Entities from database or memory
    /// </summary>
    /// <param name="state"></param>
    /// <param name="token"></param>
    /// <returns></returns>
    protected virtual Task<GridData<Core.Models.OrigamiQuickNote>> GetQuickNotes(GridState<Core.Models.OrigamiQuickNote> state, CancellationToken token)
    {
        var orders = new StringBuilder();

        //iterates through every sort definition
        foreach (var definition in state.SortDefinitions)
        {
            orders.AppendFormat(",{0} {1}", definition.SortBy, definition.Descending ? "DESC" : "ASC");
        }

        var filters = new StringBuilder($"{nameof(Core.Models.OrigamiQuickNote.AuthorId)} == \"{GetUser().Id}\"");

        //iterates through every filter definition
        foreach (var definition in state.FilterDefinitions)
        {
            filters.AppendFormat(" && ({0})", definition.Filter());
        }

        var orderBy = orders.ToString();

        //pulls information from cache
        var result = this.Super.Contents.ReadFromCache().OfType<OrigamiQuickNote>().Published().Query(
            state.PageSize,
            state.Page * state.PageSize,
            filters.ToString(),
            orderBy != string.Empty ? orderBy[1..] : $"{nameof(Core.Models.OrigamiQuickNote.Title)}"
        );

        return Task.FromResult(new GridData<Core.Models.OrigamiQuickNote> { Items = result.Rows, TotalItems = result.NumberOfRows, });
    }

    protected OrigamiUser GetUser()
    {
        return this.Super.Users.ReadFromCache().NanoId(this.NanoId) ?? new();
    }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        this._pagesGrid.ReloadServerData();
        this._postsGrid.ReloadServerData();
        this._videosGrid.ReloadServerData();
    }
}
