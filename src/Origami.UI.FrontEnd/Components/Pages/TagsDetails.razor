@inherits BasicPage
@implements IItems<OrigamiContent>
@implements IEntityNull<OrigamiContent>
@page "/blogs/{BlogSlug}/tags/{Tag}"
@page "/blogs/{BlogSlug}/tags/{Tag}/{ContentNanoId}"

<Root>
    <style>
        .header .tag-header { border: none !important; box-shadow: none !important; }
        .header .tag-header i { font-size: 80px !important; }
        .header .tag-header .name { font-size: xx-large !important; }
    </style>
    @if (this.Entity != null)
    {
        <HeadContent>
            <meta property="og:title" content="@Tag • @Entity.Title" />
            <meta property="og:description" content="@Entity.Description" />
            <meta property="og:image" content="@(GhostOfTheNavigator.BaseUri.TrimEnd('/') + Entity.Get().HeaderImage.NoHeader())" />
            <meta property="og:url" content="@GhostOfTheNavigator.BaseUri.TrimEnd('/')/tags/@Tag/@Entity.NanoId" />
        </HeadContent>
    }
    <div class="tag-details @Class">
        <div class="header mb-3">
            <ContentTagHeader Class="cursor-pointer" Entity="this.GetTag()"></ContentTagHeader>
        </div>
        @if (this.Items.Count > 0)
        {
            <div class="overflow-auto pb-1">
                <table>
                    <tr>
                        @foreach (var content in Items)
                        {
                            <td>
                                <div class="pe-1" style="width:300px;">
                                    <ContentHeader Class="@(this.Entity == content ? "selected" : null)" Tag="@this.GetTag()" Entity="content"></ContentHeader>
                                </div>
                            </td>
                        }
                    </tr>
                </table>
            </div>
        }
        @if (this.Entity != null)
        {
            <ContentDetails OpenGraphMetaTags="false" Class="mt-3" Tag="@this.GetTag()" Entity="this.Entity"></ContentDetails>
        }
        @if (this.Items.Count == 0)
        {
            <NothingToSeeHere></NothingToSeeHere>
        }
    </div>
</Root>

@code {
    [Parameter] public string ContentNanoId { get; set; } = string.Empty;
    [Parameter] public string Tag { get; set; } = string.Empty;

    /// <summary>
    /// List of Content [Post-Tags,Video-Tags] from the Category
    /// </summary>
    public List<OrigamiContent> Items { get; set; } = new();

    /// <summary>
    /// Main Content (the one being displayed)
    /// </summary>
    public OrigamiContent? Entity { get; set; }

    /// <summary>
    /// Core.Tag
    /// </summary>
    private OrigamiContentTag GetTag()
    {
        var blog = this.GetBlogFromSlug();

        var tags = from a in this.Super.ContentTags.ReadFromCache()
                   join b in this.Super.Contents.ReadFromCache().Blog(blog.Id) on a.ContentId equals b.Id
                   where a.Slug == this.Tag
                   select a;

        return tags.FirstOrDefault() ?? new();
    }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        this.LoadFromTag();
        this.LoadContent();
        this.BlogId = this.GetBlogFromSlug().Id;
    }

    protected void LoadFromTag()
    {
        var tag = this.GetTag();
        Items = new();
        Items.AddRange(this.Super.GetContents(tag, this.BlogId).Published());
        Items = Items.DistinctBy(x => x.Id).OrderBy(x => x.Title).ToList();
    }

    protected void LoadContent()
    {
        if (this.ContentNanoId.Has() == false) this.Entity = Items.FirstOrDefault();
        if (this.ContentNanoId.Has() == true) this.Entity = Items.NanoId(this.ContentNanoId);
    }

    protected override void SetPageTitle()
    {
        this.PageTitle.SetTitle(GetTag(), this.Entity);
    }
}
