@page "/blogs/{BlogSlug}/categories"
@inherits BasicPage

<Root>
    @if (this._blog != null)
    {
        var categories = this.Super.GetCategories().Blog(this._blog.Id);
        <div class="categories pb-3">
            <BlogHeaderLite Class="text-center fs-1" Entity="_blog"></BlogHeaderLite>
            <div class="mt-3">
                <div class="row">
                    @if (categories.Any() == true)
                    {
                        @foreach (var category in categories)
                        {
                            <div class="col-12 col-xl-3 cursor-pointer">
                                <CategoryHeader Class="mb-3" Entity="category"></CategoryHeader>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="col-12">
                            <NothingToSeeHere Class="p-3 border shadow-sm" Subtitle="@Text.Lower("No categories whatsoever")"></NothingToSeeHere>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</Root>

@code {
    private OrigamiBlog _blog => this.GetBlogFromSlug();
    protected override void SetPageTitle() => this.PageTitle.SetTitle(Text.Get("Categories"));
}