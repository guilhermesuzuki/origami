@page "/cache/explorer"
@using Microsoft.Extensions.Caching.Memory
@using System.Collections
@inherits Basic

<Root>
    <AuthorizeView>
        <Authorized>
            @if (UserFacade.SocialProfile.IsModerator == true)
            {
                <div class="mb-3">
                    <button class="p-3 w-100 text-white bg-danger fw-bold" @onclick="ResetCache">@Text.Upper("Clear cache")</button>
                </div>
            }
        </Authorized>
    </AuthorizeView>
    <div class="row">
        <div class="cache-explorer col-12">
            <MudDataGrid T="KeyValuePair<object, object>" Items="this.GetEntries()" Filterable="false" SortMode="SortMode.None" Class="border selectable" MultiSelection="true" Bordered="true" SelectOnRowClick="false">
                <Columns>
                    <TemplateColumn Title="@Text.Upper("Key")">
                        <CellTemplate>
                            <span>@context.Item.Key</span>
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="@Text.Upper("Value")">
                        <CellTemplate>
                            <span class="me-1">@context.Item.Value</span>
                            @if (context.Item.Value is IList list)
                            {
                                <span class="p-1 shadow-sm border">@list.Count @Text.Lower("item(s)")</span>
                            }
                        </CellTemplate>
                    </TemplateColumn>
                </Columns>
                <PagerContent>
                    <MudDataGridPager T="KeyValuePair<object, object>" PageSizeOptions="new int[] { 25, 50, 100, }" />
                </PagerContent>
                <NoRecordsContent>
                    <NoEntriesWereFound></NoEntriesWereFound>
                </NoRecordsContent>
            </MudDataGrid>
        </div>
    </div>
</Root>

@code {
    protected IDictionary<object, object?> GetEntries()
    {
        var result = new Dictionary<object, object?>();

        foreach (var key in this.MemoryCache.Keys.OrderBy(x => x.ToString()))
        {
            result[key] = this.MemoryCache.Get(key);
        }

        return result;
    }

    protected async Task ResetCache()
    {
        var yes = await DialogService.ShowMessageBoxAsync(
            Text.Upper("Clear cache"),
            Text.Lower("Are you sure?"),
            Text.Lower("Yes"),
            Text.Lower("No")
        );

        if (yes == true)
        {
            this.Super.RefreshAllRepositories();
            this.Super.RefreshAllSearchIndexes();
        }
    }
}
