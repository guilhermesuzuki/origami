@page "/"
@page "/blogs/{BlogSlug}"
@inherits BasicPage
<Root>
    <HeadContent>
        <meta property="og:title" content="@PageTitle.GetTitle()" />
        <meta property="og:description" content="@this.Super.Settings.GetSettings().Description" />
        <meta property="og:image" content="@this.Super.Settings.GetSettings().LogoUrl" />
    </HeadContent>
    @if (this.Super.EmptyHome(BlogId) == true)
    {
        <NothingToSeeHere Class="p-3 border shadow-sm" Subtitle="@Text.Lower("No content for now")"></NothingToSeeHere>
    }
    else
    {
        <FrontPage BlogId="this.BlogId" Class="mb-6"></FrontPage>
        <QuickNoteList BlogId="this.BlogId" Class="mb-6" Page="this.QuickNotePage"></QuickNoteList>
        <ContentMostPopular BlogId="this.BlogId" Class="mb-6"></ContentMostPopular>
        <ContentList BlogId="this.BlogId" Class="mb-6" Page="this.ContentPage"></ContentList>
    }
    </Root>
@code {
    protected int ContentPage { get; set; } = 1;
    protected int QuickNotePage { get; set; } = 1;

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        this.BlogId = this.GetBlogFromSlug().Id;
    }
}