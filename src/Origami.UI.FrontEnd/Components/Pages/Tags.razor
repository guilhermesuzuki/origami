@page "/blogs/{BlogSlug}/tags"
@inherits BasicPage
@inject ISuperRepository _super

<Root>
    @if (this._blog != null)
    {
        var tags = this._super.Tags.ReadFromCache().Blog(_blog.Id);
        <div class="tags pb-3">
            <BlogHeaderLite Class="text-center fs-1" Entity="_blog" DisplayBlogNameEvenWithoutHeaderImage="false"></BlogHeaderLite>
            <div class="mt-3">
                <div class="row">
                    @if (tags.Any() == true)
                    {
                        @foreach (var tag in tags)
                        {
                            <div class="col-12 col-xl-3 cursor-pointer">
                                <TagHeader Class="mb-3" Entity="tag"></TagHeader>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="col-12">
                            <NothingToSeeHere Class="p-3 border shadow-sm" Subtitle="@Text.Lower("No tags whatsoever")"></NothingToSeeHere>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</Root>

@code {
    private OrigamiBlog _blog => this.GetBlogFromSlug();

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        this.BlogId = this._blog.Id;
    }

    protected override void SetPageTitle()
    {
        this.PageTitle.SetTitle(Text.Original("Tags"));
    }
}