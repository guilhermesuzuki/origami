@inherits BasicPage
@implements IItems<BaseContent>
@implements IEntityNull<BaseContent>

@page "/blogs/{Slug}/categories/{Category}"
@page "/blogs/{Slug}/categories/{Category}/{ContentNanoId}"

@inject ICategoryRepository _category
@inject IPostCategoryRepository _postCategory
@inject IVideoCategoryRepository _videoCategory

<Root>
    <style>
        .header .category-header { border: none !important; box-shadow: none !important; }
        .header .category-header img { height: 80px !important; }
        .header .category-header .name { font-size: xx-large !important; }
    </style>
    @if (this.Entity is OrigamiPost _post)
    {
        <HeadContent>
            <meta property="og:title" content="@Category • @_post.Title" />
            <meta property="og:description" content="@_post.Description" />
            <meta property="og:image" content="@(NavigationManager!.BaseUri.TrimEnd('/') + _post.Get().HeaderImage.NoHeader())" />
            <meta property="og:url" content="@NavigationManager!.BaseUri.TrimEnd('/')/categories/@Category/@_post.NanoId" />
        </HeadContent>
    }
    @if (this.Entity is OrigamiVideo _video)
    {
        <HeadContent>
            <meta property="og:title" content="@Category • @_video.Title" />
            <meta property="og:description" content="@_video.Description" />
            <meta property="og:image" content="@(NavigationManager!.BaseUri.TrimEnd('/') + _video.Get().HeaderImage.NoHeader())" />
            <meta property="og:url" content="@NavigationManager!.BaseUri.TrimEnd('/')/categories/@Category/@_video.NanoId" />
        </HeadContent>
    }
    <div class="category-details @Class">
        <div class="header mb-3">
            <CategoryHeader Class="cursor-pointer" Entity="this.GetCategory()"></CategoryHeader>
        </div>
        @if (this.Items.Count > 0)
        {
            <div class="overflow-auto pb-1">
                <table>
                    <tr>
                        @foreach (var content in Items)
                        {
                            <td>
                                <div class="pe-1" style="width:300px;">
                                    @if (content is OrigamiPost postHeader)
                                    {
                                        <PostHeader Class="@(this.Entity == postHeader ? "selected" : null)" Category="@this.GetCategory()" Entity="postHeader"></PostHeader>
                                    }
                                    @if (content is OrigamiVideo videoHeader)
                                    {
                                        <VideoHeader Class="@(this.Entity == videoHeader ? "selected" : null)" Category="@this.GetCategory()" Entity="videoHeader"></VideoHeader>
                                    }
                                </div>
                            </td>
                        }
                    </tr>
                </table>
            </div>
        }
        @if (this.Entity != null && this.Entity is OrigamiPost post)
        {
            <PostsDetails OpenGraphMetaTags="false" Class="mt-3" Category="@this.GetCategory()" Post="post"></PostsDetails>
        }
        @if (this.Entity != null && this.Entity is OrigamiVideo video)
        {
            <VideosDetails OpenGraphMetaTags="false" Class="mt-3" Category="@this.GetCategory()" Video="video"></VideosDetails>
        }
        @if (this.Items.Count == 0)
        {
            <NothingToSeeHere></NothingToSeeHere>
        }
    </div>
</Root>

@code {
    [Parameter] public string Category { get; set; } = string.Empty;
    [Parameter] public string Slug { get; set; } = string.Empty;
    [Parameter] public string ContentNanoId { get; set; } = string.Empty;

    /// <summary>
    /// List of Posts from the Category
    /// </summary>
    public List<BaseContent> Items { get; set; } = new();

    /// <summary>
    /// Main Post (the one being displayed)
    /// </summary>
    public BaseContent? Entity { get; set; }

    /// <summary>
    /// Retrieves the blog from the given slug
    /// </summary>
    /// <returns></returns>
    private OrigamiBlog GetBlog()
    {
        return this.Super.Blogs.ReadFromCache().Slug(this.Slug) ?? new();
    }

    /// <summary>
    /// Core.Category
    /// </summary>
    private OrigamiCategory GetCategory()
    {
        var blog = this.GetBlog();
        return this.Super.Categories.ReadFromCache().Blog(blog.Id).Slug(Category) ?? new();
    }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        this.LoadFromCategory();
        this.LoadContent();
    }

    protected void LoadFromCategory()
    {
        Items = new();
        var category = this.GetCategory();
        Items.AddRange(this.Super.GetPosts(category).Published());
        Items.AddRange(this.Super.GetVideos(category).Published());
        Items = Items.DistinctBy(x => x.Id).OrderBy(x => x.Title).ToList();
    }

    protected void LoadContent()
    {
        if (this.ContentNanoId.Has() == false) this.Entity = Items.FirstOrDefault();
        if (this.ContentNanoId.Has() == true) this.Entity = Items.NanoId(this.ContentNanoId);
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        this.PageTitle.SetTitle(this.GetCategory(), this.Entity);
        return base.OnAfterRenderAsync(firstRender);
    }

    public override Guid BlogId => this.GetBlog().Id;
}
