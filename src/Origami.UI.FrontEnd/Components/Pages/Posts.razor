@page "/blogs/{Slug}/posts"
@inherits BasicPage
@inject ISuperRepository _super

<Root>
    <BlogHeaderLite2 Class="text-center fs-1" Entity="this.GetBlog()" DisplayBlogNameEvenWithoutHeaderImage="false"></BlogHeaderLite2>
    <PostList Class="mt-3" BlogId="@BlogId" Page="@Page" ShowFakes="true"></PostList>
</Root>

@code {
    [Parameter] public string Slug { get; set; } = string.Empty;
    [Parameter] public int Page { get; set; } = 1;

    /// <summary>
    /// Blog ID based on the provided slug.
    /// </summary>
    private OrigamiBlog GetBlog() => _super.Blogs.ReadFromCache().Slug(Slug) ?? new();

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        this.BlogId = this.GetBlog().Id;
    }
}
