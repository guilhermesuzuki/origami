@page "/blogs/{BlogSlug}/pages"
@inherits BasicPage

<Root>
    <BlogHeader Class="text-center fs-1" Entity="this.GetBlogFromSlug()"></BlogHeader>
    <PageList Class="mt-3" BlogId="@this.BlogId" Page="@Page"></PageList>
</Root>

@code {
    [Parameter] public int Page { get; set; } = 1;

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        this.BlogId = this.GetBlogFromSlug().Id;
    }

    protected override void SetPageTitle()
    {
        this.PageTitle.SetTitle(Text.Get("Pages"));
    }
}
