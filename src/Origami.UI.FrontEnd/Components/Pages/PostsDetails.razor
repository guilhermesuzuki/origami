@page "/posts/{NanoId}"
@inherits BasicPage

@using Microsoft.AspNetCore.Authentication.Google;
@using Microsoft.AspNetCore.Identity;
@using System.Text;
@using Microsoft.Extensions.Options;

@inject IPostRatingRepository _postRating
@inject IPostCommentRepository _postComment

<Root>
    @if (this._post.New == false)
    {
        var whatToSeeNext = this.Super.WhatToSeeNext.GetWhatToSeeNext(this._post).Take(3).OrderBy(x => x.Title);
        var whatToSeeNextTitle = this.Super.WhatToSeeNext.GetWhatToSeeNextTitle(this._post).Take(3).Concat(whatToSeeNext);
        @if (OpenGraphMetaTags)
        {
            <HeadContent>
                <meta property="og:title" content="@_post.Title" />
                <meta property="og:description" content="@_post.Description" />
                <meta property="og:image" content="@(NavigationManager!.BaseUri.TrimEnd('/') + _post.Get().HeaderImage.NoHeader())" />
                <meta property="og:url" content="@NavigationManager!.BaseUri.TrimEnd('/')/posts/@_post.NanoId" />
            </HeadContent>
        }
        <div class="post-details @Class">
            <PostHeader Category="@Category" Tag="@Tag" Entity="@_post" OnUserHasRated="() => this.StateHasChanged()"></PostHeader>
            <div class="post-content mt-3 p-4 border shadow-lg">
                @if (_post!.Content.Has() == true)
                {
                    @((MarkupString)_post!.Content)
                }
                else
                {
                    <p class="fs-2 w-100 text-center">
                        <i class="fa-solid fa-quote-left"></i>
                        @Text.Lower("No text from this post")
                        <i class="fa-solid fa-quote-right"></i>
                    </p>
                }
            </div>
            <div class="post-what-to-see-next mt-3 p-4 border shadow-lg">
                <label class="w-100 text-center fs-3">
                    <i class="fa-solid fa-rectangle-list"></i>
                    @Text.Lower("What to see next")
                    <i class="fa-solid fa-rectangle-list"></i>
                </label>
                <WhatToSeeNext Class="mt-5" Entity="whatToSeeNextTitle"></WhatToSeeNext>
            </div>
            <div class="post-ratings-frame mt-3 p-4 border shadow-lg">
                <PostRatings Post="this._post"></PostRatings>
            </div>
            <div class="post-comments-frame mt-3 p-4 border shadow-lg">
                <label class="w-100 text-center fs-3">
                    <i class="fa-solid fa-comment"></i>
                    @Text.Lower("Comment section")
                    <i class="fa-solid fa-comment"></i>
                </label>
                @if (this._post.IsCommentEnabled == true)
                {
                    <div class="row mt-5">
                        <div class="col-12 col-xl-6">
                            <label class="w-100 text-center fs-4">
                                @Text.Lower("Place your comment here")
                                @if (UserFacade.SocialProfile.New)
                                {
                                    <span>, @Text.Lower("But login first")</span>
                                }
                            </label>
                            <div class="mt-3 position-sticky" style="top: 1rem;">
                                <Login></Login>
                                <AuthorizeView>
                                    <Authorized>
                                        @if (NewComment.ParentId != null)
                                        {
                                            var parent = this.Super.PostComments.ReadFromCache().FirstOrDefault(x => x.Id == NewComment.ParentId);
                                            @if (parent != null)
                                            {
                                                var socialProfile = this.Super.SocialProfiles.ReadFromCache().Id(parent.SocialProfileId);
                                                <div class="post-comment-in-reply-to p-2 mt-2 mb-2 position-relative">
                                                    <SocialProfileHeaderLite Entity="socialProfile"></SocialProfileHeaderLite>
                                                    <div class="post-comment-text">@((MarkupString)parent.Content)</div>
                                                    <button class="position-absolute fw-bold p-2" style="top: 0; right: 0; bottom: 0;" @onclick="() => NewComment.ParentId = null">x</button>
                                                </div>
                                            }
                                        }
                                        <div class="new-comment mt-3">
                                            <TinyMCEComment Entity="this.NewComment"></TinyMCEComment>
                                            <div class="new-comment-actions mt-2 text-right">
                                                <button class="btn btn-light border" disabled="@this._disableSendCommentButton()" @onclick="() => this.CreateComment()">
                                                    <i class="fa-solid fa-paper-plane pe-1"></i>
                                                    @Text.Lower("Add comment")
                                                </button>
                                            </div>
                                        </div>
                                    </Authorized>
                                </AuthorizeView>
                            </div>
                        </div>
                        <div class="col-12 col-xl-6">
                            @if (_comments.Count == 0)
                            {
                                <label class="w-100 text-center mb-3 fs-4">
                                    <i class="fa-solid fa-face-smile-wink"></i>
                                    @Text.Lower("Be the first to comment")
                                </label>
                            }
                            else
                            {
                                <label class="w-100 text-center mb-3 fs-4">@Text.Lower("{0} comment(s)", _comments.Count)</label>
                                <PostComments Comments="this._comments" PageSize="@this._pageSize" CurrentPage="@_currentPage" OnCommentUpdated="this._onCommentUpdated" OnCommentDeleted="this._onCommentDeleted" OnCurrentPageChanged="(page) => this._currentPage = page" OnCommentReply="(comment) => { this.NewComment.ParentId = comment.Id; }"></PostComments>
                            }
                        </div>
                    </div>
                }
                else
                {
                    <div class="row mt-5">
                        <NothingToSeeHere Class="shadow-none"></NothingToSeeHere>
                    </div>
                }
            </div>
        </div>
    }
    else
    {
        <NothingToSeeHere></NothingToSeeHere>
    }
</Root>

    @code {
    [Parameter] public OrigamiTag? Tag { get; set; }
    [Parameter] public OrigamiCategory? Category { get; set; }
    [Parameter] public OrigamiPost? Post { get; set; }
    [Parameter] public string NanoId { get; set; } = string.Empty;
    [Parameter] public bool OpenGraphMetaTags { get; set; } = true;

    /// <summary>
    /// For New Comments
    /// </summary>
    private OrigamiPostComment NewComment = new();

    /// <summary>
    /// Current Post
    /// </summary>
    private OrigamiPost _post = new();

    /// <summary>
    /// Comments for the Post
    /// </summary>
    public List<OrigamiPostComment> _comments = new();

    private int _currentPage = 1;
    private int _pageSize = 10;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        this.NewComment.Changed += (sender, e) => this.InvokeAsync(this.StateHasChanged);
    }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        this._post = this.Post ?? this.Super.Posts.ReadFromCache().Published().NanoId(NanoId) ?? new();
        this._comments = this._postComment.AllComments(_post);
        this.BlogId = this._post.BlogId;
    }

    private void CreateComment()
    {
        this.NewComment.IsApproved = true;
        this.NewComment.Id = Guid.NewGuid();
        this.NewComment.PostId = this._post.Id;
        this.NewComment.DateCreated = DateTime.UtcNow;
        this.NewComment.SocialProfileId = UserFacade.SocialProfile.Id;

        var context = new DataOperationContextFrontEnd<OrigamiPostComment>(UserFacade.SocialProfile, DateTime.UtcNow, this.NewComment);
        var hub = this._postComment.SmartCreate(context);

        hub.OnSuccess(() => this._comments = this._postComment.AllComments(_post));

        this.NewComment = new();
        this.NewComment.Changed += (sender, e) => this.InvokeAsync(this.StateHasChanged);

        UserFacade.Result = hub;
    }

    private bool _disableSendCommentButton()
    {
        return this.NewComment.Content.Has() == false;
    }

    private void _onCommentUpdated(OrigamiPostComment comment)
    {
        this._comments = this._postComment.AllComments(_post);
    }

    private void _onCommentDeleted(OrigamiPostComment comment)
    {
        this._comments = this._postComment.AllComments(_post);
    }

    protected override async Task PageViewAsync(bool firstRender)
    {
        if (firstRender)
        {
            if (await this.JSRuntime.IncognitoModeAsync() == true) return;
            await this.JSRuntime.InvokeVoidAsync("origami.posts.view", this._post.Id);
            await this.InvokeAsync(this.StateHasChanged);
        }
    }

    protected override void SetPageTitle()
    {
        this.PageTitle.SetTitle(Tag, Category, _post);
    }
}
