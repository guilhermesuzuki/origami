@page "/pages/{NanoId}"
@inherits BasicPage

@using Microsoft.AspNetCore.Authentication.Google;
@using Microsoft.AspNetCore.Identity;
@using System.Text;
@using Microsoft.Extensions.Options;

<Root>
    @if (this._page.New == false)
    {
        <div class="page-details @Class">
            <PageHeader Entity="_page"></PageHeader>
            <PageContent Class="mt-3 p-4 border shadow-sm" Entity="_page"></PageContent>
        </div>
    }
    else
    {
        <NothingToSeeHere></NothingToSeeHere>
    }
</Root>

    @code {
    [Parameter] public string NanoId { get; set; } = string.Empty;
    [Parameter] public Core.Models.OrigamiPage? Page { get; set; }

    /// <summary>
    /// Current Page
    /// </summary>
    private Core.Models.OrigamiPage _page = new();

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        this._page = this.Page ?? this.Super.Contents.ReadFromCache().OfType<OrigamiPage>().Published().NanoId(NanoId) ?? new();
    }

    protected override async Task PageViewAsync(bool firstRender)
    {
        if (firstRender)
        {
            if (this.UserFacade.IncognitoMode == false)
            {
                var uri = new Uri(NavigationManager.Uri);
                await JSRuntime.InvokeVoidAsync("origami.physicalpages.viewByContent", uri.AbsolutePath, nameof(OrigamiPage), this._page.Id);
            }
        }
    }

    protected override void SetPageTitle()
    {
        this.PageTitle.SetTitle(this._page);
    }
}
