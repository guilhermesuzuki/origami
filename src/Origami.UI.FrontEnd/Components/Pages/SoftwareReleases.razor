@page "/softwarereleases"
@inherits BasicPage

@{
    var softwareReleases = this.Super.GetSoftwareReleases(this.UserFacade.BlogId);
}

@foreach (var release in softwareReleases)
{
    <div class="mb-3">
        <ContentDetails Entity="release" ShouldSetPageTitle="false"></ContentDetails>
    </div>
    <div class="p-3"></div>
}

@code {
    protected override void SetPageTitle()
    {
        this.PageTitle.SetTitle(Text.Original("Software releases"));
    }
}
