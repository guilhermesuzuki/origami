@page "/software-releases"
@inherits BasicPage

<style>
    .content-comments { display: none!important;}
</style>

@{
    var softwareReleases = this.Super.GetSoftwareReleases();
}

@foreach (var release in softwareReleases)
{
    <div class="mb-3">
        <ContentDetails Entity="release"></ContentDetails>
    </div>
    <div class="p-3"></div>
}

@code {
    protected override void SetPageTitle()
    {
        this.PageTitle.SetTitle(Text.Original("Software releases"));
    }
}
