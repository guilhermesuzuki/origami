@page "/oops/{SocialNetwork}"

@inherits Basic

<div class="oops text-center">
    <i class="fa-solid fa-face-grin-beam-sweat" style="font-size: 36pt;"></i>
    <h1>@Text.Lower("Oops")!</h1>
    @if (this.UserHasBeenBlocked)
    {
        <span class="fs-3">
            @((MarkupString)Text.Get("You are seeing this page, because <b>your user has been blocked</b>", Text.Styles.Original)).<br />
            @((MarkupString)Text.Get("Contact an administrator to solve this issue", Text.Styles.Original)).
        </span>
    }
    else if (this.InvalidAccessToken)
    {
        <span class="fs-3">
            @((MarkupString)Text.Get("You are seeing this page, because <b>your access token is invalid/expired</b>", Text.Styles.Original)).<br />
            @((MarkupString)Text.Get("Try again to solve this issue", Text.Styles.Original)).
        </span>
    }
    else
    {
        <span class="fs-3">
            @((MarkupString)Text.Get("You are seeing this page, because <b>you denied access to your information from the Social Network</b>", Text.Styles.Original)).<br />
            @((MarkupString)Text.Get("You need to allow access to it when prompted to solve this issue", Text.Styles.Original)).
        </span>
    }
    <br />
    <br />
    <a class="fs-3" href="/" style="border-bottom: 1px solid var(--site-highlight);">@Text.Get("Anyway, click here to go back to the Website", Text.Styles.Original)</a>
</div>

@code {
    [Parameter] public string SocialNetwork { get; set; } = string.Empty;

    /// <summary>
    /// Which error we are talking about
    /// </summary>
    protected string Error = string.Empty;

    /// <summary>
    /// Loads the error from the QueryString
    /// </summary>
    protected void LoadError()
    {
        this.Error = this.GhostOfTheNavigator.Uri.QueryString("error");
    }

    protected override void OnInitialized()
    {
        base.OnInitialized();
        this.LoadError();
    }

    public bool UserHasBeenBlocked => this.Error.Like("User has been Blocked");
    public bool InvalidAccessToken => this.Error.Like($"Invalid {SocialNetwork} Token");
}
