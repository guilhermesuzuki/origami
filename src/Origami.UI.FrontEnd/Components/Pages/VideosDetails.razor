@page "/videos/{NanoId}"
@inherits BasicPage

@using Microsoft.AspNetCore.Authentication.Google;
@using Microsoft.AspNetCore.Identity;
@using System.Text;
@using Microsoft.Extensions.Options;

<Root>
    <style>
        .no-video { display: none; }
    </style>
    @if (this._video.New == false)
    {
        var whatToSeeNext = Super.WhatToSeeNext.GetWhatToSeeNext(this._video).Take(3).OrderBy(x => x.Title);
        var whatToSeeNextTitle = Super.WhatToSeeNext.GetWhatToSeeNextTitle(this._video).Take(3).Concat(whatToSeeNext);
        @if (OpenGraphMetaTags)
        {
            <HeadContent>
                <meta property="og:title" content="@_video.Title" />
                <meta property="og:description" content="@_video.Description" />
                <meta property="og:image" content="@(NavigationManager.BaseUri.TrimEnd('/') + _video.Get().HeaderImage.NoHeader())" />
                <meta property="og:url" content="@NavigationManager.BaseUri.TrimEnd('/')/videos/@_video.NanoId" />
            </HeadContent>
        }
        <div class="video-details @Class">
            @if (_video.EmbedIFrame.IsIFrame() == true)
            {
                <div class="video-iframe embed-iframe mb-3">
                    @_video.EmbedIFrame.Markup()
                </div>
            }
            <VideoMediaFile Entity="_video"></VideoMediaFile>
            <div class="mt-3">
                <VideoHeader Category="@Category" Tag="@Tag" Entity="@_video" OnUserHasRated="() => this.StateHasChanged()"></VideoHeader>
                <div class="video-content mt-3 p-4 border shadow-lg">
                    @if (_video!.Content.Has() == true)
                    {
                        @((MarkupString)_video!.Content)
                    }
                    else
                    {
                        <p class="fs-2 w-100 text-center">
                            <i class="fa-solid fa-quote-left"></i>
                            @Text.Lower("No text from this video")
                            <i class="fa-solid fa-quote-right"></i>
                        </p>
                    }
                </div>
                <div class="post-what-to-see-next mt-3 p-4 border shadow-lg">
                    <label class="w-100 text-center fs-3">
                        <i class="fa-solid fa-rectangle-list"></i>
                        @Text.Lower("What to see next")
                        <i class="fa-solid fa-rectangle-list"></i>
                    </label>
                    <WhatToSeeNext Class="mt-5" Entity="whatToSeeNextTitle"></WhatToSeeNext>
                </div>
                <div class="video-ratings-frame mt-3 p-4 border shadow-lg">
                    <VideoRatings Entity="this._video"></VideoRatings>
                </div>
                <div class="video-comments-frame mt-3 p-4 border shadow-lg">
                    <label class="w-100 text-center fs-3">
                        <i class="fa-solid fa-comment"></i>
                        @Text.Lower("Comment section")
                        <i class="fa-solid fa-comment"></i>
                    </label>
                    @if (this._video.IsCommentEnabled == true)
                    {
                        <div class="row mt-5">
                            <div class="col-12 col-xl-6">
                                <label class="w-100 text-center fs-4">
                                    @Text.Lower("Place your comment here")
                                    @if (UserFacade.SocialProfile.New)
                                    {
                                        <span>, @Text.Lower("But login first")</span>
                                    }
                                </label>
                                <div class="mt-3 position-sticky" style="top: 1rem;">
                                    <Login></Login>
                                    <AuthorizeView>
                                        <Authorized>
                                            @if (NewComment.ParentId != null)
                                            {
                                                var parent = this.Super.ContentComments.ReadFromCache().Id(NewComment.ParentId.Value);
                                                @if (parent != null)
                                                {
                                                    var socialProfile = this.Super.SocialProfiles.ReadFromCache().Id(parent.SocialProfileId);
                                                    <div class="video-comment-in-reply-to p-2 mt-2 mb-2 position-relative">
                                                        <SocialProfileHeaderLite Entity="socialProfile"></SocialProfileHeaderLite>
                                                        <div class="video-comment-text">@((MarkupString)parent.Content)</div>
                                                        <button class="position-absolute fw-bold p-2" style="top: 0; right: 0; bottom: 0;" @onclick="() => NewComment.ParentId = null">x</button>
                                                    </div>
                                                }
                                            }
                                            <div class="new-comment mt-3">
                                                <TinyMCEComment Entity="this.NewComment"></TinyMCEComment>
                                                <div class="new-comment-actions mt-2 text-right">
                                                    <button class="btn btn-light border" disabled="@this._disableSendCommentButton()" @onclick="() => this.CreateComment()">
                                                        <i class="fa-solid fa-paper-plane pe-1"></i>
                                                        @Text.Lower("Add comment")
                                                    </button>
                                                </div>
                                            </div>
                                        </Authorized>
                                    </AuthorizeView>
                                </div>
                            </div>
                            <div class="col-12 col-xl-6">
                                @if (_comments.Count == 0)
                                {
                                    <label class="w-100 text-center mb-3 fs-4">
                                        <i class="fa-solid fa-face-smile-wink"></i>
                                        @Text.Lower("Be the first to comment")
                                    </label>
                                }
                                else
                                {
                                    <label class="w-100 text-center mb-3 fs-4">@Text.Lower("{0} comment(s)", _comments.Count)</label>
                                    <PostComments Comments="this._comments" PageSize="@this._pageSize" CurrentPage="@_currentPage" OnCommentUpdated="this.OnCommentUpdated" OnCommentDeleted="this.OnCommentDeleted" OnCurrentPageChanged="(page) => this._currentPage = page" OnCommentReply="(comment) => this.NewComment.ParentId = comment.Id"></PostComments>
                                }
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="row mt-5">
                            <NothingToSeeHere Class="shadow-none"></NothingToSeeHere>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
    else
    {
        <NothingToSeeHere></NothingToSeeHere>
    }
</Root>

    @code {
    [Parameter] public OrigamiTag? Tag { get; set; }
    [Parameter] public OrigamiCategory? Category { get; set; }
    [Parameter] public OrigamiVideo? Video { get; set; }
    [Parameter] public string NanoId { get; set; } = string.Empty;
    [Parameter] public bool OpenGraphMetaTags { get; set; } = true;

    /// <summary>
    /// For New Comments
    /// </summary>
    private OrigamiContentComment NewComment = new();

    /// <summary>
    /// Current Video
    /// </summary>
    private OrigamiVideo _video = new();

    /// <summary>
    /// Comments for the Video
    /// </summary>
    public List<OrigamiContentComment> _comments = new();

    private int _currentPage = 1;
    private int _pageSize = 10;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        this.NewComment.Changed += (sender, e) => this.InvokeAsync(this.StateHasChanged);
    }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        this._video = this.Video ?? this.Super.Contents.ReadFromCache().OfType<OrigamiVideo>().NanoId(NanoId) ?? new();
        this._comments = this.Super.ContentComments.AllComments(_video);
        this.BlogId = this._video.BlogId.GetValueOrDefault();
    }

    private void CreateComment()
    {
        this.NewComment.IsApproved = true;
        this.NewComment.Id = Guid.NewGuid();
        this.NewComment.ContentId = this._video.Id;
        this.NewComment.DateCreated = DateTime.UtcNow;
        this.NewComment.SocialProfileId = UserFacade.SocialProfile.Id;

        var context = new DataOperationContextFrontEnd<OrigamiContentComment>(UserFacade.SocialProfile, DateTime.UtcNow, this.NewComment);
        var hub = this.Super.ContentComments.SmartCreate(context);

        hub.OnSuccess(() => this._comments = this.Super.ContentComments.AllComments(_video));

        this.NewComment = new();
        this.NewComment.Changed += (sender, e) => this.InvokeAsync(this.StateHasChanged);

        UserFacade.Result = hub;
    }

    private bool _disableSendCommentButton()
    {
        return this.NewComment.Content.Has() == false;
    }

    private void OnCommentUpdated(OrigamiContentComment comment)
    {
        this._comments = this.Super.ContentComments.AllComments(_video);
    }

    private void OnCommentDeleted(OrigamiContentComment comment)
    {
        this._comments = this.Super.ContentComments.AllComments(_video);
    }

    protected override async Task PageViewAsync(bool firstRender)
    {
        if (firstRender)
        {
            if (this.UserFacade.IncognitoMode == false)
            {
                var uri = new Uri(NavigationManager.Uri);
                await JSRuntime.InvokeVoidAsync("origami.physicalpages.viewByContent", uri.AbsolutePath, nameof(OrigamiVideo), this._video.Id);
            }
        }
    }

    protected override void SetPageTitle()
    {
        this.PageTitle.SetTitle(Tag, Category, _video);
    }
}