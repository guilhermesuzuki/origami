@inherits Basic

@if (_blogs.Count > 0)
{
    var row = 4;
    var chunks = _blogs.Chunk(row);
    var settings = this.Super.Settings.GetSettings();
    <div class="main-menu @Class position-relative text-center" style="">
        @* @if (this.Super.GetSoftwareReleases().Any() == true)
        {
            <div class="p-3 d-inline-flex bg-success">
                <a href="/software-releases" class="cursor-pointer focusable text-white">
                    <i class="fa-solid fa-file-zipper"></i>
                    @Text.Upper("Download")
                    <i class="fa-solid fa-download"></i>
                </a>
            </div>
        }
        @if (settings.RepositoryURL.Has() == true)
        {
            <div class="p-3 d-inline-flex bg-warning">
                <a href="@settings.RepositoryURL" class="cursor-pointer focusable text-white">
                    <i class="fa-solid fa-code"></i>
                    @Text.Upper("Go to repository")
                    <i class="fa-solid fa-up-right-from-square"></i>
                </a>
            </div>
        } *@
        @foreach (var chunk in chunks)
        {
            <ul class="inline-list content-max-length">
                @foreach (var blog in chunk)
                {
                    <li>
                        <div class="cursor-pointer focusable d-inline-flex align-items-center @(blog.Id == this.UserFacade.BlogId ? "fw-bolder" : "fw-light")"
                             @onclick="() => this.GoToBlog(blog)">
                            <BlogHeaderInline Class="p-3 text-uppercase" Entity="blog"></BlogHeaderInline>
                        </div>
                        <MudDialog @bind-Visible="blog.IsSelected" Options="_dialogOptions">
                            <TitleContent>
                                <div class="text-center">
                                    <BlogHeaderInline Entity="blog" Class="fs-3"></BlogHeaderInline>
                                    <div class="dummy"></div>
                                    <div class="btn-group w-100 mt-3 m-auto" style="width: 650px !important;">
                                        <button class="btn btn-outline-dark fw-bold cursor-pointer w-100" @onclick="() => this.OpenBlog(blog)">
                                            <i class="bi bi-box-arrow-up-right"></i>
                                            @Text.Lower("Go to blog")
                                        </button>
                                        <button class="btn btn-outline-dark fw-bold cursor-pointer w-100" @onclick="() => this.GoToRss(blog)">
                                            <i class="bi bi-rss-fill"></i>
                                            @Text.Lower("RSS feed")
                                        </button>
                                        <button class="btn btn-outline-dark fw-bold cursor-pointer w-100" @onclick="() => blog.IsSelected = false">
                                            <i class="bi bi-x-square-fill"></i>
                                            @Text.Lower("Close menu")
                                        </button>
                                    </div>
                                    <hr />
                                </div>
                            </TitleContent>
                            <DialogContent>
                                <BlogMenu BlogId="@blog.Id" OnClose="() => blog.IsSelected = false"></BlogMenu>
                            </DialogContent>
                        </MudDialog>
                    </li>
                }
            </ul>
        }
    </div>
}
@code {
    private List<OrigamiBlog> _blogs = new();

    private readonly DialogOptions _dialogOptions = new() { CloseOnEscapeKey = true, CloseButton = false, CloseOnNavigation = true, FullScreen = true };

    protected override void OnInitialized()
    {
        base.OnInitialized();
        this.LoadBlogs();

        // Subscribe to changes in the UserFacade to update the blog selection
        this.UserFacade.Changed += (sender, args) =>
        {
            if (args.PropertyName == nameof(IUserFacade.BlogId))
            {
                this.InvokeAsync(StateHasChanged);
            }
        };
    }

    private void LoadBlogs()
    {
        _blogs = this.Super.Blogs.ReadFromCache().GetFrontEnd();
    }

    /// <summary>
    /// Goes to blog
    /// </summary>
    /// <param name="blog"></param>
    private void GoToBlog(OrigamiBlog blog)
    {
        foreach (var b in _blogs)
        {
            if (b == blog)
            {
                b.IsSelected = !b.IsSelected;
                continue;
            }
            b.IsSelected = false;
        }
    }

    private void _mustCloseItself()
    {
        var blog = _blogs.FirstOrDefault(x => x.IsSelected);
        blog?.IsSelected = false;
    }

    private void OpenBlog(OrigamiBlog blog)
    {
        this.GhostOfTheNavigator.NavigateTo($"{blog.Hyperlink}#content-start");
    }

    private void GoToRss(OrigamiBlog blog)
    {
        this.GhostOfTheNavigator.NavigateTo($"{blog.Hyperlink}rss.xml", true);
    }
}
