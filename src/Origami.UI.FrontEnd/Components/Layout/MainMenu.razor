@inherits Basic
@inject IBlogRepository _blogRepository

@if (_blogs.Count > 0)
{
    var row = 4;
    var chunks = _blogs.Chunk(row);
    <div class="main-menu @Class position-relative text-center" style="">
        @foreach (var chunk in chunks)
        {
            <ul class="inline-list content-max-length">
                @foreach (var blog in chunk)
                {
                    <li>
                        <div class="cursor-pointer focusable d-inline-flex align-items-center @(blog.Id == this.UserFacade.BlogId ? "fw-bolder" : "fw-light")"
                             @onclick="() => this.GoToBlog(blog)">
                            <BlogHeaderInline Class="p-3 text-uppercase" Entity="blog"></BlogHeaderInline>
                        </div>
                        <MudDialog @bind-Visible="blog.IsSelected" Options="_dialogOptions">
                            <DialogContent>
                                <BlogMenu BlogId="@blog.Id" OnClose="() => blog.IsSelected = false"></BlogMenu>
                            </DialogContent>
                        </MudDialog>
                    </li>
                }
            </ul>
        }
    </div>
}
@code {
    private List<OrigamiBlog> _blogs = new();

    private readonly DialogOptions _dialogOptions = new() { CloseOnEscapeKey = true, NoHeader = true, FullScreen = true };

    protected override void OnInitialized()
    {
        base.OnInitialized();
        this.LoadBlogs();

        // Subscribe to changes in the UserFacade to update the blog selection
        this.UserFacade.Changed += (sender, args) =>
        {
            if (args.PropertyName == nameof(IUserFacade.BlogId))
            {
                this.InvokeAsync(StateHasChanged);
            }
        };
    }

    private void LoadBlogs()
    {
        _blogs = this._blogRepository.ReadFromCache().GetFrontEnd();
    }

    /// <summary>
    /// Goes to blog
    /// </summary>
    /// <param name="blog"></param>
    private void GoToBlog(OrigamiBlog blog)
    {
        foreach (var b in _blogs)
        {
            if (b == blog)
            {
                b.IsSelected = !b.IsSelected;
                continue;
            }
            b.IsSelected = false;
        }
    }

    private void _mustCloseItself()
    {
        var blog = _blogs.FirstOrDefault(x => x.IsSelected);
        blog?.IsSelected = false;
    }
}
