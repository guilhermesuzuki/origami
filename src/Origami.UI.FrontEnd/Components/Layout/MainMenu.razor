@inherits Basic
@inject IBlogRepository _blogRepository

@if (_blogs.Count > 0)
{
    var row = 4;
    var chunks = _blogs.Chunk(row);
    <div class="main-menu @Class position-relative text-center" style="">
        <ul class="inline-list content-max-length">
            @foreach (var blog in chunks.First())
            {
                <li>
                    <div class="cursor-pointer focusable d-inline-flex align-items-center @(blog.Id == this.UserFacade.BlogId ? "fw-bolder" : "fw-light")"
                         @onclick="() => this.GoToBlog(blog)">
                        <BlogHeaderLite Class="p-3 text-uppercase" Entity="blog" ShowSlug="false"></BlogHeaderLite>
                    </div>
                    @if (blog.IsSelected)
                    {
                        <div class="position-fixed zeroes bg-white bg-opacity-50" style="z-index: 25;" @onclick="() => blog.IsSelected = false"></div>
                        <div class="position-absolute p-3" style="z-index: 50; left:0; right:0;" @onclick="() => blog.IsSelected = false">
                            <div class="shadow-lg border border-dark bg-white p-3 w-100 h-100" style="">
                                <BlogMenu BlogId="@blog.Id"></BlogMenu>
                            </div>
                        </div>
                    }
                </li>
            }
        </ul>
        @for (int i = 1; i < chunks.Count(); i++)
        {
            <div class="row content-max-length m-auto">
                @foreach (var blog in chunks.ElementAt(i))
                {
                    <div class="col-12 col-xxl-3">
                        <div class="cursor-pointer focusable d-inline-flex align-items-center @(blog.Id == this.UserFacade.BlogId ? "fw-bolder" : "fw-light")"
                             @onclick="() => this.GoToBlog(blog)">
                            <BlogHeaderLite Class="p-3 text-uppercase" Entity="blog" ShowSlug="false"></BlogHeaderLite>
                        </div>
                        @if (blog.IsSelected)
                        {
                            <div class="position-fixed zeroes bg-white bg-opacity-50" style="z-index: 25;" @onclick="() => blog.IsSelected = false"></div>
                            <div class="position-absolute p-3" style="z-index: 50; left:0; right:0;" @onclick="() => blog.IsSelected = false">
                                <div class="shadow-lg border border-dark bg-white p-3 w-100 h-100" style="">
                                    <BlogMenu BlogId="@blog.Id"></BlogMenu>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </div>
}
@code {
    private List<OrigamiBlog> _blogs = new();

    protected override void OnInitialized()
    {
        base.OnInitialized();
        this.LoadBlogs();

        // Subscribe to changes in the UserFacade to update the blog selection
        this.UserFacade.Changed += (sender, args) =>
        {
            if (args.PropertyName == nameof(IUserFacade.BlogId))
            {
                this.InvokeAsync(StateHasChanged);
            }
        };
    }

    private void LoadBlogs()
    {
        _blogs = this._blogRepository.ReadFromCache().GetFrontEnd();
    }   

    /// <summary>
    /// Goes to blog
    /// </summary>
    /// <param name="blog"></param>
    private void GoToBlog(OrigamiBlog blog)
    {
        if (blog.IsSelected == true)
        {
            _blogs.Each(x => x.IsSelected = false);
        }
        else
        {
            _blogs.Each(x => x.IsSelected = false);
            blog.IsSelected = true;
        }
    }
}
