@inherits BasicLayout

<CustomHeadContent>
    <AppLinks></AppLinks>
</CustomHeadContent>
<PageTitle>@Super.Settings.GetSettings().Name.ToLower()</PageTitle>
<ProcessResult></ProcessResult>
<main class="overflow-x-hidden">
    <Root Class="master-root">
        <a id="top"></a>
        <IncognitoMode></IncognitoMode>
        @foreach (var message in this.Super.SpecialMessages.GetVisibleMessages())
        {
            <SpecialMessageHeader Entity="message" Class="border-bottom border-light-subtle"></SpecialMessageHeader>
        }
        <div class="shadow-sm border-bottom d-inline-flex align-items-center w-100 position-relative" style="min-height:450px;background-color:#333;">
            <Slides></Slides>
            <Logo BlogId="this.UserFacade.BlogId"></Logo>
            <div class="position-absolute w-100 text-white text-center p-3" style="bottom:0;left:0;right:0;">
                <div class="d-inline-flex align-items-center">
                    <SubscribeHere></SubscribeHere>
                </div>
            </div>
        </div>
        <MainMenu Class="border-bottom"></MainMenu>
        <AuthorizeView>
            <Authorized>
                @if (this.UserFacade.SocialProfile.New == false)
                {
                    <div class="w-100 p-3 pb-0 text-center">
                        <SocialProfileHeaderInline Class="shadow-sm border-light border border-2" Entity="this.UserFacade.SocialProfile" Actions="true"></SocialProfileHeaderInline>
                    </div>
                }
            </Authorized>
        </AuthorizeView>
        <div class="content-max-length p-3">
            <Search></Search>
            <a id="content-start"></a>
            <article class="content w-100">@Body</article>
        </div>
        <div class="position-sticky w-100 z-index-middle d-inline-flex align-items-center" style="right:0;bottom:0;justify-content:flex-end;">
            <GoTop></GoTop>
        </div>
        <Footer Class="text-lowercase"></Footer>
    </Root>
    @if (UserFacade.ShowCookieConsent == true)
    {
        <div class="cookie-consent-wrapper bg-light border position-sticky z-index-middle" style="bottom: 0;">
            <CookieConsentForm Class="p-3 m-auto content-max-length"></CookieConsentForm>
        </div>
    }
</main>

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />
<BlazorErrorUi></BlazorErrorUi>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
        await this.VerifyUserAsync(firstRender);
    }

    /// <summary>
    /// And clears the authentication cookie (in case a user could not be retrieved)
    /// </summary>
    /// <param name="firstRender"></param>
    /// <returns></returns>
    protected async Task VerifyUserAsync(bool firstRender)
    {
        var state = await this.AuthenticationStateProvider.GetAuthenticationStateAsync();

        if (state == null) return;
        if (state.User.Identity == null) return;
        if (state.User.Identity.IsAuthenticated == false) return;

        //it failed to authenticate the user, must log them out
        if (UserFacade.SocialProfile.New)
        {
            var returnUrl = Uri.EscapeDataString(this.NavigationManager.Uri);
            this.NavigationManager.NavigateTo("/login/out".QueryString("returnUrl", returnUrl), true);
        }
    }
}
