@inherits Basic
@implements IBlogId
@inject IPageRepository _pageRepository

@if (this.BlogId != Guid.Empty)
{
    var frontPage = this.Super.Contents.ReadFromCache().OfType<OrigamiPage>().NonDeleted().Published().FrontPage(this.BlogId);
    @if (frontPage != null)
    {
        <div class="front-page @Class">
            <PagesDetails Page="frontPage"></PagesDetails>
        </div>
    }
}
    
