@using System.Reflection
@inherits Basic

@if (this.Super != null) 
{
    var cookie = this.CookiePolicy();
    var privacy = this.PrivacyPolicy();
    var conditions = this.TermsAndConditions();
    var services = this.TermsOfService();
    IEnumerable<OrigamiSpecialPage> pages = [ cookie, privacy, conditions, services, ];
    <style>
        html body .border-bottom-highlight { border-bottom: 2px solid var(--site-highlight)!important; }
    </style>
    <div class="footer p-4 bg-light border float-right d-inline-flex align-items-center w-100 @Class" style="justify-content: flex-end;">
        @foreach (var p in pages)
        {
            @if (p.New == false)
            {
                <a href="@p.Hyperlink" class="me-1 border-light-subtle border-bottom-highlight">
                    <SpecialPageHeaderLite4 Entity="@p"></SpecialPageHeaderLite4>
                </a>
            }
        }
        <span class="origami ms-5 text-right">
            <span class="fw-bold origami-name">@Text.Original("Origami")</span>
            <span class="fw-bold origami-version">@GetCurrentVersion()</span>
        </span>
    </div>
}

@code {
    protected string GetCurrentVersion()
    {
        return Assembly.GetEntryAssembly()?.GetCustomAttribute<AssemblyInformationalVersionAttribute>()?.InformationalVersion
            ?? "WTH, Unknown?";
    }
    protected OrigamiSpecialPage CookiePolicy()
    {
        return this.Super.GetSpecialPages().GetBySubType(OrigamiSpecialPageTypes.CookiePolicy).FirstOrDefault() ?? new();
    }
    protected OrigamiSpecialPage PrivacyPolicy()
    {
        return this.Super.GetSpecialPages().GetBySubType(OrigamiSpecialPageTypes.PrivacyPolicy).FirstOrDefault() ?? new();
    }
    protected OrigamiSpecialPage TermsAndConditions()
    {
        return this.Super.GetSpecialPages().GetBySubType(OrigamiSpecialPageTypes.TermsAndConditions).FirstOrDefault() ?? new();
    }
    protected OrigamiSpecialPage TermsOfService()
    {
        return this.Super.GetSpecialPages().GetBySubType(OrigamiSpecialPageTypes.TermsOfService).FirstOrDefault() ?? new();
    }
}
